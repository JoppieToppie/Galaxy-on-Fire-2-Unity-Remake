      type: {class: 'Constant`1[[System.String, mscorlib]]', ns: Unity.GraphToolkit.Editor, asm: UnityEditor.GraphToolkitModule}
      data:
        m_Value: 'Waves: more pirates every wave; the next wave comes 5 s after the last one is destroyed.

          Run it with /event waves (admins) or "event waves" on the dedicated server''s console.

          Copy it into an Events folder (see /event list) under another name to make your own.'
