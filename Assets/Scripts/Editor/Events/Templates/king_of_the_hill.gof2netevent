    - rid: 7146566188456215199
      type: {class: 'Constant`1[[System.String, mscorlib]]', ns: Unity.GraphToolkit.Editor, asm: UnityEditor.GraphToolkitModule}
      data:
        m_Value: 'King of the Hill: every few seconds each player alive in the hill''s orbit scores a point;

          pirates join in every 30 s. The most points when the time runs out wins.

          Settings: hill (a station), minutes, interval (seconds per point).'
