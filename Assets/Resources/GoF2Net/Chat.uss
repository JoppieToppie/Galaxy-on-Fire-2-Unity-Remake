/* Remake: the lines (full width, no gaps), the tab and the input row are solid: the chat is drawn over the flight HUD's
   key hints on the left and covers them while it shows (at even 95 % the bright hint text showed through). */

.chat {
    position: absolute;
    left: 24px;
    top: 36%;
    width: 560px;
}

/* the small Chat button: tapped on a phone, B (the chat key) still opens it too */
.chat-tab {
    align-self: flex-start;
    min-height: 36px;
    min-width: 88px;
    padding: 4px 14px;
    margin: 0 0 6px 0;
    font-size: 15px;
    letter-spacing: 1px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: rgb(216, 236, 247);
    background-color: rgba(4, 8, 14, 0.85);
    border-width: 1px;
    border-color: rgba(143, 216, 255, 0.5);
    border-radius: 3px;
}

.chat-tab:hover {
    background-color: rgba(24, 44, 60, 0.9);
    border-color: rgb(143, 216, 255);
}

.chat-tab:active {
    background-color: rgba(143, 216, 255, 0.3);
}

.chat--open .chat-tab {
    border-color: rgb(143, 216, 255);
}

.chat-line {
    align-self: stretch;   /* the full width, no gaps: one block that covers the key hints under it */
    margin-bottom: 0;
    padding: 3px 8px;
    font-size: 17px;
    color: rgb(230, 240, 246);
    white-space: normal;
    background-color: rgb(4, 8, 14);
    border-radius: 2px;
}

.chat-line--own {
    color: rgb(255, 255, 255);
}

.chat-line--notice {
    color: rgba(216, 236, 247, 0.65);
    -unity-font-style: italic;
}

.chat-input-row {
    display: none;
    flex-direction: row;
    margin-top: 6px;
}

.chat--open .chat-input-row {
    display: flex;
}

.chat-channel {
    min-width: 96px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    margin: 0;
    padding: 4px 10px;
    font-size: 14px;
    color: rgb(143, 216, 255);
    background-color: rgb(4, 8, 14);
    border-width: 1px;
    border-color: rgba(143, 216, 255, 0.5);
    border-radius: 2px;
}

.chat-channel--global {
    color: rgb(240, 179, 90);
    border-color: rgba(240, 179, 90, 0.5);
}

.chat-field {
    flex-grow: 1;
    margin: 0 0 0 6px;
}

.chat-field .unity-base-text-field__input {
    padding: 5px 10px;
    font-size: 17px;
    color: rgb(255, 255, 255);
    background-color: rgb(4, 8, 14);
    border-width: 1px;
    border-color: rgba(216, 236, 247, 0.3);
    border-radius: 2px;
}

/* Typing "/": the matching commands over the input line (ChatView.RefreshSuggestions), Tab's pick highlighted. */
.chat-suggest {
    margin-top: 6px;
    background-color: rgb(4, 8, 14);
    border-width: 1px;
    border-color: rgba(216, 236, 247, 0.3);
    border-radius: 2px;
}

.chat-suggest-row {
    padding: 4px 10px;
    font-size: 16px;
    color: rgb(230, 240, 246);
    white-space: normal;
}

.chat-suggest-row--picked {
    background-color: rgba(240, 179, 90, 0.25);
    border-left-width: 2px;
    border-left-color: rgb(240, 179, 90);
}

.chat-suggest-hint {
    padding: 3px 10px 4px 10px;
    font-size: 13px;
    color: rgba(216, 236, 247, 0.5);
}

/* The /netstats overlay (NetStats), top left between the HUD's bars and the chat. */
.netstats {
    position: absolute;
    left: 24px;
    top: 21%;
    padding: 6px 10px;
    font-size: 15px;
    color: rgb(216, 236, 247);
    background-color: rgba(4, 8, 14, 0.85);
    border-left-width: 2px;
    border-left-color: rgb(240, 179, 90);
    white-space: nowrap;
}

.netstats--station {
    left: auto;
    right: 24px;
    top: 9%;
}
