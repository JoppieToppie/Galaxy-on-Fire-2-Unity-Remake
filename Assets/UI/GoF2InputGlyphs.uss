/* Input hints shared by the HUDs (InputGlyph): a hint row (glyphs + label), keyboard keycaps and controller buttons in
   the Xbox or the PlayStation style (PadGlyph, InputMode.Style: the controller last used or the option). */

/* The button hints option (Settings.InputHints). Specific enough to beat the HUDs' own ".input-keyboard .hints" /
   ".input-gamepad .station-hints" rules, which showed the hints again (the option did nothing in flight). */
.hints--off,
.input-keyboard .hints--off,
.input-gamepad .hints--off,
.input-touch .hints--off,
.input-keyboard .hints.hints--off,
.input-gamepad .hints.hints--off {
    display: none;
}

/* Modified: every hint's keys in a row of their own (hint-keys) with the label under them on one line, both centred, as in
   the hangar window; the box has a grey border. The label's own line spacing (capitals, nothing below the line) leaves
   more room under it than above the keys, so the bottom padding is that much smaller. */
.hint {
    flex-direction: column;
    align-items: center;
    justify-content: center;
    margin-top: var(--space-s);
    padding: 8px 12px 3px 12px;
    background-color: rgba(4, 10, 18, 0.5);
    border-width: 2px;
    border-color: rgba(150, 158, 166, 0.7);
    border-radius: 4px;
}

/* Modified: an "i" window's controls (OptionInfo: the star map, Inspect ship, Action Freeze, the shop): one a line, its
   keys then its label, no boxes. Here, not in GoF2Common.uss: the theme's rules lose to this sheet's own .hint. */
.hints-popup {
    flex-direction: column;
}

.hints-popup .hint {
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    margin: 3px 0;
    padding: 2px 4px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
}

.hints-popup .hint-keys {
    min-width: 150px;
    justify-content: flex-end;
    margin-right: var(--space-l);
}

.hints-popup .hint-label {
    margin: 0;
    padding: 0;
    font-size: var(--text-small);
    white-space: nowrap;
    -unity-text-align: middle-left;
}

.hint-keys {
    flex-direction: row;
    align-items: center;
}

.hint-label {
    font-size: var(--text-small);
    letter-spacing: 2px;
    color: var(--gof-text-dim);
    margin: 3px 0 0 0;
    padding: 0;
    white-space: nowrap;
    -unity-text-align: middle-center;
}

.keycap {
    min-width: var(--glyph-key);
    height: var(--glyph-key);
    padding: 0 8px;
    margin: 0 2px;
    font-size: var(--text-caption);
    color: var(--gof-text);
    -unity-text-align: middle-center;
    border-width: 2px;
    border-bottom-width: 4px;
    border-color: rgba(216, 236, 247, 0.45);
    border-radius: 6px;
    background-color: rgba(255, 255, 255, 0.06);
}

.keycap--wide {
    min-width: 110px;
}

.pad-face {
    width: var(--glyph-face);
    height: var(--glyph-face);
    margin: 0 2px;
    border-radius: var(--glyph-face-r);
    font-size: var(--text-small);
    color: #0B1016;
    -unity-text-align: middle-center;
}

.pad-face--a {
    background-color: #6BC24A;
}

.pad-face--y {
    background-color: #F2C230;
}

.pad-face--b {
    background-color: #E5484D;
}

.pad-face--x {
    background-color: #3F8FE8;
}

/* PlayStation's face buttons: dark like the pad's own, the symbol drawn by PadGlyph in its colour (cross blue, circle red,
   square pink, triangle green). */
.pad-face--ps {
    background-color: rgb(16, 21, 28);
    border-width: 2px;
    border-color: rgba(216, 236, 247, 0.55);
}

/* Switch's face buttons (#162): dark and round like the Pro Controller's, Nintendo's letter in light grey. */
.pad-face--switch {
    background-color: rgb(16, 21, 28);
    border-width: 2px;
    border-color: rgba(216, 236, 247, 0.55);
    color: #E3ECF3;
}

.pad-stick {
    width: var(--glyph-stick);
    height: var(--glyph-stick);
    margin: 0 2px;
    border-radius: var(--glyph-stick-r);
    border-width: 3px;
    border-color: rgba(216, 236, 247, 0.6);
    font-size: var(--text-caption);
    color: var(--gof-text);
    -unity-text-align: middle-center;
}

.pad-trigger {
    min-width: 42px;
    height: var(--glyph-trigger);
    padding: 0 8px;
    margin: 0 2px;
    border-radius: 6px;
    border-top-left-radius: 14px;
    border-top-right-radius: 14px;
    background-color: rgba(216, 236, 247, 0.85);
    font-size: var(--text-caption);
    color: #0B1016;
    -unity-text-align: middle-center;
}

.pad-bumper {
    min-width: 44px;
    height: var(--glyph-bumper);
    padding: 0 8px;
    margin: 0 2px;
    border-radius: var(--glyph-bumper-r);
    background-color: rgba(216, 236, 247, 0.85);
    font-size: var(--text-caption);
    color: #0B1016;
    -unity-text-align: middle-center;
}

.pad-menu {
    height: var(--glyph-menu);
    padding: 0 8px;
    margin: 0 2px;
    border-radius: var(--glyph-menu-r);
    background-color: rgba(216, 236, 247, 0.85);
    font-size: var(--text-caption);
    letter-spacing: 1px;
    color: #0B1016;
    -unity-text-align: middle-center;
}

/* A button with glyphs before its text (InputGlyph.WithGlyphs): glyphs and label in a centred row. */
.glyph-button {
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.glyph-button-label {
    margin: 0;
    padding: 0;
    -unity-text-align: middle-center;
}

.glyph-button-glyph {
    margin: 0 12px 0 0;
}

/* Rework: a menu's always-visible button prompts (MenuKeys.Bar; docs/UI-DESIGN.md "Button prompts"): one line, each
   prompt its keys then its label, no boxes, right-aligned; keyboard and controller only (hidden on touch in code). */
.prompt-bar {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    justify-content: flex-end;
}

.prompt-bar .hint {
    flex-direction: row;
    align-items: center;
    margin: 4px 0 4px 24px;
    padding: 0;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
}

.prompt-bar .hint-label {
    margin: 0 0 0 8px;
    font-size: var(--text-small);
    -unity-text-align: middle-left;
}

/* Modified: the flight pause menu's prompts (PauseMenu): each prompt's keys with its label under them, the row centred. */
.prompt-bar--stacked {
    justify-content: center;
}

.prompt-bar--stacked .hint {
    flex-direction: column;
    align-items: center;
    margin: 4px 14px;
}

.prompt-bar--stacked .hint-label {
    margin: 3px 0 0 0;
    -unity-text-align: middle-center;
}

/* In a window's footer, beside its buttons: it gives way first when the footer is short of room. */
.prompt-bar--footer {
    flex-shrink: 1;
    min-width: 0;
}

/* Under a station window (Missions, Status): the strip between the window's bottom and the screen's, as the hangar's
   hint row. */
.prompt-bar--below {
    position: absolute;
    left: 0;
    right: 0;
    top: 100%;
    min-height: 96px;
    justify-content: center;
    align-content: center;   /* a second line at a large text size */
}

/* A row of its own under a panel's footer (the in-game Options pages). */
.prompt-bar--row {
    flex-shrink: 0;
    margin-top: var(--space-s);
    padding-top: var(--space-s);
    border-top-width: 1px;
    border-top-color: var(--gof-line);
}

/* Rework: a button's own controller glyph (InputGlyph.PadPrompt), only while a controller is the input; A only on the
   focused / selected button, its space kept on the others so the label stays put. */
.pad-only {
    display: none;
}

.input-gamepad .pad-only {
    display: flex;
}

.input-gamepad .pad-focus-only {
    visibility: hidden;
}

.input-gamepad :focus > .pad-focus-only,
.input-gamepad .autopilot-menu-item--selected > .pad-focus-only,
.input-gamepad .options-selected > .pad-focus-only {
    visibility: visible;
}

.glyph-button > .pad-only {
    margin: 0 8px 0 0;
}
