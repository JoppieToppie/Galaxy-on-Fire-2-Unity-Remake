/* Star map overlay (StarMap) over its own 3D camera: labels, rings and icons follow the suns / planets (StarMap::draw,
   drawOnScreenInfo), header "Map", the system block in the system view, the energy line, the key legend, the footer with
   back and key buttons, and the ChoiceWindow. HD pixels = panel units (1920x1080 reference).
   The root gets input-touch / input-keyboard / input-gamepad (InputMode) and map-dialog-only for the jumpgate prompt. */

.map-root {
    flex-grow: 1;
}

.map-view {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.map-dialog-only .map-view {
    display: none;
}

.map-fill {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.map-safe {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

/* ---- per-system / per-planet labels -------------------------------------------------------- */

.map-item {
    position: absolute;
    width: 0;
    height: 0;
    overflow: visible;
}

.map-ring {
    position: absolute;
    left: -49.5px;
    top: -49.5px;
    width: 99px;
    height: 99px;
}

.map-ring--selected {
    left: -71.5px;
    top: -71.5px;
    width: 143px;
    height: 143px;
}

.map-pulse {
    position: absolute;
    left: -49.5px;
    top: -49.5px;
    width: 99px;
    height: 99px;
}

.map-name-row {
    position: absolute;
    left: -300px;
    width: 600px;
    top: 68.5px;
    flex-direction: row;
    justify-content: center;
}

.map-name-wrap {
    position: relative;
}

.map-name {
    font-size: var(--text-label);
    color: #FFFFFF;
    padding: 0;
    margin: 0;
    text-shadow: 0 1px 4px rgba(0, 0, 0, 0.9);
}

.map-name--selected {
    color: rgb(255, 128, 0);
}

.map-race-icon {
    position: absolute;
    right: 100%;
    top: -3px;
    width: 36px;
    height: 36px;
}

/* 0x545 at (nameLeft, ty + 3): the owned Kaamo Club's house in Shima. */
.map-race-icon--home {
    top: 3px;
    width: 18px;
    height: 18px;
}

.map-line {
    position: absolute;
    left: -300px;
    width: 600px;
    -unity-text-align: upper-center;
    font-size: var(--text-body);
    color: #FFFFFF;
    padding: 0;
    margin: 0;
    text-shadow: 0 1px 4px rgba(0, 0, 0, 0.9);
}

.map-icon {
    position: absolute;
}

/* ---- header ------------------------------------------------------------------------------ */

.map-header {
    flex-direction: row;
    align-items: center;
    padding: 32px 40px 0 48px;
}

/* Modified: an invisible copy of the station's Menu button (StationMenu.uss .station-menu-button: padding, border, text
   size and font) so the header is exactly as tall as the station's top bar and the title sits at the station name's
   height whatever the UI font (a fixed min-height broke when the font changed). Shown only where the station shows its
   Menu button (touch, keys and mouse). */
.map-header-spacer {
    display: none;
    width: 0;
    flex-shrink: 0;
    margin: 0;
    padding: 12px 0;
    border-top-width: var(--button-border);
    border-bottom-width: var(--button-border);
    border-color: rgba(0, 0, 0, 0);
    font-size: var(--text-body);
    letter-spacing: 3px;
    white-space: nowrap;
    overflow: hidden;
    visibility: hidden;
}

.input-touch .map-header-spacer,
.input-keyboard .map-header-spacer {
    display: flex;
}

/* Modified: on a phone as tall as the station's Menu button there (GoF2Common.uss ".layout-phone .station-menu-button":
   touch targets of at least 64 units); without it the map's title sat higher than the station's name. With a controller
   both stay hidden (the station shows no Menu button then), so the two bars match there too. */
.layout-phone .map-header-spacer {
    min-height: 64px;
}

.map-title {
    font-size: var(--text-title);
    letter-spacing: 6px;
    color: #FFFFFF;
    text-shadow: 0 2px 6px rgba(0, 0, 0, 0.8);
}

/* Modified: "| MAP" after the station's name (StarMap.SetStationTitle), as the station's view title (StationMenu.uss). */
.map-view-title {
    margin-left: var(--space-xl);
    padding-left: var(--space-xl);
    border-left-width: 2px;
    border-left-color: var(--gof-amber);
    font-size: var(--text-subhead);
    letter-spacing: 4px;
    color: var(--gof-text-dim);
    text-shadow: 0 2px 6px rgba(0, 0, 0, 0.8);
}

/* Modified: the help's "?" (StarMap: OptionInfo) at the header's right, the title's height. */
.map-help {
    margin-left: auto;
}

/* The "i" window: one hint a line, its keys then its label, no boxes. */
.system-header {
    position: absolute;
    left: 48px;
    top: 100px;
    flex-direction: row;
    align-items: flex-start;
}

.system-logo {
    margin-right: var(--space-m);
}

.system-name {
    font-size: var(--text-heading);
    color: rgb(255, 128, 0);
    margin-bottom: var(--space-xs);
}

.system-line {
    font-size: var(--text-body);
    color: #FFFFFF;
    margin-bottom: var(--space-xs);
}

/* ---- energy line, key legend -------------------------------------------------------------- */

.energy-line {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 124px;
    -unity-text-align: middle-center;
    font-size: var(--text-subhead);
    color: #FFFFFF;
    text-shadow: 0 2px 6px rgba(0, 0, 0, 0.8);
}

.energy-line--short {
    color: rgb(255, 42, 0);
}

.key-box {
    display: none;
    /* Modified: in the footer's right-hand column (.map-side), above its buttons. */
    margin-bottom: var(--space-m);
    padding: 8px 16px;
    background-color: var(--gof-panel);
    border-width: 1px;
    border-color: var(--gof-line);
    border-top-width: 3px;
    border-top-color: var(--gof-amber);
}

.key-box--shown {
    display: flex;
}

.key-row {
    flex-direction: row;
    align-items: center;
    height: 30px;
}

.key-icon-cell {
    width: 40px;
    align-items: center;
    justify-content: center;
}

.key-label {
    font-size: var(--text-body);
    color: var(--gof-text);
    padding: 0;
    margin: 0;
}

/* ---- footer ------------------------------------------------------------------------------ */

.map-footer {
    position: absolute;
    left: 40px;
    right: 40px;
    bottom: 40px;
    flex-direction: row;
    align-items: flex-end;
}

.map-hints {
    display: none;
    flex-grow: 1;
    flex-direction: row;
    flex-wrap: nowrap;   /* Modified: one row, the labels under their keys (was wrap) */
    justify-content: center;
    align-items: center;   /* Modified: centred both ways (was flex-end) */
}

.input-keyboard .map-hints,
.input-gamepad .map-hints {
    display: flex;
}

/* Modified: each hint's label under its keys (StarMap.Hint's hint-keys), on one line, keys and label centred both ways,
   as in the hangar window (HangarWindow.uss): side by side the labels took the row's width. */
.map-hints .hint {
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 4px 8px 2px 8px;   /* Modified: smaller boxes for the smaller keys and labels below (was 8 12 3 12) */
    margin: 0 4px;   /* no top margin (GoF2InputGlyphs' 6 px): the row centres on the boxes themselves */
}

.map-hints .hint-keys {
    flex-direction: row;
    align-items: center;
}

.map-hints .hint-label {
    margin: 3px 0 0 0;
    padding: 0;
    white-space: nowrap;
    -unity-text-align: middle-center;
}

.map-button {
    min-width: 200px;
    padding: 16px 28px;
    font-size: var(--text-subhead);
    letter-spacing: 5px;
    -unity-text-align: middle-center;
    color: var(--gof-text);
    background-color: var(--button-fill);
    border-width: var(--button-border);
    border-color: var(--button-line);
    border-radius: var(--button-radius);
}

/* Modified: the right-hand column's buttons smaller (their two-word labels broke over two lines); Back keeps its size. */
.map-side-buttons .map-button {
    min-width: 160px;
    padding: 12px 24px;
    font-size: var(--text-body);
    letter-spacing: 4px;
    white-space: nowrap;   /* each label on one line: the column takes the widest */
}

/* Modified: the right-hand buttons in a column, Jump to the Void over Full map over Key, the legend above. */
.map-side {
    margin-left: auto;
    flex-direction: column;
    align-items: flex-end;
}

.map-side-buttons {
    flex-direction: column;
    align-items: stretch;
}

#zoomButton,
#keyButton {
    margin-left: 0;
    margin-top: var(--space-s);
}

/* The Khador map's Jump to the Void button (StarMap.AskVoid), in the Void's violet; Modified: on top of the column, as wide
   as the two below. */
#voidButton {
    display: none;
    border-color: rgba(155, 77, 255, 0.85);
}

.map-button:hover,
.map-button--focus {
    color: #FFFFFF;
    border-color: var(--button-focus-line);
    background-color: var(--button-focus-fill);
}

.map-button:active {
    background-color: var(--button-press-fill);
    color: var(--button-press-text);
}

/* ---- ChoiceWindow ------------------------------------------------------------------------ */

.map-dialog-backdrop {
    display: none;
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.6);
    justify-content: center;
    align-items: center;
}

.map-dialog-backdrop--shown {
    display: flex;
}

.map-dialog {
    width: 90%;
    max-width: 700px;
    padding: 36px 44px;
    background-color: var(--gof-panel);
    border-width: 1px;
    border-color: var(--gof-line);
    border-top-width: 3px;
    border-top-color: var(--gof-amber);
}

.map-dialog-text {
    white-space: normal;
    font-size: var(--text-subhead);
    color: var(--gof-text);
    margin-bottom: 20px;   /* + the buttons' margin-top: 28 */
}

.map-dialog-buttons {
    flex-direction: row;
    flex-wrap: wrap;   /* three answers (the drive, the gates, No) on a phone */
    justify-content: flex-end;
}

.map-dialog-button {
    margin-left: var(--space-m);
    margin-top: var(--space-s);
    min-width: 160px;
}

/* ---- remake mods: the selected planet's lore (stations.json "description"), under the system block ----------------- */

.planet-lore {
    position: absolute;
    left: 48px;
    top: 290px;
    width: 560px;
    padding: var(--space-m) var(--space-l);
    background-color: rgba(4, 12, 20, 0.78);
    border-left-width: 3px;
    border-left-color: rgb(0, 190, 255);
}

.planet-lore-title {
    font-size: var(--text-subhead);
    color: rgb(255, 128, 0);
    margin-bottom: var(--space-s);
    white-space: normal;
}

.planet-lore-text {
    font-size: var(--text-body);
    color: #FFFFFF;
    white-space: normal;
}

/* Modified: the footer's hints at the story step label's size (StoryStepLabel: UiLayout.Type(12) = --text-caption), the
   keys and controller buttons cut down to match (the --glyph-sm-* tokens, GoF2Common.uss: they grow with "Text size"
   like the caption), as the station's (StationMenu.uss .station-root). */
.map-hints .hint .hint-label {
    font-size: var(--text-caption);
    letter-spacing: 1px;
    margin-top: 2px;
}

.map-hints .hint .keycap {
    min-width: var(--glyph-sm-key);
    height: var(--glyph-sm-key);
    padding: 0 5px;
    margin: 0 1px;
    font-size: var(--text-caption);
    border-width: 1px;
    border-bottom-width: 2px;
    border-radius: 4px;
}

.map-hints .hint .keycap--wide {
    min-width: 60px;
}

.map-hints .hint .pad-face {
    width: var(--glyph-sm-key);
    height: var(--glyph-sm-key);
    margin: 0 1px;
    border-radius: var(--glyph-sm-key-r);
    font-size: var(--text-caption);
}

.map-hints .hint .pad-stick {
    width: var(--glyph-sm-stick);
    height: var(--glyph-sm-stick);
    margin: 0 1px;
    border-radius: var(--glyph-sm-stick-r);
    border-width: 2px;
    font-size: var(--text-caption);
}

.map-hints .hint .pad-trigger {
    min-width: 28px;
    height: var(--glyph-sm-key);
    padding: 0 5px;
    margin: 0 1px;
    border-top-left-radius: 9px;
    border-top-right-radius: 9px;
}

.map-hints .hint .pad-bumper {
    min-width: 30px;
    height: var(--glyph-sm-bumper);
    padding: 0 5px;
    margin: 0 1px;
    border-radius: var(--glyph-sm-bumper-r);
}

.map-hints .hint .pad-menu {
    height: var(--glyph-sm-bumper);
    padding: 0 5px;
    margin: 0 1px;
    border-radius: var(--glyph-sm-bumper-r);
}
