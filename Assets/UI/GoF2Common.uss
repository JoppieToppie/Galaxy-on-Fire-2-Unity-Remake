/* GoF2 remake: shared design tokens and base control styles (imported by GoF2Theme.tss).
   Palette from the original UI: steel-blue buttons, orange when pressed, cyan glow of the logo.
   :hover rules are scoped to .can-hover, which screen controllers set on their root only while a mouse is in use
   (touch has no real hover: a sliding finger would highlight everything it passes). */

:root {
    --gof-cyan: #3EC8FF;
    --gof-cyan-soft: rgba(62, 200, 255, 0.35);
    --gof-cyan-faint: rgba(62, 200, 255, 0.12);
    --gof-amber: #FFA630;
    --gof-amber-soft: rgba(255, 166, 48, 0.30);
    --gof-text: #D8ECF7;
    --gof-text-dim: rgba(216, 236, 247, 0.55);
    --gof-text-disabled: rgba(216, 236, 247, 0.28);
    --gof-panel: rgba(4, 10, 18, 0.93);
    --gof-line: rgba(62, 200, 255, 0.25);
    --gof-shadow: rgba(0, 0, 0, 0.6);

    /* The original's interface font (gof2_interface.png's bitmap glyphs, font 1111) is Serpentine: Serpentine ICG Light,
       with Inter as its fallback for the letters it lacks (Cyrillic, most of Latin Extended-A). */
    -unity-font-definition: url("project://database/Assets/UI/Fonts/Serpentine-ICG-Light-SDF.asset");
    color: var(--gof-text);
    font-size: 20px;
}

.gof-semibold {
    -unity-font-definition: url("project://database/Assets/UI/Fonts/Serpentine-ICG-Light-SDF.asset");
    -unity-font-style: bold;   /* Serpentine has the one weight: the emphasis is the font asset's bold (faux) style */
}

/* ---- Slider -------------------------------------------------------------------------- */

.unity-base-slider {
    flex-direction: row;
    align-items: center;
    min-height: 40px;
}

.unity-base-slider > .unity-label {
    min-width: 220px;
    color: var(--gof-text);
}

.unity-base-slider__input {
    flex-grow: 1;
    height: 28px;
}

.unity-base-slider__drag-container {
    flex-grow: 1;
    height: 28px;
}

.unity-base-slider__tracker {
    position: absolute;
    left: 0;
    right: 0;
    top: 12px;
    height: 4px;
    background-color: rgba(255, 255, 255, 0.14);
    border-radius: 2px;
}

.unity-base-slider__dragger-border {
    display: none;
}

.unity-base-slider__dragger {
    position: absolute;
    top: 6px;
    width: 16px;
    height: 16px;
    border-radius: 8px;
    background-color: var(--gof-cyan);
    transition-duration: 0.15s;
}

.unity-base-slider:focus .unity-base-slider__dragger,
.can-hover .unity-base-slider:hover .unity-base-slider__dragger {
    background-color: var(--gof-amber);
    scale: 1.25 1.25;
}

/* ---- Toggle -------------------------------------------------------------------------- */

.unity-toggle {
    flex-direction: row;
    align-items: center;
    min-height: 40px;
}

/* The label takes the row's width, so every checkbox lines up at the right edge whatever the label's length. */
.unity-toggle > .unity-label {
    min-width: 220px;
    flex-grow: 1;
    flex-shrink: 1;
    margin-right: 24px;
    white-space: normal;
    color: var(--gof-text);
}

.unity-toggle__input {
    flex-direction: row;
    align-items: center;
    flex-grow: 0;
    flex-shrink: 0;
}

.unity-toggle__checkmark {
    width: 22px;
    height: 22px;
    border-width: 2px;
    border-color: var(--gof-cyan-soft);
    border-radius: 3px;
    background-color: rgba(0, 0, 0, 0.3);
    transition-duration: 0.15s;
}

.unity-toggle:checked .unity-toggle__checkmark {
    background-color: var(--gof-cyan);
    border-color: var(--gof-cyan);
}

.unity-toggle:focus .unity-toggle__checkmark,
.can-hover .unity-toggle:hover .unity-toggle__checkmark {
    border-color: var(--gof-amber);
}

/* ---- ChoiceRow (options with fixed values: segments or a stepper) ------------------------ */

.choice-row {
    flex-direction: row;
    align-items: center;
    min-height: 40px;
}

.choice-label {
    min-width: 220px;
    color: var(--gof-text);
}

.choice-segments,
.choice-stepper {
    flex-grow: 1;
    flex-direction: row;
    align-items: center;
}

.choice-segment {
    flex-grow: 1;
    flex-basis: auto;   /* long values (UNCAPPED) get the room they need */
    white-space: nowrap;
    margin: 0 4px 0 0;
    min-height: 36px;
    padding: 0 8px;
    font-size: 15px;
    -unity-text-align: middle-center;
    letter-spacing: 1px;
    color: var(--gof-text-dim);
    background-color: rgba(255, 255, 255, 0.04);
    border-width: 0;
    border-bottom-width: 2px;
    border-bottom-color: rgba(0, 0, 0, 0);
    border-radius: 0;
    transition-duration: 0.15s;
}

.can-hover .choice-segment:hover {
    color: #FFFFFF;
    background-color: var(--gof-cyan-faint);
}

.choice-segment--active {
    color: var(--gof-cyan);
    background-color: var(--gof-cyan-faint);
    border-bottom-color: var(--gof-cyan);
}

.choice-row:focus .choice-segment--active,
.autopilot-menu-item--selected .choice-segment--active {
    color: var(--gof-amber);
    border-bottom-color: var(--gof-amber);
}

.choice-arrow {
    width: 40px;
    min-height: 36px;
    font-size: 22px;
    -unity-text-align: middle-center;
    color: var(--gof-cyan);
    background-color: rgba(255, 255, 255, 0.04);
    border-width: 0;
    border-radius: 0;
    transition-duration: 0.15s;
}

.can-hover .choice-arrow:hover {
    color: #FFFFFF;
    background-color: var(--gof-cyan-faint);
}

.choice-value {
    flex-grow: 1;
    font-size: 17px;
    letter-spacing: 1px;
    -unity-text-align: middle-center;
    color: var(--gof-cyan);
}

.choice-row:focus .choice-value,
.autopilot-menu-item--selected .choice-value {
    color: var(--gof-amber);
}

/* ---- BindingRow (Options > Controls: a control, its two keys and its controller button) --------------- */

.binding-row {
    flex-direction: row;
    align-items: center;
    min-height: 40px;
}

.binding-label {
    width: 34%;
    flex-shrink: 0;
    padding-right: 8px;
    color: var(--gof-text);
    white-space: normal;
}

.binding-cell {
    flex-grow: 1;
    flex-basis: 0;
    max-width: 190px;
    min-height: 34px;
    margin: 0 0 0 4px;
    padding: 0 6px;
    font-size: 15px;
    -unity-text-align: middle-center;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    color: var(--gof-text);
    background-color: rgba(255, 255, 255, 0.04);
    border-width: 0;
    border-bottom-width: 2px;
    border-bottom-color: rgba(0, 0, 0, 0);
    border-radius: 0;
    transition-duration: 0.15s;
}

.binding-header {
    min-height: 26px;
    margin-top: 6px;
}

.binding-header-cell {
    min-height: 0;
    font-size: 13px;
    letter-spacing: 1px;
    color: var(--gof-text-dim);
    background-color: rgba(0, 0, 0, 0);
}

.binding-cell--pad {
    color: var(--gof-cyan);
}

.can-hover .binding-cell:hover {
    color: #FFFFFF;
    background-color: var(--gof-cyan-faint);
}

.binding-cell--unbound {
    color: var(--gof-text-disabled);
}

.binding-cell--none {
    background-color: rgba(0, 0, 0, 0);
}

/* The × that clears a bound cell: on hover, on the selected row's selected cell, always on touch. */
.binding-cell-clear {
    display: none;
    position: absolute;
    right: 0;
    top: 0;
    bottom: 0;
    width: 26px;
    margin: 0;
    padding: 0;
    font-size: 18px;
    -unity-text-align: middle-center;
    color: var(--gof-text-dim);
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
}

.can-hover .binding-cell-clear:hover {
    color: #FF6B5E;
}

.can-hover .binding-cell--bound:hover .binding-cell-clear,
.binding-row:focus .binding-cell--bound.binding-cell--selected .binding-cell-clear,
.autopilot-menu-item--selected .binding-cell--bound.binding-cell--selected .binding-cell-clear,
.input-touch .binding-cell--bound .binding-cell-clear {
    display: flex;
}

.binding-row:focus .binding-cell--selected,
.autopilot-menu-item--selected .binding-cell--selected {
    color: var(--gof-amber);
    border-bottom-color: var(--gof-amber);
}

.binding-cell--listening,
.binding-row:focus .binding-cell--listening,
.autopilot-menu-item--selected .binding-cell--listening {
    color: #000000;
    background-color: var(--gof-amber);
    border-bottom-color: var(--gof-amber);
}

.option-description {
    margin: 0 0 6px 13px;
    font-size: 15px;
    color: var(--gof-text-dim);
    white-space: normal;
}

/* ---- ScrollView ----------------------------------------------------------------------
   Unity's default theme normally provides this structure; our theme is standalone:
   ScrollView > content-and-vertical-scroll-container (row) > content-viewport > content-container.
   The content container is absolutely placed so it keeps its natural height (vertical lists only). */

.unity-scroll-view {
    overflow: hidden;
    flex-shrink: 1;
}

.unity-scroll-view__content-and-vertical-scroll-container {
    flex-direction: row;
    flex-grow: 1;
    flex-shrink: 1;
}

.unity-scroll-view__content-viewport {
    flex-grow: 1;
    flex-shrink: 1;
    overflow: hidden;
}

.unity-scroll-view__content-container--vertical {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
}

.unity-scroll-view__vertical-scroller,
.unity-scroll-view__horizontal-scroller {
    display: none;
}

/* ---- save slots (main menu Load, station Save game; SaveSlotRow) ------------------------------------------------------------------- */

.slot-list {
    height: 520px;
    flex-shrink: 1;
    min-height: 120px;
    border-top-width: 1px;
    border-top-color: var(--gof-line);
}

.slot-row {
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    height: 64px;
    margin: 0;
    padding: 0 20px 0 14px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-bottom-width: 1px;
    border-bottom-color: rgba(62, 200, 255, 0.12);
    border-left-width: 3px;
    border-left-color: rgba(0, 0, 0, 0);
    border-radius: 0;
    transition-duration: 0.15s;
}

.can-hover .slot-row:hover,
.slot-row:focus {
    background-color: var(--gof-cyan-faint);
    border-left-color: var(--gof-amber);
}

.slot-index {
    width: 58px;
    font-size: 22px;
    letter-spacing: 2px;
    color: var(--gof-cyan);
    -unity-text-align: middle-left;
}

.slot-info {
    flex-grow: 1;
    justify-content: center;
}

.slot-name {
    font-size: 20px;
    color: var(--gof-text);
    -unity-text-align: middle-left;
}

.slot-sub {
    font-size: 14px;
    color: var(--gof-text-dim);
    -unity-text-align: middle-left;
}

.slot-state {
    font-size: 15px;
    letter-spacing: 3px;
    color: var(--gof-text-dim);
}

.slot-row--empty .slot-index {
    color: var(--gof-cyan-soft);
}

.slot-row--empty .slot-name {
    color: var(--gof-text-dim);
}

.slot-row--empty:focus .slot-name,
.can-hover .slot-row--empty:hover .slot-name {
    color: var(--gof-text);
}

/* Remake: hold a used slot to delete it (SaveSlotRow): the row fills red from the left. */
.slot-delete-fill {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 0;
    background-color: rgba(255, 70, 50, 0.32);
}

.slot-list .slot-row.slot-row--deleting,
.slot-list .slot-row.slot-row--deleting:focus {
    border-left-color: rgb(255, 90, 70);
}

.slot-row--deleting .slot-state {
    color: rgb(255, 225, 215);
}

.slot-delete-hint {
    flex-shrink: 0;
    margin-top: 8px;
    font-size: 14px;
    letter-spacing: 1px;
    color: var(--gof-text-dim);
    -unity-text-align: middle-center;
}

/* ---- the in-game Debug pages (PauseMenu.BuildDebug, StationMenu.BuildStationDebug): tabs, a result line, two-column
   grids, cards and button-like actions ------------------------------------------------------------------------------ */

.debug-tabs {
    flex-direction: row;
    align-items: flex-end;
    margin-bottom: 12px;
    border-bottom-width: 1px;
    border-bottom-color: var(--gof-line);
}

.debug-tab {
    margin: 0 4px 0 0;
    padding: 10px 20px;
    font-size: 20px;
    letter-spacing: 3px;
    color: var(--gof-text-dim);
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-bottom-width: 3px;
    border-bottom-color: rgba(0, 0, 0, 0);
    border-radius: 0;
    transition-duration: 0.15s;
}

.can-hover .debug-tab:hover {
    color: #FFFFFF;
}

.debug-tab--active {
    color: #FFFFFF;
    background-color: var(--gof-cyan-faint);
    border-bottom-color: var(--gof-amber);
}

.debug-tab-hint {
    margin-left: auto;
    align-self: center;
    font-size: 16px;
    letter-spacing: 2px;
    color: var(--gof-text-dim);
}

.debug-status {
    margin: 0 0 10px 0;
    padding: 8px 14px;
    font-size: 19px;
    white-space: normal;
    color: #FFFFFF;
    background-color: var(--gof-cyan-faint);
    border-left-width: 3px;
    border-left-color: var(--gof-cyan);
}

.debug-status--empty {
    display: none;
}

.debug-content {
    margin-bottom: 10px;
}

.debug-grid {
    flex-direction: row;
    flex-wrap: wrap;
}

.debug-grid-cell {
    width: 49%;
    margin-right: 1%;
}

.debug-columns {
    flex-direction: row;
    align-items: flex-start;
}

.debug-columns > .debug-card {
    flex-grow: 1;
    flex-basis: 0;
    margin-right: 12px;
}

.debug-card {
    padding: 10px 6px 6px 6px;
    background-color: rgba(255, 255, 255, 0.03);
    border-width: 1px;
    border-color: var(--gof-line);
}

.debug-columns > .debug-card--last {
    margin-right: 0;
}

.debug-card-title {
    margin: 0 0 6px 12px;
    font-size: 18px;
    letter-spacing: 3px;
    color: var(--gof-amber);
}

.debug-card .choice-label {
    min-width: 150px;
}

/* #82: the debug rows read on a phone too. */
.debug-card .choice-value {
    font-size: 21px;
}

.debug-card .choice-segment {
    font-size: 18px;
    min-height: 42px;
}

.debug-card .choice-arrow {
    min-height: 42px;
    width: 48px;
}

.layout-phone .debug-card .choice-label,
.layout-phone .debug-card .choice-value,
.layout-phone .debug-action .option-button {
    font-size: 24px;
}

.layout-phone .debug-card .choice-segment {
    font-size: 21px;
    min-height: 48px;
}

.layout-phone .debug-card .choice-arrow {
    min-height: 48px;
    width: 56px;
}

/* The Give items page's icon grid under the Item stepper (CheatsCatalog.ItemPicker): a tap / click picks. */
.debug-item-grid {
    height: 236px;   /* two rows (the Debug pages are tall enough for them with Amount and the buttons) */
    margin: 6px 6px 2px 6px;
    background-color: rgba(0, 0, 0, 0.18);
}

/* The Item stepper is only a focus stop (keys, controller): out of sight, the grid framed while it is selected. */
.debug-item-stepper {
    height: 0;
    min-height: 0;
    margin: 0;
    padding: 0;
    overflow: hidden;
    opacity: 0;
}

.debug-item-grid {
    border-width: 2px;
    border-color: rgba(0, 0, 0, 0);
}

.debug-item-row--focus .debug-item-grid,
.autopilot-menu-item--selected .debug-item-grid {
    border-color: var(--gof-amber);
}

.debug-item-grid-content {
    flex-direction: row;
    flex-wrap: wrap;
    padding: 4px;
}

.debug-item-cell {
    width: 132px;
    height: 108px;
    margin: 3px;
    padding: 3px;
    overflow: hidden;
    align-items: center;
    background-color: rgba(255, 255, 255, 0.04);
    border-width: 2px;
    border-color: rgba(0, 0, 0, 0);
}

.can-hover .debug-item-cell:hover {
    background-color: var(--gof-cyan-faint);
}

.debug-item-cell--picked {
    border-color: var(--gof-amber);
    background-color: var(--gof-cyan-faint);
}

.debug-item-icon {
    width: 100%;
    max-width: 140px;
    height: 60px;
    -unity-background-scale-mode: scale-to-fit;
}

.debug-item-name {
    align-self: stretch;
    margin-top: 2px;
    font-size: 14px;
    white-space: normal;
    -unity-text-align: upper-center;
    color: var(--gof-text);
    overflow: hidden;
    max-height: 36px;
}

/* The grid's hint panel (the Presets tab: the slot under the pointer, else the picked one, and its equipment). */
.debug-grid-hint {
    min-height: 74px;
    margin: 4px 6px 0 6px;
    padding: 6px 8px;
    background-color: rgba(0, 0, 0, 0.25);
    border-left-width: 3px;
    border-left-color: var(--gof-amber);
}

.debug-grid-hint-title {
    font-size: 16px;
    color: #FFFFFF;
    white-space: normal;
    margin-bottom: 4px;
}

.debug-grid-hint-items {
    flex-direction: row;
    flex-wrap: wrap;
}

.debug-grid-hint-chip {
    flex-direction: row;
    align-items: center;
    margin: 2px 12px 2px 0;
}

.debug-grid-hint-icon {
    width: 62px;
    height: 30px;
    margin-right: 6px;
    -unity-background-scale-mode: scale-to-fit;
}

.debug-grid-hint-text {
    font-size: 14px;
    color: var(--gof-text);
}

.layout-phone .debug-grid-hint-title {
    font-size: 21px;
}

.layout-phone .debug-grid-hint-text {
    font-size: 18px;
}

/* An entry without an icon (the Ships tab's freighters and capital ships): its name in the middle, larger. */
.debug-item-cell--text {
    justify-content: center;
}

.debug-item-cell--text .debug-item-icon {
    display: none;
}

.debug-item-cell--text .debug-item-name {
    font-size: 17px;
    max-height: 60px;
}

.layout-phone .debug-item-grid {
    height: 272px;
}

.layout-phone .debug-item-cell {
    width: 150px;
    height: 126px;
}

.layout-phone .debug-item-icon {
    max-width: 150px;
    height: 68px;
}

.layout-phone .debug-item-name {
    font-size: 17px;
    max-height: 44px;
}

.debug-action {
    margin-top: 8px;
}

.debug-buttons {
    flex-direction: row;
}

.debug-buttons > .debug-action {
    flex-grow: 1;
    flex-basis: 0;
}

/* Option rows that are actions (Reset key bindings, Steering Calibration): a framed button, not a row of plain text. */
.option-item .option-button {
    align-self: flex-start;
    min-width: 240px;
    margin: 4px 0;
    padding: 6px 18px;
    -unity-text-align: middle-center;
    letter-spacing: 2px;
    color: var(--gof-text);
    background-color: var(--gof-cyan-faint);
    border-width: 1px;
    border-color: var(--gof-cyan-soft);
    border-radius: 0;
}

.option-item .option-button:focus,
.can-hover .option-item .option-button:hover {
    background-color: var(--gof-cyan-soft);
    border-color: var(--gof-cyan);
    color: #FFFFFF;
}

.option-item .option-button:active {
    background-color: var(--gof-cyan);
    color: #0B1016;
}

/* The spawn / give buttons look like buttons, not rows. */
.debug-action .option-button {
    align-self: stretch;
    min-width: 0;
    margin: 0;
    padding: 8px 12px;
    -unity-text-align: middle-center;
    letter-spacing: 2px;
    color: #FFFFFF;
    background-color: var(--gof-amber-soft);
    border-width: 1px;
    border-color: var(--gof-amber);
    border-radius: 0;
}

.debug-action .option-button:focus,
.can-hover .option-item.debug-action .option-button:hover,
.option-item.debug-action .option-button:active {
    background-color: var(--gof-amber);
    color: #0B1016;
}

/* ---- Options panels (the main menu's Options panel and the in-game ones, OptionsView) --------------------
   Shared by MainMenu.uxml's panels and OptionsView (the pause menu's and the station's system menu's Options page),
   so the in-game Options look like the main menu's. */

.menu-button {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-left-width: 3px;
    border-left-color: rgba(0, 0, 0, 0);
    border-radius: 0;
    margin: 4px 0;
    padding: 12px 20px;
    -unity-text-align: middle-left;
    font-size: 26px;
    letter-spacing: 5px;
    color: var(--gof-text-dim);
    opacity: 1;
    transition-duration: 0.18s;
    transition-timing-function: ease-out-cubic;
}

.can-hover .menu-button:hover,
.menu-button:focus {
    color: #FFFFFF;
    border-left-color: var(--gof-amber);
    background-color: var(--gof-cyan-faint);
    /* Hover moves the label, not the box: a translated box slid out from under the cursor on its edge, which then
       un-hovered and slid back (flicker, missed clicks). */
    padding-left: 34px;
}

.menu-button:disabled {
    color: var(--gof-text-disabled);
}

.panel-title {
    font-size: 30px;
    letter-spacing: 6px;
    color: var(--gof-cyan);
    -unity-text-align: middle-left;
}

.panel-accent {
    height: 2px;
    width: 120px;
    margin: 14px 0 26px 0;
    background-color: var(--gof-amber);
}

.back-button {
    align-self: flex-start;
    margin-top: 28px;
    font-size: 20px;
}

.tab-row {
    flex-direction: row;
    flex-wrap: wrap;   /* six tabs: a second line on narrow panels rather than wrapped words */
    margin-bottom: 18px;
}

.tab-button {
    flex-shrink: 0;
    white-space: nowrap;
    margin: 0 6px 6px 0;
    padding: 10px 14px;
    font-size: 16px;
    letter-spacing: 2px;
    color: var(--gof-text-dim);
    background-color: rgba(255, 255, 255, 0.03);
    border-width: 0;
    border-bottom-width: 2px;
    border-bottom-color: rgba(0, 0, 0, 0);
    border-radius: 0;
    transition-duration: 0.15s;
}

.can-hover .tab-button:hover,
.tab-button:focus {
    color: #FFFFFF;
    background-color: var(--gof-cyan-faint);
}

.tab-button--active {
    color: var(--gof-cyan);
    border-bottom-color: var(--gof-cyan);
}

.tab-page {
    display: none;
}

.tab-page--active {
    display: flex;
}

.option-row {
    margin: 2px 0;
    padding: 2px 10px;
    border-left-width: 3px;
    border-left-color: rgba(0, 0, 0, 0);
    transition-duration: 0.15s;
}

.option-row:focus,
.can-hover .option-row:hover {
    background-color: var(--gof-cyan-faint);
    border-left-color: var(--gof-amber);
}

.options-scroll {
    height: 560px;
    flex-shrink: 1;
    min-height: 160px;
}

.options-footer {
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-end;
}

.options-defaults {
    align-self: auto;
    color: var(--gof-text-dim);
}

/* Default settings' prompt in the footer's place: the question, then Cancel, only this tab, every tab. */
.options-reset-prompt {
    flex-grow: 1;
    flex-direction: row;
    justify-content: flex-end;
    align-items: center;
}

/* The question gives way (wraps) before the buttons do: they stay on one line. */
.options-reset-question {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    margin-right: 12px;
    color: var(--gof-text-dim);
    -unity-text-align: middle-left;
    white-space: normal;
}

.options-reset-prompt > .menu-button {
    align-self: auto;
    flex-shrink: 0;
    margin-left: 8px;
}

.options-reset-all {
    color: var(--gof-amber);
}

/* OptionsView: the panel itself, like the main menu's .panel (shown at once, no slide-in). */
.options-panel {
    width: 90%;
    max-width: 1000px;   /* the six tabs on one line */
    max-height: 92%;
    padding: 36px 44px;
    background-color: var(--gof-panel);
    border-width: 1px;
    border-color: var(--gof-line);
    border-left-width: 3px;
    border-left-color: var(--gof-cyan);
    border-radius: 2px;
}

.options-panel .menu-button:active {
    background-color: var(--gof-amber-soft);
}

/* The pause menu's highlight (OptionsView.Select: its rows don't take focus): the :focus looks above. */
.option-row.options-selected {
    background-color: var(--gof-cyan-faint);
    border-left-color: var(--gof-amber);
}

.options-selected .unity-base-slider__dragger {
    background-color: var(--gof-amber);
    scale: 1.25 1.25;
}

.options-selected .unity-toggle__checkmark {
    border-color: var(--gof-amber);
}

.tab-button.options-selected {
    color: #FFFFFF;
    background-color: var(--gof-cyan-faint);
}

.menu-button.options-selected {
    color: #FFFFFF;
    border-left-color: var(--gof-amber);
    background-color: var(--gof-cyan-faint);
    padding-left: 34px;
}

.layout-phone .options-panel {
    padding: 24px 34px;
}

.layout-phone .options-panel .panel-accent {
    margin: 10px 0 16px 0;
}

.layout-phone .options-panel .back-button {
    margin-top: 14px;
}

/* ---- controller focus (remake, #24: on a TV the faint cyan highlight was hard to find) ------------------------------
   With a controller in use (the screen root's .input-gamepad) the focused control gets an amber fill and frame. Only
   colours change, no sizes: nothing moves when the focus does. */
.input-gamepad .menu-button:focus,
.input-gamepad .station-button:focus,
.input-gamepad .option-row:focus,
.input-gamepad .option-row.options-selected,
.input-gamepad .slot-row:focus,
.input-gamepad .debug-mission:focus,
.input-gamepad .lounge-row:focus,
.input-gamepad .wanted-row:focus,
.input-gamepad .mods-row:focus,
.input-gamepad .mp-server-row:focus,
.input-gamepad .debug-option:focus,
.input-gamepad .autopilot-menu-item--selected {
    color: #FFFFFF;
    background-color: rgba(255, 166, 48, 0.24);
    border-left-color: var(--gof-amber);
}

/* A stepper / segment row focused on its own (the Debug pages' Give items, Spawn, Ships rows): its fill and arrows too
   (#24: only the value turned amber, so it was hard to tell which row the controller was on). */
.input-gamepad .choice-row:focus {
    background-color: rgba(255, 166, 48, 0.24);
}

.input-gamepad .choice-row:focus .choice-arrow {
    color: var(--gof-amber);
    background-color: rgba(255, 166, 48, 0.18);
}

.input-gamepad .tab-button:focus,
.input-gamepad .tab-button.options-selected,
.input-gamepad .missions-tab:focus {
    color: #FFFFFF;
    background-color: rgba(255, 166, 48, 0.24);
    border-bottom-color: var(--gof-amber);
}

.input-gamepad .choice-button:focus,
.input-gamepad .campaign-card:focus,
.input-gamepad .mp-address-row:focus,
.input-gamepad .mp-action:focus,
.input-gamepad .lounge-back:focus,
.input-gamepad .dialogue-button:focus,
.input-gamepad .update-button:focus,
.input-gamepad .mods-action:focus,
.input-gamepad .mods-footer-button:focus,
.input-gamepad .mods-toggle:focus,
.input-gamepad .launch-button:focus {
    color: #FFFFFF;
    border-color: var(--gof-amber);
    background-color: rgba(255, 166, 48, 0.24);
}

/* A text field with the controller's focus (#20: the multiplayer panel's fields gave no sign of it). */
.input-gamepad .unity-text-field:focus > .unity-text-field__input,
.input-gamepad .unity-text-field__input:focus {
    border-color: var(--gof-amber);
    background-color: rgba(255, 166, 48, 0.16);
}

/* ---- remake: the orbit views around the player's ship, Inspect ship (station) and Action Freeze (flight), OrbitViewUi:
   the title at the top left, the controls at the top right, Back in the footer, the message above it ---------------- */

.orbit-view-title {
    position: absolute;
    left: 64px;
    top: 40px;
    font-size: 34px;
    letter-spacing: 6px;
    color: #FFFFFF;
    text-shadow: 0 2px 6px rgba(0, 0, 0, 0.8);
}

.orbit-view-footer {
    position: absolute;
    left: 40px;
    right: 40px;
    bottom: 40px;
    flex-direction: row;
    align-items: center;
}

.orbit-view-back {
    min-width: 170px;
    padding: 16px 24px;
    margin: 0 16px 0 0;
    font-size: 22px;
    letter-spacing: 3px;
    white-space: nowrap;
    -unity-text-align: middle-center;
    color: #FFFFFF;
    background-color: rgba(62, 200, 255, 0.12);
    border-width: 2px;
    border-color: var(--gof-cyan);
    border-radius: 4px;
}

.can-hover .orbit-view-back:hover {
    background-color: rgba(62, 200, 255, 0.28);
}

/* The controls at the top right, opposite the ship's name (the footer holds the buttons). */
.orbit-view-hints {
    position: absolute;
    top: 30px;
    right: 40px;
    left: 600px;
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: flex-end;
    align-items: center;
}

.orbit-view-hints .hint {
    margin-left: 10px;
}

/* Hide UI: nothing over the view (a short click / tap or H / Y brings it back). */
.orbit-view--clean .orbit-view-title,
.orbit-view--clean .orbit-view-hints,
.orbit-view--clean .orbit-view-footer,
.orbit-view--clean .orbit-view-message {
    display: none;
}

/* "Screenshot saved." above the footer. */
.orbit-view-message {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 130px;
    font-size: 24px;
    letter-spacing: 3px;
    -unity-text-align: middle-center;
    color: #FFFFFF;
    text-shadow: 0 2px 6px rgba(0, 0, 0, 0.8);
}

/* Hide UI / Screenshot / Back in the hints are clickable (a tap on touch). The views put can-hover on their own overlay
   for the mouse. */
.can-hover .orbit-view-hint--action:hover {
    background-color: rgba(62, 200, 255, 0.28);
}

.orbit-view-hint--action:active {
    background-color: rgba(62, 200, 255, 0.4);
}
