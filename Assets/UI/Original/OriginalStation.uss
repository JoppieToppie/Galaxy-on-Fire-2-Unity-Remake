/* Interface style Original (GoF2Original.uss): the rules for StationMenu.uss, Lounge.uss, Status.uss (station main view, lounge, missions, status).
   The original station (Reference/research/station_interior.md, lounge_ui.md; shots s14 / s13): the header bar 0x4ff with
   the station's name on the title plate 0x474, a dark left panel with the system's info, five steel-blue glossy menu
   buttons (TouchButton style 0, amber while pressed), the green launch button bottom-right (style 0xc: 0x472 / 0x473,
   here og_launch(_on): its left cap and the mirrored left cap, the undock icon left out for the remake's label), the
   footer bar 0x507 under the ticker. The lounge: square-cornered scanline windows with a thin steel line, the answers as
   the glossy bars, Okay green (0x00ed00) and No thanks red (0xff2a00, a little lighter here to read on the bar). Lists
   take the hangar's rows (drawBox 3 / 4), section headings the section plate (drawBox 1), info boxes and fields the
   title plate (drawBox 0). */

/* ---- Header: the top bar and the title plate ------------------------------------------------------------------ */

.ui-style-original .top-bar {
    background-image: url("project://database/Assets/UI/Original/og_header.png");
    background-repeat: repeat-x;
    background-size: 332px 100%;
    padding-bottom: 8px;
}

.ui-style-original .station-title {
    background-image: url("project://database/Assets/UI/Original/og_title_plate.png");
    -unity-slice-left: 24;
    -unity-slice-right: 140;
    -unity-slice-top: 0;
    -unity-slice-bottom: 0;
    -unity-slice-scale: 0.5px;
    margin-left: -14px;
    padding: 4px 72px 4px 14px;
    color: #FFFFFF;
}

.ui-style-original .view-title {
    border-left-color: var(--gof-line);
    color: var(--gof-text-dim);
}

/* Menu (the system menu), its Back and the lounge's Back: the glossy bar. */
.ui-style-original .station-menu-button,
.ui-style-original .system-menu-close,
.ui-style-original .lounge-back {
    background-image: url("project://database/Assets/UI/Original/og_button.png");
    -unity-slice-left: 50;
    -unity-slice-right: 54;
    -unity-slice-top: 24;
    -unity-slice-bottom: 24;
    -unity-slice-scale: 0.6px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-left-width: 0;
    border-radius: 0;
    color: var(--gof-text);
}

.ui-style-original .station-menu-button:focus,
.ui-style-original .station-menu-button:active,
.ui-style-original .can-hover .station-menu-button:hover,
.ui-style-original.can-hover .station-menu-button:hover,
.ui-style-original .system-menu-close:focus,
.ui-style-original .system-menu-close:active,
.ui-style-original .can-hover .system-menu-close:hover,
.ui-style-original.can-hover .system-menu-close:hover,
.ui-style-original .lounge-back:focus,
.ui-style-original .lounge-back:active,
.ui-style-original .can-hover .lounge-back:hover,
.ui-style-original.can-hover .lounge-back:hover {
    background-image: url("project://database/Assets/UI/Original/og_button_on.png");
    background-color: rgba(0, 0, 0, 0);
    border-color: rgba(0, 0, 0, 0);
    color: #FFFFFF;
}

/* ---- Credits and cargo: the title plate, white as the original's footer --------------------------------------- */

.ui-style-original .station-funds-cargo,
.ui-style-original .station-funds-credits {
    background-image: url("project://database/Assets/UI/Original/og_title.png");
    -unity-slice-left: 34;
    -unity-slice-right: 34;
    -unity-slice-top: 12;
    -unity-slice-bottom: 12;
    -unity-slice-scale: 0.75px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-radius: 0;
    color: var(--gof-text);
}

.ui-style-original .station-funds-credits {
    color: #FFFFFF;
}

.ui-style-original .station-funds-cargo--over {
    color: #FF6B5E;
    -unity-background-image-tint-color: #FF9A90;
}

/* ---- Left panel: the system's info on the section plate ------------------------------------------------------- */

.ui-style-original .station-info {
    background-image: url("project://database/Assets/UI/Original/og_plate.png");
    -unity-slice-left: 35;
    -unity-slice-right: 35;
    -unity-slice-top: 20;
    -unity-slice-bottom: 20;
    -unity-slice-scale: 0.5px;
    background-color: rgba(0, 0, 0, 0);
    border-left-width: 0;
    border-radius: 0;
}

.ui-style-original .info-system {
    color: #FFFFFF;
}

.ui-style-original .info-line {
    color: var(--gof-text);
}

/* ---- Station buttons (menu, dialog answers, Missions' Show on map, the system menu's rows): the glossy bar ---- */

.ui-style-original .station-button {
    background-image: url("project://database/Assets/UI/Original/og_button.png");
    -unity-slice-left: 50;
    -unity-slice-right: 54;
    -unity-slice-top: 24;
    -unity-slice-bottom: 24;
    -unity-slice-scale: 0.6px;
    -unity-background-image-tint-color: rgba(255, 255, 255, 0.88);
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-left-width: 0;
    border-left-color: rgba(0, 0, 0, 0);
    border-radius: 0;
    color: var(--gof-text);
}

/* The screen showing: the bar at full brightness, white text (the original marks none; the remake has a cyan edge). */
.ui-style-original .station-button--current {
    -unity-background-image-tint-color: #FFFFFF;
    background-color: rgba(0, 0, 0, 0);
    color: #FFFFFF;
}

/* Focus, hover and pressed: amber. The label stays put (the original's buttons don't slide). */
.ui-style-original .station-button:focus,
.ui-style-original .station-button:active,
.ui-style-original .can-hover .station-button:hover,
.ui-style-original.can-hover .station-button:hover {
    background-image: url("project://database/Assets/UI/Original/og_button_on.png");
    -unity-background-image-tint-color: #FFFFFF;
    background-color: rgba(0, 0, 0, 0);
    border-left-color: rgba(0, 0, 0, 0);
    color: #FFFFFF;
    padding-left: 20px;
}

.ui-style-original .station-button.chat-choice:focus,
.ui-style-original .can-hover .station-button.chat-choice:hover,
.ui-style-original.can-hover .station-button.chat-choice:hover {
    padding-left: 16px;
}

/* The answers' colours (TouchButton): Okay green, No thanks / Discard red, in every state. */
.ui-style-original .station-button.chat-choice--ok,
.ui-style-original .station-button.chat-choice--ok:focus,
.ui-style-original .station-button.chat-choice--ok:active,
.ui-style-original .can-hover .station-button.chat-choice--ok:hover,
.ui-style-original.can-hover .station-button.chat-choice--ok:hover {
    color: #00ED00;
}

.ui-style-original .station-button.chat-choice--no,
.ui-style-original .station-button.chat-choice--no:focus,
.ui-style-original .station-button.chat-choice--no:active,
.ui-style-original .can-hover .station-button.chat-choice--no:hover,
.ui-style-original.can-hover .station-button.chat-choice--no:hover {
    color: #FF4020;
}

.ui-style-original .station-button.missions-discard,
.ui-style-original .station-button.missions-discard:focus,
.ui-style-original .station-button.missions-discard:active,
.ui-style-original .can-hover .station-button.missions-discard:hover,
.ui-style-original.can-hover .station-button.missions-discard:hover {
    color: #FF6A5A;
}

/* ---- Launch: the original's green button (0x472), amber while focused / pressed (0x473) ------------------------- */

.ui-style-original .launch-button {
    background-image: url("project://database/Assets/UI/Original/og_launch.png");
    -unity-slice-left: 38;
    -unity-slice-right: 38;
    -unity-slice-top: 0;
    -unity-slice-bottom: 0;
    -unity-slice-scale: 1px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-radius: 0;
    color: #FFFFFF;
}

.ui-style-original .launch-button:focus,
.ui-style-original .launch-button:active,
.ui-style-original .can-hover .launch-button:hover,
.ui-style-original.can-hover .launch-button:hover {
    background-image: url("project://database/Assets/UI/Original/og_launch_on.png");
    background-color: rgba(0, 0, 0, 0);
    color: #FFFFFF;
}

/* ---- News ticker: the footer bar ------------------------------------------------------------------------------ */

.ui-style-original .station-ticker {
    background-image: url("project://database/Assets/UI/Original/og_footer.png");
    background-repeat: repeat-x;
    background-size: 332px 100%;
    background-color: rgba(0, 0, 0, 0.6);
    border-top-width: 0;
    border-bottom-width: 0;
}

.ui-style-original .station-ticker-text {
    color: var(--gof-text-dim);
}

/* ---- Confirmation dialog and system menu: opaque tiles (#31: nothing reads through them) ---------------------- */

.ui-style-original .station-dialog,
.ui-style-original .system-menu {
    background-color: rgb(4, 4, 6);
    -unity-background-image-tint-color: #FFFFFF;
}

.ui-style-original .system-menu-title {
    color: #FFFFFF;
}

/* ---- New medal toast: the scanline tile (its border colours stay the grade's, set in code) -------------------- */

.ui-style-original .medal-toast {
    background-image: url("project://database/Assets/UI/Original/og_panel_bg.png");
    background-repeat: repeat;
    background-size: 320px 320px;
    background-color: rgb(6, 6, 9);
    border-radius: 0;
}

.ui-style-original .medal-toast--flash {
    -unity-background-image-tint-color: #FFD9A0;
}

/* ---- Lounge: name tags, the visitor drawer and rows ----------------------------------------------------------- */

.ui-style-original .lounge-tag {
    background-image: url("project://database/Assets/UI/Original/og_title.png");
    -unity-slice-left: 34;
    -unity-slice-right: 34;
    -unity-slice-top: 12;
    -unity-slice-bottom: 12;
    -unity-slice-scale: 0.75px;
    background-color: rgba(0, 0, 0, 0.35);
    border-width: 0;
    border-radius: 0;
}

.ui-style-original .lounge-tag--selected {
    -unity-background-image-tint-color: #FFC98A;
    background-color: rgba(40, 26, 6, 0.5);
}

.ui-style-original .lounge-drawer-tab {
    background-image: url("project://database/Assets/UI/Original/og_plate.png");
    -unity-slice-left: 35;
    -unity-slice-right: 35;
    -unity-slice-top: 20;
    -unity-slice-bottom: 20;
    -unity-slice-scale: 0.5px;
    background-color: rgba(0, 0, 0, 0);
    border-left-width: 0;
    border-radius: 0;
}

.ui-style-original .lounge-drawer-tab:focus,
.ui-style-original .can-hover .lounge-drawer-tab:hover,
.ui-style-original.can-hover .lounge-drawer-tab:hover {
    -unity-background-image-tint-color: #FFC98A;
    background-color: rgba(0, 0, 0, 0);
}

/* The rows keep the remake's dark scrim under the faint row (over the lit bars the names need it). */
.ui-style-original .lounge-row {
    background-image: url("project://database/Assets/UI/Original/og_row.png");
    -unity-slice-left: 75;
    -unity-slice-right: 75;
    -unity-slice-top: 20;
    -unity-slice-bottom: 20;
    -unity-slice-scale: 0.5px;
    background-color: rgba(4, 4, 6, 0.85);
    border-left-width: 0;
    border-radius: 0;
}

.ui-style-original .lounge-row:focus,
.ui-style-original .lounge-row--selected,
.ui-style-original .can-hover .lounge-row:hover,
.ui-style-original.can-hover .lounge-row:hover {
    background-image: url("project://database/Assets/UI/Original/og_row_on.png");
    background-color: rgba(10, 7, 3, 0.85);
    border-left-color: rgba(0, 0, 0, 0);
}

.ui-style-original .lounge-row-sub {
    color: var(--gof-text-dim);
}

/* ---- Chat window: the scanline window (GoF2Original.uss), its header on the top bar --------------------------- */

.ui-style-original .chat-header {
    background-image: url("project://database/Assets/UI/Original/og_header.png");
    background-repeat: repeat-x;
    background-size: 332px 100%;
    background-color: rgba(0, 0, 0, 0);
    border-bottom-color: var(--gof-line);
}

.ui-style-original .chat-name {
    color: #FFFFFF;
}

.ui-style-original .chat-text {
    color: var(--gof-text);
}

/* ---- Missions window: tabs as the glossy bar, headings on the section plate, the wanted list as rows ---------- */

.ui-style-original .missions-title {
    color: #FFFFFF;
}

.ui-style-original .missions-tab {
    background-image: url("project://database/Assets/UI/Original/og_button.png");
    -unity-slice-left: 50;
    -unity-slice-right: 54;
    -unity-slice-top: 24;
    -unity-slice-bottom: 24;
    -unity-slice-scale: 0.6px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-bottom-width: 0;
    border-radius: 0;
    color: var(--gof-text-dim);
}

.ui-style-original .missions-tab--active,
.ui-style-original .missions-tab:focus,
.ui-style-original .missions-tab:active {
    background-image: url("project://database/Assets/UI/Original/og_button_on.png");
    background-color: rgba(0, 0, 0, 0);
    color: #FFFFFF;
}

.ui-style-original .can-hover .missions-tab:hover,
.ui-style-original.can-hover .missions-tab:hover {
    color: #FFFFFF;
}

.ui-style-original .missions-heading,
.ui-style-original .status-plate {
    background-image: url("project://database/Assets/UI/Original/og_plate.png");
    -unity-slice-left: 35;
    -unity-slice-right: 35;
    -unity-slice-top: 20;
    -unity-slice-bottom: 20;
    -unity-slice-scale: 0.5px;
    background-color: rgba(0, 0, 0, 0);
    padding: 6px 14px;
    color: #FFFFFF;
}

.ui-style-original .wanted-row {
    background-image: url("project://database/Assets/UI/Original/og_row.png");
    -unity-slice-left: 75;
    -unity-slice-right: 75;
    -unity-slice-top: 20;
    -unity-slice-bottom: 20;
    -unity-slice-scale: 0.5px;
    background-color: rgba(0, 0, 0, 0);
    border-left-width: 0;
    border-radius: 0;
}

.ui-style-original .wanted-row--selected,
.ui-style-original .wanted-row:focus,
.ui-style-original .can-hover .wanted-row:hover,
.ui-style-original.can-hover .wanted-row:hover {
    background-image: url("project://database/Assets/UI/Original/og_row_on.png");
    background-color: rgba(0, 0, 0, 0);
    border-left-color: rgba(0, 0, 0, 0);
}

/* ---- Status window: info boxes and the medal hint on the title plate ------------------------------------------ */

.ui-style-original .status-box,
.ui-style-original .medal-hint {
    background-image: url("project://database/Assets/UI/Original/og_title.png");
    -unity-slice-left: 34;
    -unity-slice-right: 34;
    -unity-slice-top: 12;
    -unity-slice-bottom: 12;
    -unity-slice-scale: 0.75px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-radius: 0;
}

.ui-style-original .stat-line-label,
.ui-style-original .rep-name,
.ui-style-original .medal-summary,
.ui-style-original .medal-progress-count {
    color: var(--gof-text-dim);
}

.ui-style-original .rep-track,
.ui-style-original .rep-fill,
.ui-style-original .medal-progress-bar {
    border-radius: 0;
}
