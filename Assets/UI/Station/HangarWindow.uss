/* The station's Hangar window (HangarWindow): tabs Ship / Shop, the item list on the left, the selected row's
   details, trade arrows and action on the right, cargo load and credits in the footer. Shown while the station root
   has hangar-open; it then replaces the side panel and the launch button. */

.hangar-window {
    display: none;
    position: absolute;
    left: 48px;
    right: 40px;
    top: 110px;
    bottom: 96px;
    background-color: rgba(4, 10, 18, 0.92);
    border-width: 1px;
    border-color: var(--gof-line);
    border-top-width: 3px;
    border-top-color: var(--gof-amber);
}

.hangar-open .hangar-window {
    display: flex;
}

.hangar-open .side-panel,
.hangar-open .launch-button,
.hangar-open .side-shade,
.missions-open .side-panel,
.missions-open .side-shade,
.status-open .side-panel,
.status-open .side-shade {
    display: none;
}

/* The shop's controls: the hint row under the window, keyboard and controller only (docs/UI-DESIGN.md "Button prompts"). */
.input-keyboard.hangar-open .station-hints,
.input-gamepad.hangar-open .station-hints {
    display: flex;
}

.hangar-open .station-hints {
    left: 48px;
    right: 40px;
    /* Modified: the strip under the window (its bottom: 96 px), the hints centred in it both ways (they sat right-aligned,
       34 px up). */
    bottom: 0;
    height: 96px;
    justify-content: center;
    align-items: center;
    width: auto;   /* the main view's set 1000 px would squeeze the hints between left and right */
    max-width: none;
    flex-wrap: nowrap;
}

/* Modified: in the hangar window each hint's label under its keys (StationMenu.Hint's hint-keys), on one line: side by
   side the eight hints left their labels a word wide, broken over two or three lines. Keys and label centred both ways;
   the label's own line spacing (capitals, nothing below the line) left more room under it than above the keys, so the
   box's bottom padding is that much smaller. */
.hangar-open .station-hints .hint {
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 8px 12px 3px 12px;
    margin: 0 4px;   /* no top margin (GoF2InputGlyphs' 6 px): the row centres on the boxes themselves */
}

.hangar-open .station-hints .hint-label {
    margin: 3px 0 0 0;
    padding: 0;
    white-space: nowrap;
    -unity-text-align: middle-center;
}

/* ---- tabs ---------------------------------------------------------------------------- */

.hangar-top {
    flex-direction: row;
    align-items: center;
    padding: 8px 16px 0 16px;
    border-bottom-width: 1px;
    border-bottom-color: var(--gof-line);
}

.hangar-tab {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-bottom-width: 3px;
    border-bottom-color: rgba(0, 0, 0, 0);
    border-radius: 0;
    margin: 0 8px 0 0;
    padding: 12px 28px;
    font-size: var(--text-subhead);
    letter-spacing: 4px;
    color: var(--gof-text-dim);
}

.hangar-tab--active {
    color: #FFFFFF;
    border-bottom-color: var(--gof-amber);
}

.can-hover .hangar-tab:hover {
    color: #FFFFFF;
}

.hangar-top-spacer {
    flex-grow: 1;
}

.hangar-close {
    display: none;
    padding: 8px 20px;
    margin-bottom: var(--space-s);
    font-size: var(--text-body);
    letter-spacing: 3px;
    color: var(--gof-text);
    background-color: rgba(4, 10, 18, 0.55);
    border-width: 2px;
    border-color: var(--gof-cyan-soft);
    border-radius: 4px;
}

.input-touch .hangar-close,
.input-keyboard .hangar-close {
    display: flex;
}

.can-hover .hangar-close:hover {
    border-color: var(--gof-amber);
    color: #FFFFFF;
}

/* ---- list ---------------------------------------------------------------------------- */

.hangar-body {
    flex-grow: 1;
    flex-direction: row;
}

.hangar-list {
    width: 56%;
    border-right-width: 1px;
    border-right-color: var(--gof-line);
}

.hangar-list > .unity-scroll-view__content-and-vertical-scroll-container > .unity-scroll-view__content-viewport > .unity-scroll-view__content-container {
    padding-bottom: var(--space-m);
    padding-right: var(--space-l);   /* Remake: the rows clear of the scrollbar along the right edge (list-bar) */
}

/* Remake: a blueprint ingredient's amount in the blueprint ("BLUEPRINT" over "12 / 40 t") at the row's right edge. */
.row-bp-amount {
    flex-shrink: 0;
    margin-left: var(--space-s);
    align-items: flex-end;
}

.row-bp-amount-label {
    font-size: var(--text-caption);
    letter-spacing: 2px;
    color: var(--gof-text-dim);
}

.row-bp-amount-value {
    font-size: var(--text-label);
    color: var(--gof-text);
}

/* Remake: the list's scrollbar (HangarWindow.UpdateListBar; Unity's own scrollers are hidden, GoF2Common): a slim track
   along the list's right edge and a handle to drag with the mouse. */
.list-bar {
    position: absolute;
    width: 12px;
}

.list-bar-track {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgba(255, 255, 255, 0.06);
    border-radius: 6px;
}

.list-bar-thumb {
    position: absolute;
    left: 0;
    right: 0;
    min-height: 30px;
    background-color: rgba(62, 200, 255, 0.45);
    border-radius: 6px;
}

/* Remake: on phones a finger-wide touch area (the bar, transparent) around the same slim track and handle. */
.layout-phone .list-bar {
    width: 56px;
}

.layout-phone .list-bar-track,
.layout-phone .list-bar-thumb {
    left: 22px;
    right: 22px;
}

.can-hover .list-bar-thumb:hover,
.list-bar-thumb--dragging {
    background-color: var(--gof-cyan);
}

.list-header {
    font-size: var(--text-body);
    letter-spacing: 3px;
    color: var(--gof-cyan);
    padding: 16px 20px 8px 20px;
}

.list-row {
    flex-direction: row;
    align-items: center;
    height: 96px;
    margin: 2px 8px;
    padding: 0 16px 0 8px;
    border-left-width: 3px;
    border-left-color: rgba(0, 0, 0, 0);
    background-color: rgba(255, 255, 255, 0.03);
}

/* remake: the Ship tab's hold items (not mounted): a sub-header and an outlined, dimmer row */
.list-header--sub {
    font-size: var(--text-caption);
    letter-spacing: 1px;
    color: var(--gof-amber);
    padding: 8px 20px 4px 32px;
}

/* remake: the Ship tab's mounted items: tinted, with a cyan edge (the hold's items below are outlined and dimmer) */
.list-row--mounted {
    background-color: rgba(62, 200, 255, 0.06);
    border-left-color: var(--gof-cyan);
}

.list-row--cargo {
    background-color: rgba(0, 0, 0, 0);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-top-color: rgba(255, 255, 255, 0.10);
    border-right-color: rgba(255, 255, 255, 0.10);
    border-bottom-color: rgba(255, 255, 255, 0.10);
    margin-left: var(--space-xxl);
}

/* Remake: a shop row the player has in the hold: the description title's blue, in its place (no outline or indent). */
.list-row--owned {
    background-color: rgba(33, 152, 255, 0.12);
}

.list-row--cargo .row-icon {
    opacity: 0.75;
}

.can-hover .list-row:hover {
    background-color: rgba(255, 255, 255, 0.07);
}

.list-row--selected,
.can-hover .list-row--selected:hover {
    background-color: var(--gof-cyan-faint);
    border-left-color: var(--gof-amber);
}

/* Remake: Autocomplete as a button centred in the list (no row look of its own): after the rows' hover / selected
   backgrounds, which drew the grey box around it. */
.list-row--autocomplete,
.list-row--autocomplete.list-row--selected,
.can-hover .list-row--autocomplete:hover,
.can-hover .list-row--autocomplete.list-row--selected:hover {
    height: auto;
    padding: 8px 0;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0);
    border-left-color: rgba(0, 0, 0, 0);
}

.list-row--autocomplete .row-autocomplete {
    margin: 0;
    padding: 12px 28px;
    white-space: normal;
    -unity-text-align: middle-center;
}

.list-row--selected .row-autocomplete {
    background-color: rgba(255, 166, 48, 0.38);
}

.list-row--autocomplete .row-autocomplete--expensive {
    color: #FF6B5E;
}


.row-icon {
    width: 148px;
    height: 72px;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
}

.row-texts {
    flex-grow: 1;
    flex-shrink: 1;
    margin-left: var(--space-l);
    overflow: hidden;
}

.row-name {
    font-size: var(--text-subhead);
    color: var(--gof-text);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.row-name--empty {
    color: var(--gof-text-disabled);
}

.row-sub {
    flex-direction: row;
    align-items: center;
    margin-top: 2px;
}

.row-sub-text {
    font-size: var(--text-body);
    color: var(--gof-text-dim);
}

.row-badge {
    font-size: var(--text-caption);
    letter-spacing: 2px;
    padding: 1px 8px;
    margin-right: var(--space-s);
    border-radius: 3px;
    color: #0B1016;
}

.row-badge--new {
    background-color: var(--gof-amber);
}

.row-badge--mounted {
    background-color: var(--gof-cyan);
}

/* remake: a Ship tab item that is in the hold, not mounted */
.row-badge--cargo {
    background-color: var(--gof-amber);
}

/* remake: a blueprint ingredient this station sells */
.row-badge--stock {
    background-color: #7FD86A;
}

.row-price {
    min-width: 170px;
    font-size: var(--text-subhead);
    color: #FFFFFF;
    -unity-text-align: middle-right;
}

/* Remake: the price beside the name; a shop item's amounts at the row's edges (station left, ship right). */
.row-name-line {
    flex-direction: row;
    align-items: center;
}

.row-name-line .row-name {
    flex-shrink: 1;
}

.row-price-sep {
    flex-shrink: 0;
    margin-left: var(--space-m);
    font-size: var(--text-label);
    color: var(--gof-text-dim);
}

.row-price--inline {
    min-width: 0;
    flex-shrink: 0;
    margin-left: var(--space-m);
    font-size: var(--text-label);
    -unity-text-align: middle-left;
}

.row-qty {
    width: 76px;
    flex-shrink: 0;
    font-size: var(--text-label);
    color: var(--gof-text);
}

.row-qty--station {
    margin-right: var(--space-s);
    -unity-text-align: middle-left;
}

.row-qty--ship {
    margin-left: var(--space-s);
    -unity-text-align: middle-right;
}

/* Manufacturing shop overlay: one-run recipe total before the usual ship amount. */
.row-qty-group {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    margin-left: var(--space-s);
}

/* GOF2_MANUFACTURING_V13_VISUAL: the original fixed 76px ship label
   left empty space before its right-aligned number. Size it to its text,
   keeping the whole pair anchored at the row's right edge. */
.row-qty-group .row-qty--ship {
    width: auto;
    margin-left: 0;
}

/* GOF2_MANUFACTURING_V12_VISUAL: recipe totals are secondary to ship cargo. */
.row-qty--blueprint-required {
    flex-shrink: 0;
    margin-right: var(--space-s, 6px);
    font-size: var(--text-label);
    color: var(--gof-text-dim);
    -unity-text-align: middle-right;
}

/* The blueprint overlay uses a dark resting row, with the same grey hover and
   blue selection distinction as the regular shop, adjusted for the dark base.
   Selected+hovered remains blue, never the hover grey. */
.list-row.list-row--blueprint-material {
    background-color: rgba(12, 27, 24, 0.40);
}
/* GOF2_MANUFACTURING_V14_EXACT_COMPOSITES: colours calculated from this project's ordinary shop rules.
   Blueprint hover = blueprint normal + (ordinary hover - ordinary normal).
   Blueprint selected = blueprint normal + (ordinary selected - ordinary normal).
   The alpha-composite calculation preserves both effects over any backdrop;
   selected + hovered remains selected. */
.can-hover .list-row.list-row--blueprint-material:hover {
    background-color: rgba(34, 48, 45, 0.440);
}
.list-row.list-row--blueprint-material.list-row--selected,
.can-hover .list-row.list-row--blueprint-material.list-row--selected:hover {
    background-color: rgba(9, 55, 66, 0.490);
}

/* Remake: an ingredient's SOLD HERE | amount badge opens the shop on it. */
.can-hover .row-badge--link:hover {
    background-color: #A6F08F;
}

.row-sub--badges .row-badge {
    margin-left: 0;
    margin-right: var(--space-s);
}

.row-sub--trailing .row-badge {
    margin-left: var(--space-s);
    margin-right: 0;
}

.row-price--expensive {
    color: #FF6B5E;
}

/* ---- details ------------------------------------------------------------------------- */

.hangar-details {
    width: 44%;
    padding: 20px 24px 16px 24px;
}

.detail-head {
    flex-direction: row;
    align-items: center;
}

.detail-icon {
    width: 216px;
    height: 105px;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
}

/* Remake: a ship's stats (left) beside its 3D view (right, half the panel). */
.detail-preview-row {
    flex-direction: row;
    align-items: flex-start;
    margin-top: var(--space-s);
    flex-shrink: 0;
}

.detail-preview-side {
    width: 50%;
    flex-shrink: 0;
    align-self: stretch;
}

/* Remake: the space under a ship's view; its buttons centred in it both ways. */
.detail-action-area {
    flex-grow: 1;
    justify-content: center;
    align-items: center;
}

/* Remake: the item window's hint in place of a ship's name and race, as a title bar like "Description". */
/* Remake: a ship's buy / use buttons centred under its view, as wide as their text (FitActions wraps the price). */
.detail-action--side {
    align-self: center;
    margin-top: 0;
    max-width: 100%;
    white-space: normal;
    -unity-text-align: middle-center;
}

.detail-preview-stats {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    margin-right: var(--space-l);
}

/* Remake (#82): a ship's details turn it in 3D under the name (ShipPreview; a click opens the item window).
   Remake: opaque like the item window's box; its height follows its width (ShipPreview.KeepAspect). */
.detail-preview {
    height: 230px;
    flex-shrink: 0;
    background-color: rgb(4, 16, 32);
    border-width: 1px;
    border-color: rgba(33, 152, 255, 0.3);
    overflow: hidden;
}

.detail-preview .info-floor {
    top: 62px;
    height: 130px;
}

.layout-phone .detail-preview {
    height: 190px;
}

.layout-phone .detail-preview .info-floor {
    top: 48px;
    height: 110px;
}

.detail-titles {
    flex-grow: 1;
    flex-shrink: 1;
    margin-left: var(--space-l);
}

.detail-name {
    font-size: var(--text-title);
    color: #FFFFFF;
    white-space: normal;
}

.detail-sub {
    margin-top: var(--space-xs);
    font-size: var(--text-label);
    color: var(--gof-text-dim);
    white-space: normal;
}

/* The trade box and the action buttons keep their height (flex-shrink 0): a short details column squashed them; the stats
   and description scroll instead. */
.trade-box {
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    margin-top: var(--space-l);
    padding: var(--space-m);
    background-color: rgba(255, 255, 255, 0.04);
    border-radius: 4px;
}

.trade-box--hidden {
    display: none;
}

.trade-side {
    width: 110px;
}

.trade-side--right {
    align-items: flex-end;
}

.trade-side-label {
    font-size: var(--text-caption);
    letter-spacing: 2px;
    color: var(--gof-text-dim);
}

.trade-side-value {
    font-size: var(--text-heading);
    color: #FFFFFF;
}

/* remake: what of the item is mounted (a missile launcher's remaining ammo), under the hold's amount */
.trade-side-note {
    font-size: var(--text-small);
    color: var(--gof-text-dim);
}

.trade-arrow {
    /* Remake: as wide as its text (was 116px; "COMPRAR" didn't fit). */
    height: 64px;
    padding: 0 16px;
    margin: 0 8px;
    align-items: center;
    justify-content: center;
    background-color: rgba(4, 10, 18, 0.6);
    border-width: 2px;
    border-color: var(--gof-cyan-soft);
    border-radius: 4px;
    transition-duration: 0.1s;
}

/* Remake: a blueprint ingredient's sides as wide as their text (the fixed 110px broke "12 / 40 t" and ADD in two),
   up to half the box before they wrap. */
.trade-box--ingredient .trade-side {
    width: 110px;
    flex-shrink: 0;
}

/* Remake: a blueprint ingredient's ADD, under the blueprint's amount (right side). */
.trade-arrow--under {
    height: 48px;
    margin: 8px 0 0 0;
}

.trade-arrow--buy {
    border-color: var(--gof-amber);
}

/* Remake (HeldTrade): a held arrow fills from the left over the two seconds it takes to sell / buy the whole stack (it
   replaced Sell all / Buy all). */
.trade-arrow-fill {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 0;
    background-color: rgba(255, 166, 48, 0.35);
}

.can-hover .trade-arrow:hover {
    background-color: rgba(255, 255, 255, 0.08);
}

.trade-arrow--pressed,
.can-hover .trade-arrow--pressed:hover {
    background-color: var(--gof-amber-soft);
    scale: 0.95 0.95;
}

.trade-arrow--disabled {
    opacity: 0.3;
}

.trade-arrow-label {
    font-size: var(--text-label);
    letter-spacing: 3px;
    color: #FFFFFF;
}

.trade-price {
    flex-grow: 1;
    font-size: var(--text-heading);
    color: #FFFFFF;
    -unity-text-align: middle-center;
}

.trade-price--expensive {
    color: #FF6B5E;
}

.detail-action {
    flex-shrink: 0;
    margin: 16px 0 0 0;
    padding: var(--space-l);
    font-size: var(--text-subhead);
    letter-spacing: 4px;
    color: #FFFFFF;
    background-color: var(--button-primary-fill);
    border-width: var(--button-border);
    border-color: var(--button-primary-line);
    border-radius: var(--button-radius);
}

.can-hover .detail-action:hover {
    background-color: var(--button-primary-focus-fill);
}

.detail-action:active {
    background-color: var(--button-press-fill);
    color: var(--button-press-text);
}

.detail-action--hidden {
    display: none;
}

/* The Kaamo Club storage's second row button (Sell, 330) under Use (332). */
.detail-action--secondary {
    margin-top: var(--space-s);
    background-color: rgba(255, 74, 58, 0.12);
    border-color: #FF4A3A;
}

.can-hover .detail-action--secondary:hover {
    background-color: rgba(255, 74, 58, 0.34);
}

.detail-action--secondary:active {
    background-color: #FF4A3A;
}

.detail-action--disabled {
    opacity: 0.35;
}

.detail-scroll {
    flex-grow: 1;
    margin-top: var(--space-l);
}

/* Remake: any other item's stats (left) beside its description (right), filling the panel's bottom. */
.detail-item-row {
    flex-grow: 1;
    flex-direction: row;
    margin-top: var(--space-l);
}

.detail-item-stats {
    flex-grow: 1;
    flex-basis: 0;
    margin-right: var(--space-l);
}

.detail-item-right {
    flex-grow: 1;
    flex-basis: 0;
}

.detail-scroll--side {
    flex-grow: 1;
    margin-top: 0;
}

.stat-row {
    flex-direction: row;
    justify-content: space-between;
    padding: 8px 0;
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.06);
}

.stat-label {
    font-size: var(--text-label);
    color: var(--gof-text-dim);
}

.stat-value {
    font-size: var(--text-label);
    color: var(--gof-text);
}

/* Remake (#62): a dealer / stored ship's stat compared with the ship flown (ItemInfo.ShipStatsCompared). */
.stat-compare {
    flex-direction: row;
    align-items: center;
}

.stat-arrow {
    width: 57px;
    height: 32px;
    margin-left: var(--space-s);
    -unity-background-scale-mode: stretch-to-fill;
}

.detail-text {
    margin-top: var(--space-l);
    font-size: var(--text-body);
    color: var(--gof-text);
    white-space: normal;
}

/* Remake: the ship's Kaamo Club mods under its description (ItemInfo.FillModLines: hangar, carrier, item window). */
.kaamo-mods {
    margin-top: var(--space-l);
    padding: 8px 12px;
    border-left-width: 3px;
    border-left-color: #FFA630;
    background-color: rgba(255, 166, 48, 0.08);
}

.kaamo-mod-line {
    font-size: var(--text-small);
    color: #FFC872;
    white-space: normal;
}

/* ---- footer -------------------------------------------------------------------------- */

.hangar-footer {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding: 12px 24px;
    border-top-width: 1px;
    border-top-color: var(--gof-line);
}

/* Remake: the hold's load (left) and the credits (right) each in a box of their own, in the footer's corners on every tab. */
.footer-cargo,
.footer-credits {
    padding: 8px 16px;
    background-color: rgba(4, 10, 18, 0.6);
    border-width: 2px;
    border-color: var(--gof-cyan-soft);
    border-radius: 4px;
    -unity-text-align: middle-center;
}

.footer-cargo {
    font-size: var(--text-subhead);
    letter-spacing: 1px;
    color: var(--gof-text);
}

.footer-cargo--over {
    color: #FF6B5E;
    border-color: #FF6B5E;
}

/* Remake: a multiplayer session's restock countdown, between the two (HangarWindow.UpdateRestock). */
.footer-restock {
    padding: 8px 16px;
    background-color: rgba(4, 10, 18, 0.6);
    border-width: 2px;
    border-color: var(--gof-line);
    border-radius: 4px;
    -unity-text-align: middle-center;
    font-size: var(--text-label);
    letter-spacing: 1px;
    color: var(--gof-text-dim);
}

.footer-credits {
    font-size: var(--text-heading);
    color: var(--gof-amber);
    border-color: var(--gof-amber);
}

/* ---- messages (sold, mounted, not enough credits ...) ------------------------------------ */

/* An empty list's line (HangarWindow.AddNote; docs/UI-DESIGN.md "Empty states"). */
.list-empty {
    margin: 8px 16px 16px 16px;
    font-size: var(--text-small);
    color: var(--gof-text-dim);
    white-space: normal;
}

/* The look is the shared .gof-toast (GoF2Common.uss); here its place. */
.station-toast {
    position: absolute;
    bottom: 52px;   /* under the windows (at the top it covered their header tabs), above the news ticker */
    left: 50%;
    translate: -50% 0;
    max-width: 900px;
    opacity: 0;
}

.station-toast--shown {
    opacity: 1;
}

/* Phones: smaller rows. */
.layout-phone .row-icon {
    width: 124px;
    height: 60px;
}

.layout-phone .list-row {
    height: 86px;
}

/* ---- blueprints (HangarList::initBlueprintTab: progress bar, highlight while the hold helps) ---------------- */

.bp-bar {
    height: 6px;
    margin-top: var(--space-xs);
    background-color: rgba(255, 255, 255, 0.12);
    border-radius: 3px;
    overflow: hidden;
}

.bp-bar-fill {
    height: 100%;
    background-color: var(--gof-cyan);
}

.row-name--helps {
    color: #6BF06B;
}

/* ListItemWindow's info button (0x470 "i") on the selected row. */
.row-info {
    display: none;
    width: 44px;
    height: 44px;
    margin-left: var(--space-s);
    border-radius: 22px;
    font-size: var(--text-label);
    -unity-text-align: middle-center;
    padding: 0;
}

.list-row--selected .row-info {
    display: flex;
}

/* With a controller the info button shows the controller's Y instead of the "i" (StationMenu opens the details with
   it), like the hint row's glyph. */
.row-info-pad {
    display: none;
    position: absolute;
    left: 4px;
    top: 4px;
    width: 36px;
    height: 36px;
    border-radius: 18px;
    font-size: var(--text-small);
    letter-spacing: 0;
    color: #0B1016;
    background-color: #F2C230;
    -unity-text-align: middle-center;
}

.input-gamepad .row-info-pad {
    display: flex;
}

.input-gamepad .row-info {
    color: rgba(0, 0, 0, 0);
}

/* ListItemWindow: the full-screen details (1300 x 800 box, full screen on phones). */
.info-backdrop {
    display: none;
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0.6);
}

.info-backdrop--shown {
    display: flex;
}

.info-box {
    width: 1300px;
    height: 800px;
    max-width: 100%;
    max-height: 100%;
    padding: 20px 28px 0 28px;
    background-color: rgb(4, 16, 32);
    border-width: 2px;
    border-color: rgba(33, 152, 255, 0.45);
    border-radius: 6px;
}

.layout-phone .info-box {
    width: 100%;
    height: 100%;
}

.info-header {
    font-size: var(--text-title);
    letter-spacing: 3px;
    color: #FFFFFF;
}

.info-help {
    margin-bottom: var(--space-l);
    font-size: var(--text-body);
    white-space: normal;
    color: rgba(150, 200, 255, 0.7);
}

.info-columns {
    flex-grow: 1;
    flex-direction: row;
}

.info-left {
    width: 48%;
    margin-right: 2%;
}

.info-right {
    width: 50%;
}

.info-name-box {
    flex-direction: row;
    align-items: center;
    padding: var(--space-s);
    margin-bottom: var(--space-s);
    background-color: rgba(33, 152, 255, 0.10);
    border-width: 1px;
    border-color: rgba(33, 152, 255, 0.3);
}

.info-icon {
    width: 180px;
    height: 88px;
    margin-right: var(--space-l);
    -unity-background-scale-mode: scale-to-fit;
}

.info-name {
    font-size: var(--text-title);
    color: #FFFFFF;
    white-space: normal;
}

.info-sub {
    font-size: var(--text-label);
    color: rgba(150, 200, 255, 0.8);
}

.info-stats {
    flex-grow: 1;
}

.info-row {
    flex-direction: row;
    align-items: center;
    height: 46px;
    margin-bottom: var(--space-s);
    padding: 0 8px;
    background-color: rgba(33, 152, 255, 0.07);
}

.info-row-label {
    flex-grow: 1;
    font-size: var(--text-label);
    color: rgba(200, 225, 255, 0.85);
}

.info-row-value {
    font-size: var(--text-label);
    color: #FFFFFF;
}

.info-row-arrow {
    width: 82px;
    height: 46px;
    margin-left: var(--space-s);
    -unity-background-scale-mode: stretch-to-fill;
}

.info-preview {
    height: 318px;
    margin-bottom: var(--space-s);
    border-width: 1px;
    border-color: rgba(33, 152, 255, 0.3);
    overflow: hidden;
}

.info-floor {
    position: absolute;
    width: 50%;
    height: 160px;
    left: 0;
    top: 99px;
    -unity-background-scale-mode: stretch-to-fill;
}

.info-floor--mirrored {
    left: 50%;
    scale: -1 1;
}

.info-preview-image {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    -unity-background-scale-mode: scale-and-crop;
}

.info-desc-title {
    font-size: var(--text-label);
    letter-spacing: 2px;
    padding: 8px 8px;
    color: #FFFFFF;
    background-color: rgba(33, 152, 255, 0.12);
}

.info-text-scroll {
    flex-grow: 1;
    margin-top: var(--space-s);
}

/* Remake: the ship alone in the box (ItemInfoWindow.ShowShipView, a click on the hangar details' view). */
.info-box--view .info-header,
.info-box--view .info-help,
.info-box--view .info-left,
.info-box--view .info-desc-title,
.info-box--view .info-text-scroll {
    display: none;
}

.info-box--view .info-right {
    width: 100%;
}

.info-box--view .info-preview {
    flex-grow: 1;
    height: auto;
    margin-bottom: 0;
}

/* Remake: on phones the ship view keeps the desktop's 1300 x 800 box (the details box goes full screen there for its
   text columns; the ship alone filled the whole screen and looked oversized). */
.layout-phone .info-box--view {
    width: 1300px;
    height: 800px;
}

/* Remake: the hangar details' description title, under a ship's view: a section header like the list's (.list-header:
   cyan, spaced capitals, no fill) over a thin line, not the item window's filled title bar. */
.detail-desc-title {
    margin-top: var(--space-xs);
    padding: 8px 0 8px 0;
    font-size: var(--text-body);
    letter-spacing: 3px;
    color: var(--gof-cyan);
    background-color: rgba(0, 0, 0, 0);
    border-bottom-width: 1px;
    border-bottom-color: var(--gof-line);
}

.info-text {
    font-size: var(--text-label);
    white-space: normal;
    color: rgba(220, 235, 255, 0.9);
}

.info-footer {
    height: 74px;
    flex-direction: row;
    justify-content: flex-start;
    align-items: center;
}

.info-back {
    /* Remake: as wide and tall as its text (was min-width 220px, height 54px). */
    font-size: var(--text-subhead);
    /* Remake: drawn like the hangar's close button (outline, amber on hover). */
    padding: 8px 20px;
    letter-spacing: 3px;
    color: var(--gof-text);
    background-color: rgba(4, 10, 18, 0.55);
    border-width: 2px;
    border-color: var(--gof-cyan-soft);
    border-radius: 4px;
}

.can-hover .info-back:hover {
    border-color: var(--gof-amber);
    color: #FFFFFF;
}

/* Rework (docs/UI-DESIGN.md "Layout across aspect ratios"): a compact panel (under 1800 units: a TV, a 16:9 phone, a 1:1
   or 4:3 screen) gives the details more of the width, so the stat names stay on one line beside the ship's view. */
.layout-compact .hangar-list {
    width: 47%;
}

.layout-compact .hangar-details {
    width: 53%;
    padding: 16px 16px 12px 16px;
}

.layout-compact .detail-preview-side {
    width: 44%;
}

/* Manufacturing v0.3: keep the two inventories on a single row like the ordinary shop. */
.trade-box--ingredient .trade-side--right {
    width: 150px;
    flex-shrink: 0;
}
.trade-box--ingredient .trade-side-value {
    white-space: nowrap;
}

/* Production actions: same visual language as the game's arrows, with distinct purpose colours. */
.manufacturing-shop, .manufacturing-autocomplete, .manufacturing-complete {
    border-width: 2px;
    border-radius: 4px;
    padding: 12px 14px;
    margin-top: 6px;
    letter-spacing: 2px;
    background-color: rgba(4, 10, 18, 0.72);
    color: #FFFFFF;
    -unity-text-align: middle-center;
}
.manufacturing-shop { border-color: #49D66E; background-color: rgba(36, 100, 54, 0.30); }
.manufacturing-autocomplete { border-color: var(--gof-amber); background-color: rgba(165, 93, 24, 0.30); }
.manufacturing-complete { border-color: var(--gof-cyan); background-color: rgba(20, 100, 148, 0.30); }
.manufacturing-complete.detail-action--disabled { opacity: 0.4; }
.can-hover .manufacturing-shop:hover { background-color: rgba(36, 100, 54, 0.48); }
.can-hover .manufacturing-autocomplete:hover { background-color: rgba(165, 93, 24, 0.48); }
.can-hover .manufacturing-complete:hover { background-color: rgba(20, 100, 148, 0.48); }
