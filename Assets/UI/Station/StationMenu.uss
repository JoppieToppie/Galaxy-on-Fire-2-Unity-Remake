/* Docked-station screen over the 3D hangar / Space Lounge (StationMenu). Layout like ModStation::OnRender2D:
   header with the station name, a left panel (system, tech level, race, the screen buttons), launch bottom-right.
   The root gets input-touch / input-keyboard / input-gamepad (InputMode) and can-hover while a mouse is used.
   Panel units at 1920x1080 (1600x900 on phones). */

.station-root {
    flex-grow: 1;
}

.drag-zone {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.side-shade {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 48%;
    background-image: url("project://database/Assets/UI/MainMenu/Images/shade_left.png");
    -unity-background-scale-mode: stretch-to-fill;
}

.bottom-shade {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 20%;
    background-image: url("project://database/Assets/UI/MainMenu/Images/shade_bottom.png");
    -unity-background-scale-mode: stretch-to-fill;
}

.station-safe {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

/* ---- header ------------------------------------------------------------------------ */

.top-bar {
    flex-direction: row;
    align-items: center;
    padding: 34px 40px 0 48px;
}

.station-title {
    font-size: 34px;
    letter-spacing: 6px;
    color: #FFFFFF;
    text-shadow: 0 2px 6px rgba(0, 0, 0, 0.8);
}

.view-title {
    flex-grow: 1;
    margin-left: 22px;
    padding-left: 22px;
    border-left-width: 2px;
    border-left-color: var(--gof-amber);
    font-size: 24px;
    letter-spacing: 4px;
    color: var(--gof-text-dim);
    text-shadow: 0 2px 6px rgba(0, 0, 0, 0.8);
}

.station-menu-button {
    display: none;
    margin-left: auto;   /* right-aligned even when the view title is hidden */
    padding: 12px 22px;
    font-size: 20px;
    letter-spacing: 3px;
    color: var(--gof-text);
    background-color: rgba(4, 10, 18, 0.55);
    border-width: 2px;
    border-color: var(--gof-cyan-soft);
    border-radius: 4px;
}

.input-touch .station-menu-button,
.input-keyboard .station-menu-button {
    display: flex;
}

.can-hover .station-menu-button:hover {
    border-color: var(--gof-amber);
    color: #FFFFFF;
}

/* ---- left panel -------------------------------------------------------------------- */

.side-panel {
    position: absolute;
    left: 48px;
    top: 120px;
    bottom: 64px;   /* clear of the news ticker (36 px) along the bottom edge */
    width: 440px;
}

.station-info {
    padding: 14px 18px;
    border-left-width: 3px;
    border-left-color: var(--gof-cyan);
    background-color: rgba(4, 10, 18, 0.55);
}

.info-system {
    font-size: 24px;
    letter-spacing: 3px;
    color: #FFFFFF;
    margin-bottom: 6px;
}

.info-line {
    font-size: 18px;
    letter-spacing: 1px;
    color: var(--gof-text-dim);
}

.station-buttons {
    flex-grow: 1;
    justify-content: flex-end;
}

.station-button {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-left-width: 3px;
    border-left-color: rgba(0, 0, 0, 0);
    border-radius: 0;
    margin: 4px 0;
    padding: 14px 20px;
    -unity-text-align: middle-left;
    font-size: 26px;
    letter-spacing: 5px;
    color: var(--gof-text-dim);
    transition-duration: 0.18s;
    transition-timing-function: ease-out-cubic;
}

.station-button--current {
    color: #FFFFFF;
    border-left-color: var(--gof-cyan);
    background-color: rgba(4, 10, 18, 0.55);
}

.can-hover .station-button:hover,
.station-button:focus {
    color: #FFFFFF;
    border-left-color: var(--gof-amber);
    background-color: var(--gof-cyan-faint);
    /* Hover moves the label, not the box: a translated box slid out from under the cursor on its edge, which then
       un-hovered and slid back (flicker, missed clicks). */
    padding-left: 34px;
}

.station-button:active {
    color: var(--gof-amber);
}

/* ---- launch ------------------------------------------------------------------------ */

.launch-button {
    position: absolute;
    right: 40px;
    bottom: 64px;
    min-width: 260px;
    padding: 20px 34px;
    font-size: 28px;
    letter-spacing: 6px;
    -unity-text-align: middle-center;
    color: #FFFFFF;
    background-color: rgba(255, 166, 48, 0.16);
    border-width: 2px;
    border-color: var(--gof-amber);
    border-radius: 4px;
    transition-duration: 0.15s;
}

.can-hover .launch-button:hover,
.launch-button:focus {
    background-color: rgba(255, 166, 48, 0.38);
    scale: 1.04 1.04;
}

.launch-button:active {
    background-color: var(--gof-amber);
    color: #0B1016;
}

/* ---- keyboard / controller hints (left of the launch button) ------------------------------ */

.station-hints {
    display: none;
    position: absolute;
    right: 340px;
    bottom: 64px;
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: flex-end;
    align-items: flex-end;
    max-width: 1000px;
}

.input-keyboard .station-hints,
.input-gamepad .station-hints {
    display: flex;
}

.station-hints .hint {
    margin-left: 8px;
}

/* ---- confirmation dialog (ChoiceWindow) ---------------------------------------------- */

.station-dialog-backdrop {
    display: none;
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.6);
    justify-content: center;
    align-items: center;
}

.station-dialog-backdrop--shown {
    display: flex;
}

/* Opaque: the panel colour's 7 % shows far more than that in the linear-space UI (the lounge chat's text read through
   the confirmation and its buttons, #31). */
.station-dialog {
    width: 90%;
    max-width: 700px;
    padding: 36px 44px;
    background-color: rgb(4, 10, 18);
    border-width: 1px;
    border-color: var(--gof-line);
    border-top-width: 3px;
    border-top-color: var(--gof-amber);
}

.station-dialog-text {
    white-space: normal;
    font-size: 24px;
    color: var(--gof-text);
    margin-bottom: 28px;
}

.station-dialog-buttons {
    flex-direction: row;
    justify-content: flex-end;
}

.station-dialog-button {
    margin-left: 12px;
    font-size: 22px;
}

/* Menu buttons the story hasn't unlocked yet (ModStation::OnInitialize: half transparent). */
.station-button:disabled {
    opacity: 0.35;
}

/* The story dialogue (UI/Dialogue) fills the screen. */
.dialogue-instance {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

/* ---- system menu (Menu 172: Save game, Back to Main Menu) ------------------------------ */

.system-menu {
    width: 90%;
    max-width: 820px;
    max-height: 92%;
    padding: 32px 40px;
    background-color: var(--gof-panel);
    border-width: 1px;
    border-color: var(--gof-line);
    border-top-width: 3px;
    border-top-color: var(--gof-cyan);
}

.system-menu-title {
    font-size: 28px;
    letter-spacing: 6px;
    color: #FFFFFF;
    margin-bottom: 20px;
}

.system-menu-page {
    display: none;
    flex-shrink: 1;
}

.system-menu-page--shown {
    display: flex;
}

.system-slot-list {
    height: 480px;
}

.system-menu-back {
    margin-top: 16px;
}

/* The Menu's Debug page rows (CheatsCatalog, OptionControl; the Options page is an OptionsView). */
.system-option {
    margin: 3px 0;
    padding: 8px 14px;
    font-size: 20px;
    border-left-width: 3px;
    border-left-color: rgba(0, 0, 0, 0);
}

.system-option Label {
    font-size: 20px;
    color: var(--gof-text);
    min-width: 230px;
}

.system-option .choice-value {
    min-width: 0;
    font-size: 18px;
    color: var(--gof-cyan);
}

.system-option .binding-header > .binding-label {
    min-width: 230px;   /* the rows' name Labels have it */
}

/* The key bindings' column titles: Labels, but not option labels. */
.system-option .binding-header-cell {
    min-width: 0;
    font-size: 13px;
    color: var(--gof-text-dim);
}

.system-option .option-description {
    min-width: 0;
    font-size: 15px;
    color: var(--gof-text-dim);
}

/* Phones: narrower panel. */
.layout-phone .side-panel {
    width: 380px;
}

/* The star map (StarMap) is open: it draws the whole screen. */
.station-map-open .station-safe,
.station-map-open .side-shade,
.station-map-open .bottom-shade,
.station-map-open .drag-zone {
    display: none;
}

/* ---- news ticker (NewsTicker: the main view's bottom strip, scrolling left at 50 px/s) ------------------ */
/* Remake layout: the full width of the UI along its bottom edge, always filled (StationMenu.UpdateTicker). */

.station-ticker {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 36px;
    overflow: hidden;
    background-color: rgba(4, 10, 18, 0.6);
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-top-color: var(--gof-line);
    border-bottom-color: var(--gof-line);
}

.station-ticker-text {
    position: absolute;
    top: 0;
    bottom: 0;
    -unity-text-align: middle-left;
    white-space: nowrap;
    font-size: 20px;
    color: var(--gof-text);
}

.hangar-open .station-ticker,
.lounge-open .station-ticker,
.chat-open .station-ticker,
.missions-open .station-ticker,
.station-map-open .station-ticker,
.ticker-off .station-ticker {
    display: none;
}

/* The Debug page (StationMenu.BuildStationDebug): wider, the tabs over its rows. */
.system-menu--wide {
    max-width: 1180px;   /* the Give items grid: seven icons to a row */
}

/* The Debug page: room for Give items' rows, icon grid and buttons without scrolling. */
.system-menu--wide .system-slot-list {
    height: 570px;
}

.system-menu--wide .system-option Label {
    min-width: 150px;
}

/* New medal (StationMenu.ShowNextMedal): a toast at the top centre that drops in and grows with a short flash, stays 5 s
   and fades out; a tap / click opens the Status window on that medal. The border, top band and title take the grade's
   colour in code. */
.medal-toast {
    position: absolute;
    top: 30px;
    left: 50%;
    translate: -50% -30px;
    scale: 0.85 0.85;
    flex-direction: row;
    align-items: center;
    min-width: 560px;
    padding: 16px 34px 16px 18px;
    background-color: rgba(6, 12, 20, 0.96);
    border-width: 2px;
    border-top-width: 5px;
    border-radius: 3px;
    opacity: 0;
    transition-property: opacity, translate, scale, background-color;
    transition-duration: 0.35s, 0.35s, 0.35s, 0.6s;
    transition-timing-function: ease-out, ease-out-back, ease-out-back, ease-out;
}

.medal-toast--shown {
    opacity: 1;
    translate: -50% 0;
    scale: 1 1;
}

/* The first moment: lit up, then settles to the dark plate. */
.medal-toast--flash {
    background-color: rgba(120, 105, 60, 0.96);
}

.medal-toast:hover {
    background-color: rgba(18, 28, 40, 0.97);
}

.medal-toast-plate {
    flex-shrink: 0;
    margin-right: 22px;
    scale: 1.1 1.1;
}

.medal-toast-title {
    font-size: 18px;
    letter-spacing: 3px;
    -unity-font-style: bold;
}

.medal-toast-name {
    font-size: 30px;
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
}

.medal-toast-reward {
    font-size: 20px;
    color: rgb(143, 216, 255);
    -unity-font-style: bold;
}

.medal-toast-hint {
    margin-top: 6px;
    font-size: 14px;
    color: rgba(216, 236, 247, 0.6);
}

/* Remake: Inspect ship (StationMenu.SetupInspect). The camera orbits the ship while the menu is away; only the ship's name,
   Back and the controls show (OrbitViewUi: .orbit-view-* in GoF2Common.uss, shared with the flight's Action Freeze). */
.inspect-overlay {
    display: none;
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.inspect-overlay--shown {
    display: flex;
}

