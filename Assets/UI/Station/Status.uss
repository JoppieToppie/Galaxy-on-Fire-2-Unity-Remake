/* Status window (StatusWindow, StatusWindow 0x18345c): on HD both columns side by side - pilot, ship, reputation
   and statistics on the left, the 45 medals in three columns on the right. The root gets status-open while it shows. */

/* Modified: placed and edged as the Missions window (Lounge.uss .missions-window): the whole width like the hangar
   window, the amber top edge (one page at a time now: its Status / Medals tabs). */
.status-window {
    display: none;
    position: absolute;
    left: 48px;    /* Rework: the whole width like the hangar window, the prompt strip under it */
    right: 40px;
    top: 120px;
    bottom: 96px;
    background-color: var(--gof-panel);
    border-width: 1px;
    border-color: var(--gof-line);
    border-top-width: 3px;
    border-top-color: var(--gof-amber);
}

.status-open .status-window {
    display: flex;
}

/* Modified: the station's buttons and Launch give way to the window (its info box too, HangarWindow.uss). */
.status-open .station-buttons,
.status-open .launch-button,
.status-open .station-ticker,
.status-open .lounge-tags,
.status-open .lounge-list {
    display: none;
}

.status-body {
    flex-grow: 1;
    flex-direction: row;
    padding: 16px 20px 16px 20px;
}

.status-left {
    flex-grow: 1;
    flex-basis: 0;
    padding-right: var(--space-l);
}

.status-right {
    flex-grow: 1;
    flex-basis: 0;
    padding-left: var(--space-l);
    border-left-width: 1px;
    border-left-color: var(--gof-line);
}

.status-plate {
    font-size: var(--text-body);
    letter-spacing: 4px;
    color: var(--gof-amber);
    margin: 8px 0 8px 0;
}

.status-row {
    flex-direction: row;
}

.status-box {
    flex-grow: 1;
    flex-basis: 0;
    padding: 8px 16px;
    margin-right: var(--space-s);
    background-color: rgba(62, 200, 255, 0.05);
    border-width: 1px;
    border-color: var(--gof-line);
}

.status-box--last {
    margin-right: 0;
}

.status-pilot {
    flex-direction: row;
}

.status-pilot-lines {
    flex-grow: 1;
    justify-content: center;
    align-items: flex-end;
}

.status-big {
    font-size: var(--text-label);
    color: #FFFFFF;
}

.status-line {
    font-size: var(--text-small);
    color: var(--gof-text);
}

.status-ship-icon {
    width: 178px;
    height: 86px;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
}

/* Remake: the ship's icon with its name and stats beside it (right). */
.status-ship-box {
    flex-direction: row;
    align-items: center;
}

.status-ship-lines {
    flex-grow: 1;
    flex-shrink: 1;
    margin-left: var(--space-l);
}

/* Reputation: emblem, bar from the centre toward the liked side, emblem. */
.rep-row {
    flex-direction: row;
    align-items: center;
}

.rep-emblem {
    width: 52px;
    height: 52px;
    -unity-background-scale-mode: scale-to-fit;
}

.rep-emblem--hostile {
    -unity-background-image-tint-color: #FF4A3A;
}

.rep-track {
    flex-grow: 1;
    height: 12px;
    margin: 0 8px;
    background-color: rgba(255, 255, 255, 0.10);
    border-radius: 6px;
}

.rep-fill {
    position: absolute;
    top: 0;
    bottom: 0;
    background-color: var(--gof-cyan);
    border-radius: 6px;
}

/* Remake: the race status bar (StatusWindow.ReputationBar): the empty bar whole at x1.5, the lit image over it from the
   centre to the marker; the emblems against its ends, each race's name centred under its emblem. */
.rep-row--bar {
    justify-content: center;
    align-items: flex-start;
}

.rep-side {
    align-items: center;
    width: 120px;
}

.rep-row--bar .rep-emblem {
    margin: 0;
}

.rep-side-name {
    margin-top: 2px;
    -unity-text-align: upper-center;
    white-space: normal;
}

.rep-bar {
    flex-shrink: 0;
    width: 246px;
    height: 42px;
    margin-top: var(--space-xs);   /* centred on the 52px emblems */
    -unity-background-scale-mode: stretch-to-fill;
}

.rep-bar--dimmed {
    -unity-background-image-tint-color: rgba(120, 140, 160, 0.45);
}

.rep-bar-lit {
    position: absolute;
    top: 0;
    bottom: 0;
    overflow: hidden;
}

.rep-bar-lit-image {
    position: absolute;
    top: 0;
    width: 246px;
    height: 42px;
    -unity-background-scale-mode: stretch-to-fill;
}

.rep-bar-marker {
    position: absolute;
    top: -3px;
    width: 9px;
    height: 48px;
    margin-left: -4px;
    background-color: #FFE6B8;
    border-width: 1px;
    border-color: #D9A15A;
    border-radius: 2px;
}

.rep-marker {
    position: absolute;
    top: -8px;
    width: 4px;
    height: 28px;
    margin-left: -2px;
    background-color: #FFFFFF;
}

/* Remake mods: a faction's emblem (StatusWindow.FactionEmblem): its glow's copies and the icon stacked. */
.rep-emblem-layer {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    -unity-background-scale-mode: scale-to-fit;
}

.rep-names {
    flex-direction: row;
    justify-content: space-between;
    font-size: var(--text-caption);
}

.rep-name {
    font-size: var(--text-caption);
    color: var(--gof-text-dim);
}

.stat-line {
    flex-direction: row;
    justify-content: space-between;
    padding: 3px 0;
}

.stat-line-label {
    font-size: var(--text-small);
    color: var(--gof-text-dim);
}

.stat-line-value {
    font-size: var(--text-small);
    color: #FFFFFF;
}

/* Medals: three columns of the original's plates (228 x 84), the grade-tinted symbol centred at (114, 41), the name in
   white under the plate; the pressed overlay shows on the selected medal. */
.medal-scroll {
    flex-grow: 1;
}

.medal-grid {
    flex-direction: row;
    flex-wrap: wrap;
}

.medal {
    width: 33%;
    margin: 0 0 12px 0;
    padding: 0;
    align-items: center;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
}

.medal-plate {
    width: 228px;
    height: 84px;
    -unity-background-scale-mode: stretch-to-fill;
}

.medal-symbol {
    position: absolute;
    left: 87px;
    top: 14px;
    width: 54px;
    height: 54px;
    -unity-background-scale-mode: stretch-to-fill;
}

.medal-pressed {
    position: absolute;
    left: 0;
    top: 0;
    width: 228px;
    height: 84px;
    display: none;
    -unity-background-scale-mode: stretch-to-fill;
}

.medal--selected .medal-pressed,
.can-hover .medal:hover .medal-pressed {
    display: flex;
}

/* Remake: the medals earned above the grid, and under a medal short of gold the bar toward its next grade (the fill
   tinted in that grade's colour by StatusWindow.ProgressBar) with "count / target". */
.medal-summary {
    margin-bottom: var(--space-s);
    font-size: var(--text-small);
    color: var(--gof-text-dim);
}

.medal-progress {
    width: 228px;
    margin-top: var(--space-xs);
    flex-direction: row;
    align-items: center;
}

.medal-progress-bar {
    flex-grow: 1;
    height: 6px;
    background-color: rgba(255, 255, 255, 0.12);
    border-radius: 3px;
    overflow: hidden;
}

.medal-progress-fill {
    height: 100%;
}

.medal-progress-count {
    margin-left: var(--space-s);
    font-size: var(--text-small);
    color: var(--gof-text-dim);
}

.medal-name {
    margin-top: var(--space-xs);
    font-size: var(--text-small);
    -unity-text-align: middle-center;
    white-space: normal;
    color: #FFFFFF;
}

.medal-hint {
    margin-top: var(--space-s);
    padding: 8px 16px;
    min-height: 60px;
    white-space: normal;
    font-size: var(--text-small);
    color: var(--gof-text);
    background-color: rgba(4, 10, 18, 0.8);
    border-width: 1px;
    border-color: var(--gof-line);
}

/* The main view's key hints don't belong over the window. */
.status-open .station-hints {
    display: none;
}
