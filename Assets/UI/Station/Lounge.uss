/* Space Lounge (LoungePanel) and the Missions window (MissionsWindow) over the station screen.
   The root gets lounge-open while the bar is shown (intro over), chat-open while talking to an agent and missions-open
   while the Missions window is up. Panel units at 1920x1080. */

/* ---- visitor name tags over the 3D billboards (positioned in code) ----------------------------- */

.lounge-tags {
    display: none;
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.lounge-open .lounge-tags {
    display: flex;
}

.chat-open .lounge-tags,
.missions-open .lounge-tags,
.station-map-open .lounge-tags {
    display: none;
}

.lounge-tag {
    position: absolute;
    translate: -50% -100%;
    padding: 8px 16px;
    background-color: rgba(4, 10, 18, 0.72);
    border-width: 1px;
    border-color: var(--gof-cyan-soft);
    border-radius: 4px;
    flex-direction: row;
    align-items: center;
}

.lounge-tag--selected {
    border-color: var(--gof-amber);
    background-color: rgba(40, 26, 6, 0.8);
}

.lounge-tag-name {
    font-size: var(--text-body);
    letter-spacing: 1px;
    color: #FFFFFF;
}

.lounge-tag-mark {
    width: 12px;
    height: 12px;
    margin-left: var(--space-s);
    border-radius: 6px;
    background-color: var(--gof-amber);
}

.lounge-tag-mark--known {
    background-color: var(--gof-text-disabled);
}

/* ---- visitor list (right side) ------------------------------------------------------------ */

.lounge-list {
    display: none;
    position: absolute;
    right: 40px;
    top: 228px;   /* under the credits and the cargo below them (.station-funds) */
    /* Modified: a drawer (LoungePanel.SetDrawer): the arrow tab, then the rows; closed, it slides right by the rows' width
       and only the tab stays on screen (the rows' first 40 px beside it, faded out: SetDrawer turns their picking off). */
    flex-direction: row;
    align-items: flex-start;
    translate: 0 0;
    transition-property: translate;
    transition-duration: 0.25s;
    transition-timing-function: ease-out-cubic;
}

.lounge-list--closed {
    translate: 420px 0;
}

.lounge-rows {
    width: 420px;
}

.lounge-list--closed .lounge-rows {
    opacity: 0;
}

.lounge-drawer-tab {
    width: 44px;
    height: 88px;
    margin: 3px 6px 0 0;
    padding: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(4, 10, 18, 0.85);
    border-width: 0;
    border-left-width: 3px;
    border-left-color: var(--gof-amber);
    border-top-left-radius: 6px;
    border-bottom-left-radius: 6px;
    border-top-right-radius: 0;
    border-bottom-right-radius: 0;
}

.can-hover .lounge-drawer-tab:hover {
    background-color: var(--gof-cyan-faint);
}

.lounge-drawer-arrow {
    font-size: var(--text-heading);
    color: #FFFFFF;
    -unity-text-align: middle-center;
    margin: 0;
    padding: 0 0 4px 0;
}

.lounge-open .lounge-list {
    display: flex;
}

.chat-open .lounge-list,
.missions-open .lounge-list {
    display: none;
}

.lounge-row {
    flex-direction: row;
    align-items: center;
    margin: 3px 0;
    padding: 8px 16px;
    background-color: rgba(4, 10, 18, 0.85);   /* a scrim: over the lit bars 0.55 left the names unreadable */
    border-width: 0;
    border-left-width: 3px;
    border-left-color: rgba(0, 0, 0, 0);
    border-radius: 0;
    transition-duration: 0.15s;
}

.can-hover .lounge-row:hover,
.lounge-row:focus,
.lounge-row--selected {
    border-left-color: var(--gof-amber);
    background-color: var(--gof-cyan-faint);
    margin-left: -10px;   /* grows left; the right edge stays (a translated box slid away from the cursor) */
}

.lounge-row-titles {
    flex-grow: 1;
}

.lounge-row-name {
    font-size: var(--text-label);
    color: #FFFFFF;
}

.lounge-row-sub {
    font-size: var(--text-small);
    color: var(--gof-text-dim);
}

/* ---- chat window ------------------------------------------------------------------------- */

.chat-window {
    display: none;
    position: absolute;
    width: 940px;
    right: 60px;
    bottom: 120px;
    max-height: 820px;
    background-color: var(--gof-panel);
    border-width: 1px;
    border-color: var(--gof-line);
    border-top-width: 3px;
    border-top-color: var(--gof-cyan);
}

.chat-open .chat-window {
    display: flex;
}

/* A visitor in the right half of the view: the window on the left, the visitor framed right of it (LoungePanel.OpenChat). */
.chat-window--left {
    right: auto;
    left: 60px;
}

.chat-open .station-buttons,
.missions-open .station-buttons,
.missions-open .launch-button,
.chat-open .launch-button {
    display: none;
}

.chat-header {
    flex-direction: row;
    align-items: center;
    padding: 12px 16px 8px 20px;
    background-color: rgba(62, 200, 255, 0.08);
    border-bottom-width: 1px;
    border-bottom-color: var(--gof-line);
}

.chat-titles {
    flex-grow: 1;
}

.chat-name {
    font-size: var(--text-subhead);
    letter-spacing: 3px;
    color: #FFFFFF;
}

.chat-sub {
    font-size: var(--text-small);
    letter-spacing: 1px;
    color: var(--gof-text-dim);
}

.chat-body {
    flex-direction: row;
    padding: 16px 20px 0 16px;
    flex-shrink: 1;
}

.chat-portrait {
    margin-right: 20px;
}

.chat-scroll {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 200px;
    max-height: 360px;
}

.chat-text {
    white-space: normal;
    font-size: var(--text-subhead);
    color: var(--gof-text);
}

.chat-choices {
    padding: 12px 20px 16px 196px;
}

.chat-choice {
    margin: 2px 0;
    padding: 8px 16px;
    font-size: var(--text-label);
    letter-spacing: 1px;
}

/* TouchButton colours: Okay green (0x00ed00), No thanks red (0xff2a00); a lone Okay stays white. */
.chat-choice--ok {
    color: #3CF03C;
}

.chat-choice--no {
    color: #FF5A3A;
}

/* ---- missions window --------------------------------------------------------------------- */

/* Rework (docs/UI-DESIGN.md): the whole width like the hangar window (the station info gives way), the prompt strip
   under it. */
.missions-window {
    display: none;
    position: absolute;
    left: 48px;
    right: 40px;
    top: 120px;
    bottom: 96px;
    background-color: var(--gof-panel);
    border-width: 1px;
    border-color: var(--gof-line);
    border-top-width: 3px;
    border-top-color: var(--gof-amber);
}

.missions-open .missions-window {
    display: flex;
}

.missions-title {
    font-size: var(--text-subhead);
    letter-spacing: 5px;
    color: #FFFFFF;
    padding: 12px 8px;
}

.missions-body {
    flex-grow: 1;
    flex-direction: row;
    padding: 16px 20px;
}

/* MissionsWindow (HD): Story and Freelance side by side, each with its own Show on map. */
.missions-section {
    flex-grow: 1;
    flex-basis: 0;
    padding-right: var(--space-l);
}

.missions-section--right {
    padding-right: 0;
    padding-left: var(--space-l);
    border-left-width: 1px;
    border-left-color: var(--gof-line);
}

.missions-heading {
    font-size: var(--text-label);
    letter-spacing: 4px;
    color: var(--gof-amber);
    margin-bottom: var(--space-s);
}

.missions-client {
    flex-direction: row;
    margin-bottom: var(--space-s);
}

.missions-client-lines {
    flex-grow: 1;
    flex-shrink: 1;
}

.missions-scroll {
    max-height: none;
    flex-grow: 1;
}

.missions-footer {
    flex-direction: row;
    justify-content: flex-end;
    padding-top: var(--space-s);
}

.missions-footer .chat-choice {
    margin-left: var(--space-m);
}

/* Most Wanted / Pirate Activity details (a player's suggestion 2026-11-03): Show on map right under the description, at
   its left edge, instead of the panel's bottom-right corner; a long description still scrolls with the button in view. */
.missions-scroll--fit {
    flex-grow: 0;
    flex-shrink: 1;
}

.missions-footer--under {
    justify-content: flex-start;
}

.missions-footer--under .chat-choice {
    margin-left: 0;
}

.missions-discard {
    color: #FF6A5A;
}

/* The Missions / Most Wanted tabs (129 / 3219) next to the title; only with a board here. */
/* Modified: the Missions window's tabs as the hangar's (HangarWindow.uss .hangar-tab): no title before them, plain text,
   the active one white over an amber line. */
.missions-tab {
    margin: 0 8px 0 0;
    padding: 12px 28px;
    font-size: var(--text-subhead);
    letter-spacing: 4px;
    color: var(--gof-text-dim);
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-bottom-width: 3px;
    border-bottom-color: rgba(0, 0, 0, 0);
    border-radius: 0;
}

.missions-tab--active {
    color: #FFFFFF;
    border-bottom-color: var(--gof-amber);
}

.missions-tab:focus,
.can-hover .missions-tab:hover {
    color: #FFFFFF;
}

#missionsTitle {
    display: none;
}

.missions-tab--hidden,
.missions-body--hidden {
    display: none;
}

.wanted-list-section {
    flex-grow: 0.8;
}

.wanted-row {
    margin: 2px 0;
    padding: 8px 12px;
    font-size: var(--text-body);
    -unity-text-align: middle-left;
    color: var(--gof-text-dim);
    background-color: rgba(255, 255, 255, 0.03);
    border-width: 0;
    border-left-width: 3px;
    border-left-color: rgba(0, 0, 0, 0);
    border-radius: 0;
}

.wanted-row--active {
    color: #FFFFFF;
}

.wanted-row--dead {
    color: rgba(255, 255, 255, 0.3);
}

.wanted-row--story {
    color: var(--gof-amber);
}

/* The Pirate activity board's tier 5, "Extremely dangerous" (tier 4 takes the amber above). */
.wanted-row--tier5 {
    color: #FF5A4A;
}

.wanted-row--selected,
.wanted-row:focus,
.can-hover .wanted-row:hover {
    background-color: var(--gof-cyan-faint);
    border-left-color: var(--gof-amber);
}

.portrait-hidden {
    display: none;
}

/* #82: the chat keeps clear of the bottom-right corner (rounded screens, the hint row) and of the screen's middle, where
   the bar camera frames the visitor talked to (StationLevel.ChatFrameY). */
.layout-phone .chat-window {
    width: 900px;
    right: 80px;
    bottom: 140px;
}

.layout-phone .chat-window--left {
    right: auto;
    left: 80px;
}

/* lounge_ui.md 1.2: the lounge shows only its header and a footer with Back, not the main view's side panel, buttons
   and Launch (they covered visitors). Back = the main view (Esc / B too); none while talking or in Missions. */
.lounge-open .side-panel,
.lounge-open .launch-button,
.lounge-open .side-shade {
    display: none;
}

/* Modified: as the star map's Back (StarMap.uss .map-button): dark, a soft cyan edge, amber when hovered / focused,
   filled amber while pressed. */
.lounge-back {
    display: none;
    position: absolute;
    left: 40px;
    bottom: 40px;
    min-width: 200px;
    padding: 16px 28px;
    font-size: var(--text-subhead);
    letter-spacing: 5px;
    -unity-text-align: middle-center;
    color: var(--gof-text);
    background-color: var(--button-fill);
    border-width: var(--button-border);
    border-color: var(--button-line);
    border-radius: var(--button-radius);
}

.lounge-back:focus,
.can-hover .lounge-back:hover {
    color: #FFFFFF;
    border-color: var(--button-focus-line);
    background-color: var(--button-focus-fill);
}

.lounge-back:active {
    background-color: var(--button-press-fill);
    color: var(--button-press-text);
}

/* Modified: the lounge's camera intro (StationMenu: lounge-intro until lounge-open): the hangar's menu hidden at once. */
.lounge-intro .side-panel,
.lounge-intro .launch-button,
.lounge-intro .side-shade,
.lounge-intro .station-hints {
    display: none;
}

.lounge-open .lounge-back {
    display: flex;
}

.chat-open .lounge-back,
.missions-open .lounge-back {
    display: none;
}

/* Rework (docs/UI-DESIGN.md "Button prompts"): the lounge's keys (select a visitor, talk, back) at the bottom right, while
   the visitor list is up (not during the intro, a chat or the Missions window). */
.lounge-prompts {
    display: none;
    position: absolute;
    right: 40px;
    bottom: 40px;
}

.lounge-open .lounge-prompts {
    display: flex;
}

.lounge-intro .lounge-prompts,
.chat-open .lounge-prompts,
.missions-open .lounge-prompts,
.status-open .lounge-prompts {
    display: none;
}

/* Rework (docs/UI-DESIGN.md "Type scale"): a block of running text at most about 80 characters wide, also in the full-width
   Missions window on an ultrawide screen. */
.missions-window .chat-text {
    max-width: 960px;
}
