<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:Template name="Dialogue" src="../Dialogue/Dialogue.uxml" />
    <ui:Style src="../GoF2InputGlyphs.uss" />
    <ui:Style src="StationMenu.uss" />
    <ui:Style src="HangarWindow.uss" />
    <ui:Style src="../Dialogue/Dialogue.uss" />
    <ui:Style src="Lounge.uss" />
    <ui:Style src="Status.uss" />
    <ui:VisualElement name="stationRoot" class="station-root" picking-mode="Ignore">
        <ui:VisualElement class="side-shade" picking-mode="Ignore" />
        <ui:VisualElement class="bottom-shade" picking-mode="Ignore" />
        <ui:VisualElement class="top-shade" picking-mode="Ignore" />
        <ui:VisualElement name="dragZone" class="drag-zone" />
        <ui:VisualElement name="loungeTags" class="lounge-tags" picking-mode="Ignore" />
        <ui:VisualElement name="safeArea" class="station-safe" picking-mode="Ignore">
            <ui:VisualElement class="top-bar" picking-mode="Ignore">
                <ui:Label name="stationTitle" class="station-title gof-semibold" picking-mode="Ignore" />
                <ui:Label name="viewTitle" class="view-title" picking-mode="Ignore" />
                <ui:Button name="menuButton" class="station-menu-button gof-semibold" />
            </ui:VisualElement>
            <ui:VisualElement name="fundsBar" class="station-funds" picking-mode="Ignore">
                <ui:Label name="fundsCredits" class="station-funds-credits gof-semibold" picking-mode="Ignore" />
                <ui:Label name="fundsCargo" class="station-funds-cargo gof-semibold" picking-mode="Ignore" />
            </ui:VisualElement>

            <ui:VisualElement name="sidePanel" class="side-panel" picking-mode="Ignore">
                <ui:VisualElement class="station-info" picking-mode="Ignore">
                    <ui:Label name="systemName" class="info-system gof-semibold" picking-mode="Ignore" />
                    <ui:Label name="techLevel" class="info-line" picking-mode="Ignore" />
                    <ui:Label name="raceName" class="info-line" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:VisualElement class="station-buttons" picking-mode="Ignore">
                    <ui:Button name="hangarButton" class="station-button gof-semibold" />
                    <ui:Button name="loungeButton" class="station-button gof-semibold" />
                    <ui:Button name="mapButton" class="station-button gof-semibold" />
                    <ui:Button name="missionsButton" class="station-button gof-semibold" />
                    <ui:Button name="statusButton" class="station-button gof-semibold" />
                    <ui:Button name="inspectButton" class="station-button gof-semibold" />
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:Button name="launchButton" class="launch-button gof-semibold" />
            <ui:Button name="loungeBack" class="lounge-back gof-semibold" />

            <ui:VisualElement name="hangarWindow" class="hangar-window">
                <ui:VisualElement class="hangar-top">
                    <ui:Button name="tabShip" class="hangar-tab gof-semibold" />
                    <ui:Button name="tabShop" class="hangar-tab gof-semibold" />
                    <ui:Button name="tabBlueprints" class="hangar-tab gof-semibold" />
                    <ui:VisualElement class="hangar-top-spacer" picking-mode="Ignore" />
                    <ui:Button name="hangarClose" class="hangar-close gof-semibold" />
                </ui:VisualElement>
                <ui:VisualElement class="hangar-body" picking-mode="Ignore">
                    <ui:ScrollView name="hangarList" class="hangar-list" />
                    <ui:VisualElement name="hangarDetails" class="hangar-details">
                        <ui:VisualElement class="detail-head" picking-mode="Ignore">
                            <ui:VisualElement name="detailIcon" class="detail-icon" picking-mode="Ignore" />
                            <ui:VisualElement class="detail-titles" picking-mode="Ignore">
                                <ui:Label name="detailName" class="detail-name gof-semibold" picking-mode="Ignore" />
                                <ui:Label name="detailSub" class="detail-sub" picking-mode="Ignore" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement name="tradeBox" class="trade-box">
                            <ui:VisualElement class="trade-side" picking-mode="Ignore">
                                <ui:Label name="tradeStockLabel" class="trade-side-label" picking-mode="Ignore" />
                                <ui:Label name="tradeStock" class="trade-side-value gof-semibold" picking-mode="Ignore" />
                            </ui:VisualElement>
                            <ui:VisualElement name="sellButton" class="trade-arrow">
                                <ui:Label name="sellLabel" class="trade-arrow-label gof-semibold" picking-mode="Ignore" />
                            </ui:VisualElement>
                            <ui:VisualElement class="trade-price-column" picking-mode="Ignore">
                                <ui:Label name="tradePrice" class="trade-price gof-semibold" picking-mode="Ignore" />
                                <ui:Label name="tradeMounted" class="trade-side-note trade-mounted-note" picking-mode="Ignore" />
                            </ui:VisualElement>
                            <ui:VisualElement name="buyButton" class="trade-arrow trade-arrow--buy">
                                <ui:Label name="buyLabel" class="trade-arrow-label gof-semibold" picking-mode="Ignore" />
                            </ui:VisualElement>
                            <ui:VisualElement class="trade-side trade-side--right" picking-mode="Ignore">
                                <ui:Label name="tradeCargoLabel" class="trade-side-label" picking-mode="Ignore" />
                                <ui:Label name="tradeCargo" class="trade-side-value gof-semibold" picking-mode="Ignore" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:Button name="actionButton" class="detail-action gof-semibold" />
                        <ui:Button name="actionButton2" class="detail-action detail-action--secondary gof-semibold" />
                        <ui:ScrollView name="detailScroll" class="detail-scroll">
                            <ui:VisualElement name="detailStats" class="detail-stats" picking-mode="Ignore" />
                            <ui:Label name="detailText" class="detail-text" picking-mode="Ignore" />
                        </ui:ScrollView>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="hangar-footer" picking-mode="Ignore">
                    <ui:Label name="cargoLabel" class="footer-cargo gof-semibold" picking-mode="Ignore" />
                    <ui:Label name="creditsLabel" class="footer-credits gof-semibold" picking-mode="Ignore" />
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement name="ticker" class="station-ticker">
                <ui:Label name="tickerText" class="station-ticker-text" picking-mode="Ignore" />
            </ui:VisualElement>

            <ui:VisualElement name="loungeList" class="lounge-list" picking-mode="Ignore" />

            <ui:VisualElement name="chatWindow" class="chat-window">
                <ui:VisualElement class="chat-header">
                    <ui:VisualElement class="chat-titles" picking-mode="Ignore">
                        <ui:Label name="chatName" class="chat-name gof-semibold" picking-mode="Ignore" />
                        <ui:Label name="chatSub" class="chat-sub" picking-mode="Ignore" />
                    </ui:VisualElement>
                    <ui:Button name="chatClose" class="hangar-close gof-semibold" />
                </ui:VisualElement>
                <ui:VisualElement class="chat-body" picking-mode="Ignore">
                    <ui:VisualElement name="chatPortrait" class="portrait chat-portrait" picking-mode="Ignore" />
                    <ui:ScrollView name="chatScroll" class="chat-scroll">
                        <ui:Label name="chatText" class="chat-text" picking-mode="Ignore" />
                    </ui:ScrollView>
                </ui:VisualElement>
                <ui:VisualElement name="chatChoices" class="chat-choices" picking-mode="Ignore" />
            </ui:VisualElement>

            <ui:VisualElement name="missionsWindow" class="missions-window">
                <ui:VisualElement class="hangar-top">
                    <ui:Label name="missionsTitle" class="missions-title gof-semibold" picking-mode="Ignore" />
                    <ui:Button name="missionsTab" class="missions-tab gof-semibold" />
                    <ui:Button name="pirateTab" class="missions-tab gof-semibold" />
                    <ui:Button name="wantedTab" class="missions-tab gof-semibold" />
                    <ui:VisualElement class="hangar-top-spacer" picking-mode="Ignore" />
                    <ui:Button name="missionsClose" class="hangar-close gof-semibold" />
                </ui:VisualElement>
                <!-- WantedWindow (3219 "Most Wanted"): the board's list and the selected criminal's details. -->
                <ui:VisualElement name="wantedBody" class="missions-body wanted-body" picking-mode="Ignore">
                    <ui:VisualElement class="missions-section wanted-list-section" picking-mode="Ignore">
                        <ui:Label name="wantedListHeading" class="missions-heading gof-semibold" picking-mode="Ignore" />
                        <ui:ScrollView name="wantedList" class="chat-scroll missions-scroll" />
                    </ui:VisualElement>
                    <ui:VisualElement class="missions-section missions-section--right" picking-mode="Ignore">
                        <ui:Label name="wantedDetailsHeading" class="missions-heading gof-semibold" picking-mode="Ignore" />
                        <ui:VisualElement class="missions-client" picking-mode="Ignore">
                            <ui:VisualElement name="wantedPortrait" class="portrait chat-portrait" picking-mode="Ignore" />
                            <ui:VisualElement class="missions-client-lines" picking-mode="Ignore">
                                <ui:Label name="wantedName" class="chat-name gof-semibold" picking-mode="Ignore" />
                                <ui:Label name="wantedStatus" class="chat-sub" picking-mode="Ignore" />
                                <ui:Label name="wantedBounty" class="chat-sub" picking-mode="Ignore" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:ScrollView name="wantedScroll" class="chat-scroll missions-scroll missions-scroll--fit">
                            <ui:Label name="wantedText" class="chat-text" picking-mode="Ignore" />
                        </ui:ScrollView>
                        <ui:VisualElement class="missions-footer missions-footer--under" picking-mode="Ignore">
                            <ui:Button name="wantedMap" class="station-button chat-choice gof-semibold" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="missionsBody" class="missions-body" picking-mode="Ignore">
                    <ui:VisualElement class="missions-section" picking-mode="Ignore">
                        <ui:Label name="storyHeading" class="missions-heading gof-semibold" picking-mode="Ignore" />
                        <ui:ScrollView name="storyScroll" class="chat-scroll missions-scroll">
                            <ui:Label name="storyText" class="chat-text" picking-mode="Ignore" />
                        </ui:ScrollView>
                        <ui:VisualElement class="missions-footer" picking-mode="Ignore">
                            <ui:Button name="storyMap" class="station-button chat-choice gof-semibold" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement class="missions-section missions-section--right" picking-mode="Ignore">
                        <ui:Label name="freelanceHeading" class="missions-heading gof-semibold" picking-mode="Ignore" />
                        <ui:VisualElement class="missions-client" picking-mode="Ignore">
                            <ui:VisualElement name="missionsPortrait" class="portrait chat-portrait" picking-mode="Ignore" />
                            <ui:VisualElement class="missions-client-lines" picking-mode="Ignore">
                                <ui:Label name="freelanceClient" class="chat-name gof-semibold" picking-mode="Ignore" />
                                <ui:Label name="freelanceWhere" class="chat-sub" picking-mode="Ignore" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:ScrollView name="freelanceScroll" class="chat-scroll missions-scroll">
                            <ui:Label name="freelanceText" class="chat-text" picking-mode="Ignore" />
                        </ui:ScrollView>
                        <ui:VisualElement class="missions-footer" picking-mode="Ignore">
                            <ui:Button name="freelanceMap" class="station-button chat-choice gof-semibold" />
                            <ui:Button name="freelanceDiscard" class="station-button chat-choice missions-discard gof-semibold" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement name="statusWindow" class="status-window">
                <ui:VisualElement class="hangar-top">
                    <ui:Label name="statusTitle" class="missions-title gof-semibold" picking-mode="Ignore" />
                    <ui:VisualElement class="hangar-top-spacer" picking-mode="Ignore" />
                    <ui:Button name="statusClose" class="hangar-close gof-semibold" />
                </ui:VisualElement>
                <ui:VisualElement class="status-body" picking-mode="Ignore">
                    <ui:ScrollView name="statusLeftScroll" class="status-left">
                        <ui:VisualElement name="statusLeft" picking-mode="Ignore" />
                    </ui:ScrollView>
                    <ui:VisualElement class="status-right" picking-mode="Ignore">
                        <ui:Label name="medalsTitle" class="status-plate gof-semibold" picking-mode="Ignore" />
                        <ui:ScrollView name="medalScroll" class="medal-scroll">
                            <ui:VisualElement name="medalGrid" class="medal-grid" picking-mode="Ignore" />
                        </ui:ScrollView>
                        <ui:Label name="medalHint" class="medal-hint" picking-mode="Ignore" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement name="hints" class="station-hints" picking-mode="Ignore" />
            <ui:Label name="toast" class="station-toast gof-toast" picking-mode="Ignore" />
        </ui:VisualElement>

        <ui:VisualElement name="systemMenu" class="station-dialog-backdrop">
            <ui:VisualElement class="system-menu">
                <ui:Label name="systemMenuTitle" class="system-menu-title gof-semibold" />
                <ui:VisualElement name="systemMenuMain" class="system-menu-page">
                    <ui:Button name="saveGameButton" class="station-button gof-semibold" />
                    <ui:Button name="mainMenuButton" class="station-button gof-semibold" />
                    <ui:Button name="systemMenuClose" class="station-button gof-semibold" />
                </ui:VisualElement>
                <ui:VisualElement name="systemMenuSave" class="system-menu-page">
                    <ui:ScrollView name="saveSlotList" class="slot-list system-slot-list" />
                    <ui:Button name="saveBack" class="station-button system-menu-back gof-semibold" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:Instance template="Dialogue" name="storyDialogue" class="dialogue-instance" picking-mode="Ignore" />
        <ui:VisualElement name="dialog" class="station-dialog-backdrop">
            <ui:VisualElement class="station-dialog">
                <ui:Label name="dialogText" class="station-dialog-text" />
                <ui:VisualElement class="station-dialog-buttons">
                    <ui:Button name="dialogYes" class="station-button station-dialog-button gof-semibold" />
                    <ui:Button name="dialogNo" class="station-button station-dialog-button gof-semibold" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
