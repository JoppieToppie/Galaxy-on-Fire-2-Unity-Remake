/* In-flight HUD. The root gets input-touch / input-keyboard / input-gamepad from FlightHud (InputMode):
   touch controls only show for touch, the hint row only for keyboard and controller. Panel units at 1920x1080
   (1600x900 on phones, so everything is relatively bigger there). */

.hud {
    flex-grow: 1;
}

.hud-safe {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

/* ---- touch controls (TouchControls: the original's images, placed in code by Globals::setCoordsSteer / setCoordsFire) ---- */

.touch-layer {
    display: none;
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    overflow: hidden;
}

.input-touch .touch-layer,
.hud-cursor .touch-layer {
    display: flex;
}

/* The throttle gauge (TouchControls): the touch layer's box, in every input mode. */
.touch-gauge-layer {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    overflow: hidden;
}

.touch-abs {
    position: absolute;
}

/* The empty screen behind the controls: the throttle drag, the dodge, the free-look orbit. */
.touch-gesture-zone {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

/* Hud::updateSecondaryWeaponString on the plate 0x4c2: "<name> (<n>)" centred, its top at h - 32. */
/* Centred on the plate below its top frame line (rows 0-2 of the 37 px image; the plate stands on the screen edge). The
   body-size text of the interface rework sat at the top with the empty half of the plate under it. */
.touch-plate-text {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    padding-top: 3px;
    font-size: var(--text-body);
    color: #FFFFFF;
    -unity-text-align: middle-center;
    white-space: nowrap;
}

/* Remake (#81 / #82): the weapon strip, the mounted secondaries' shop icons with their ammo (TouchControls). */
.sec-strip {
    flex-direction: column;
    align-items: stretch;
}

.sec-strip-name {
    height: 34px;
    font-size: var(--text-label);
    color: #FFFFFF;
    -unity-text-align: lower-center;
    white-space: nowrap;
    overflow: hidden;
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.9);
}

.sec-strip-row {
    flex-direction: row;
}

.sec-strip-cell {
    width: 150px;
    height: 73px;
    margin-right: var(--space-m);
    background-color: rgba(5, 18, 32, 0.82);
    border-width: 2px;
    border-color: rgba(62, 200, 255, 0.45);
    border-radius: 4px;
    transition-property: scale, border-color;
    transition-duration: 0.08s;
}

.sec-strip-icon {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    -unity-background-scale-mode: scale-to-fit;
}

.sec-strip-ammo {
    position: absolute;
    right: 6px;
    bottom: 2px;
    font-size: var(--text-body);
    color: #FFFFFF;
    text-shadow: 0 1px 3px rgba(0, 0, 0, 1);
}

.sec-strip-cell--selected {
    border-color: rgb(255, 176, 46);
    border-width: 3px;
}

.sec-strip-cell--hover {
    border-color: #FFFFFF;
    scale: 1.12 1.12;
}

.sec-strip-cell--empty {
    opacity: 0.4;
}

/* PlayerEgo::drawThrottle: the thrust number under the crosshair. */
.touch-gauge-text {
    position: absolute;
    width: 120px;
    font-size: var(--text-label);
    color: #FFFFFF;
    -unity-text-align: upper-center;
}

/* ---- crosshair (screen projection of ship + forward * 22000 units) ---------------------------- */

/* 0x4c0 at its native HD size (81 px, gof2_interface_iphone4.png): the HUD images are drawn 1:1 in panel pixels. */
.crosshair {
    position: absolute;
    width: 81px;
    height: 81px;
    margin-left: -40.5px;
    margin-top: -40.5px;
    background-image: url("project://database/Assets/UI/Flight/Images/crosshair.png");
    -unity-background-scale-mode: scale-to-fit;
    opacity: 0.9;
}

.crosshair--hit {
    background-image: url("project://database/Assets/UI/Flight/Images/crosshair_hit.png");
}

.crosshair--hidden {
    display: none;
}

/* PlayerEgo::draw: none on the autopilot (FlightHud.UpdateCrosshair; its place still holds the gauge and the rings). */
.crosshair--autopilot {
    opacity: 0;
}

/* the plasma collectors' turret view: 0x1f5d (gof2_interface3.png, 214 px) */
.crosshair--plasma,
.crosshair--plasma.crosshair--hit {
    width: 214px;
    height: 214px;
    margin-left: -107px;
    margin-top: -107px;
    background-image: url("project://database/Assets/Resources/GoF2Hud/plasma_crosshair_idle.png");
}

/* PlayerEgo::draw: 0x1f5d while plasma is in range (Radar::isPlasmaInRange), else 0x1f5e above. */
.crosshair--plasma.crosshair--plasma-in,
.crosshair--plasma.crosshair--plasma-in.crosshair--hit {
    background-image: url("project://database/Assets/Resources/GoF2Hud/plasma_crosshair.png");
}

/* ---- dock prompt (inside the station's dock range, SpaceLevel.CanDock) ---------------- */

.dock-prompt {
    position: absolute;
    top: 120px;
    left: 50%;
    translate: -50% 0;
    flex-direction: row;
    align-items: center;
    padding: 16px 28px;
    background-color: rgba(4, 10, 18, 0.6);
    border-width: 2px;
    border-color: var(--gof-cyan);
    border-radius: 4px;
}

.dock-prompt--hidden {
    display: none;
}

.dock-glyph {
    flex-direction: row;
    margin-right: var(--space-m);
}

.input-touch .dock-glyph {
    display: none;
}

.dock-label {
    font-size: var(--text-subhead);
    letter-spacing: 5px;
    color: #FFFFFF;
}

/* ---- asteroid lock (MiningView) and HUD messages ------------------------------------ */

.lock-ring {
    display: none;
    position: absolute;
    width: 80px;
    height: 80px;
    margin-left: -40px;
    margin-top: -40px;
}

.lock-ring--shown {
    display: flex;
}

.lock-plate {
    display: none;
    position: absolute;
    top: 6px;
    left: 50%;
    width: 408px;
    height: 57px;
    margin-left: -204px;
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.lock-plate--shown {
    display: flex;
}

.lock-class {
    margin-right: var(--space-s);
}

.lock-ore {
    font-size: var(--text-label);
    color: #FFFFFF;
}

/* Radar::drawCurrentLock: a Most Wanted criminal's plate text in its own colour. */
.lock-ore--wanted {
    color: #FF6A4D;
}

/* Hud::drawEventQueue: one message on the plate 0x4c3 (392 x 44, size set in code) at the top centre, y -8, or 42 under
   the lock plate; the text 12 px into it. The remake's lock plate sits 14 px lower than the original's (top 6), so the low
   position is 42 + 14 (at 42 its top edge cut into the lock plate). */
.hud-messages {
    display: none;
    position: absolute;
    top: -8px;
    left: 50%;
    margin-left: -196px;
}

.hud-messages--shown {
    display: flex;
}

.hud-messages--low {
    top: 56px;
}

/* Remake: with the FPS counter shown (FpsCounter, top 2, ~23 px tall) the top-centre plates move 24 px down under it
   (#137: the HUD message was drawn over the counter). */
.hud-fps .lock-plate {
    top: 30px;
}

.hud-fps .hud-messages {
    top: 16px;
}

.hud-fps .hud-messages--low {
    top: 80px;
}

.hud-message {
    position: absolute;
    left: -200px;
    right: -200px;
    top: 10px;
    font-size: var(--text-body);
    color: #FFFFFF;
    -unity-text-align: upper-center;
    white-space: nowrap;
}

.hud-message--orange {
    color: rgb(255, 128, 0);
}

/* ---- navigation markers (NavigationView): brackets, names, distances, gate icons -------- */

.nav-markers {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.nav-abs {
    position: absolute;
}

.nav-label {
    position: absolute;
    font-size: var(--text-body);
    color: #FFFFFF;
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.9);
}

.nav-label--dim {
    color: rgba(216, 236, 247, 0.8);
}

/* Modified: a friendly docking object's bracket (NavigationView), the friend's green; colour-blind: blue. */
.nav-bracket--friend {
    -unity-background-image-tint-color: #3BE86A;
}

.ui-colorblind .nav-bracket--friend {
    -unity-background-image-tint-color: #4FB2FF;
}

/* Multiplayer: a neighbouring station the player's faction holds, an orb on its planet (NavigationView); red while it is
   besieged (declared or running). */
.nav-faction {
    width: 16px;
    height: 16px;
    border-radius: 8px;
    background-color: rgb(120, 230, 140);
    border-width: 2px;
    border-color: rgba(200, 255, 210, 0.9);
}

.nav-faction--siege {
    background-color: rgb(255, 102, 85);
    border-color: rgba(255, 200, 190, 0.9);
}

/* Autopilot + fast-forward buttons on their pill (left side, touch only; Globals::setCoordsSteer, moved below the
   speed readout). */
.nav-buttons {
    display: none;
    position: absolute;
    left: 32px;
    top: 250px;
    width: 126px;
    height: 293px;
}

.nav-button {
    position: absolute;
    left: 8px;
}

.nav-button--ff {
    top: 0;
}

.nav-button--autopilot {
    top: 180px;
}

/* VR (Vr.VrCockpit): the HUD's corners are on the cockpit's displays, the canopy shows its middle: the menu there. */
.hud-vr .radar-ellipse {
    display: none;
}

.hud-vr .autopilot-menu {
    left: 50%;
    translate: -50% 0;
}

/* Autopilot menu (Hud::initHudMenu(3)): next to the autopilot button; the game is paused while it is open. */
.autopilot-menu {
    display: none;
    position: absolute;
    left: 176px;
    top: 300px;
    min-width: 440px;
    padding: 16px 16px 16px 16px;
    background-color: var(--gof-panel);
    border-width: 1px;
    border-color: var(--gof-line);
    border-left-width: 3px;
    border-left-color: var(--gof-amber);
}

.autopilot-menu--shown {
    display: flex;
}

/* Modified: the actions menu (E, FlightHud.OpenAutopilotMenu(true)) on the right, mirrored; the autopilot's (Q) stays left. */
.autopilot-menu--actions {
    left: auto;
    right: 176px;
    border-left-width: 1px;
    border-left-color: var(--gof-line);
    border-right-width: 3px;
    border-right-color: var(--gof-amber);
}

.hud-vr .autopilot-menu--actions {
    right: auto;
}

.autopilot-menu-head {
    flex-direction: row;
    align-items: center;
    margin-bottom: var(--space-s);
}

.autopilot-menu-icon {
    width: 83px;
    height: 51px;
    margin-right: var(--space-m);
}

.autopilot-menu-title {
    font-size: var(--text-subhead);
    letter-spacing: 4px;
    color: #FFFFFF;
}

.autopilot-menu-item {
    margin: 2px 0;
    padding: 16px 16px;
    font-size: var(--text-subhead);
    letter-spacing: 3px;
    -unity-text-align: middle-left;
    color: var(--gof-text);
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-left-width: 3px;
    border-left-color: rgba(0, 0, 0, 0);
    border-radius: 0;
}

.autopilot-menu-item:hover,
.autopilot-menu-item--selected {
    color: #FFFFFF;
    background-color: var(--gof-cyan-faint);
    border-left-color: var(--gof-amber);
}

.autopilot-menu-item:active {
    color: var(--gof-amber);
}

.hud-cinematic .hud-safe {
    display: none;
}

/* The launch / arrival camera (LevelScript's fly-in keeps this[0x11], so MGame::OnRender2D skips Hud::draw and Radar::draw):
   only the orbit information shows. Visibility, not display: it is inherited, so the orbit block can turn itself back on. */
.hud-launch .hud-safe {
    visibility: hidden;
}

.hud-launch .orbit-info {
    visibility: visible;
}

/* ---- mining minigame (full screen, under the touch controls) ------------------------------ */

.mining {
    display: none;
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.mining--shown {
    display: flex;
}

.mining-ore {
    position: absolute;
    width: 108px;
    height: 45px;
    font-size: var(--text-label);
    -unity-text-align: middle-center;
}

/* Autopilot to an asteroid and mining: no crosshair. */
.hud-docking .crosshair {
    display: none;
}

/* ---- under the status bars: the remake's booster / cloak recharge (no speed / throttle / boost readout) ----------- */

.speed-panel {
    position: absolute;
    left: 40px;
    top: 112px;
    max-width: 320px;
}

/* Below the gamma row (supernova orbits: three status rows). */
.speed-panel--low {
    top: 160px;
}

/* Remake: the booster's, the cloak's and the time extender's recharge for keys / controllers (CooldownView): their shop icons (180 x 88),
   lit left to right as they recharge (see-through until ready), a short flash when ready. Touch shows them on its own buttons. */
.cooldowns {
    flex-direction: row;
    margin-top: var(--space-s);
}

.input-touch .cooldowns {
    display: none;
}

.cooldown {
    width: 90px;
    height: 44px;
    margin-right: var(--space-s);
    -unity-background-scale-mode: scale-to-fit;
    background-color: rgba(4, 10, 18, 0.55);
    border-left-width: 3px;
    border-left-color: var(--gof-amber);
    opacity: 1;
    transition-property: opacity, background-color;
    transition-duration: 0.2s;
}

.cooldown--waiting {
    border-left-color: var(--gof-text-dim);
}

.cooldown--running {
    border-left-color: rgb(110, 220, 255);
}

.cooldown--flash {
    background-color: rgba(255, 190, 90, 0.5);
}

/* Over the part not yet recharged (the right): the icon shows through faintly there. */
.cooldown-shade {
    position: absolute;
    top: 0;
    bottom: 0;
    right: 0;
    width: 0;
    background-color: rgba(4, 10, 18, 0.72);
}

/* ---- keyboard / controller hints -------------------------------------------------------- */

.hints {
    display: none;
    position: absolute;
    left: 40px;
    bottom: 34px;
    align-items: flex-start;
    /* Under the status bars, from the bottom up: at a large text size the hints wrap into a second column. */
    height: 64%;
    justify-content: flex-end;
    flex-wrap: wrap;
    align-content: flex-start;
}

.input-keyboard .hints,
.input-gamepad .hints {
    display: flex;
}

/* Modified: in flight each hint is its keys and its label on one line, on the box's dark background without its border,
   small: the label at the story step label's size (StoryStepLabel: UiLayout.Type(12) = --text-caption), the keys and
   controller buttons cut down to match (the --glyph-sm-* tokens, GoF2Common.uss: they grow with "Text size" like the
   caption; fixed px clipped the text at ui-text-200). */
.hints .hint {
    flex-direction: row;
    align-items: center;
    margin-top: 4px;
    padding: 2px 6px;
    border-width: 0;
}

.hints .hint-label {
    margin: 0 0 0 6px;
    font-size: var(--text-caption);
    letter-spacing: 1px;
    -unity-text-align: middle-left;
}

.hints .keycap {
    min-width: var(--glyph-sm-key);
    height: var(--glyph-sm-key);
    padding: 0 5px;
    margin: 0 1px;
    font-size: var(--text-caption);
    border-width: 1px;
    border-bottom-width: 2px;
    border-radius: 4px;
}

.hints .keycap--wide {
    min-width: 60px;
}

.hints .pad-face {
    width: var(--glyph-sm-key);
    height: var(--glyph-sm-key);
    margin: 0 1px;
    border-radius: var(--glyph-sm-key-r);
    font-size: var(--text-caption);
}

.hints .pad-stick {
    width: var(--glyph-sm-stick);
    height: var(--glyph-sm-stick);
    margin: 0 1px;
    border-radius: var(--glyph-sm-stick-r);
    border-width: 2px;
    font-size: var(--text-caption);
}

.hints .pad-trigger {
    min-width: 28px;
    height: var(--glyph-sm-key);
    padding: 0 5px;
    margin: 0 1px;
    border-top-left-radius: 9px;
    border-top-right-radius: 9px;
}

.hints .pad-bumper {
    min-width: 30px;
    height: var(--glyph-sm-bumper);
    padding: 0 5px;
    margin: 0 1px;
    border-radius: var(--glyph-sm-bumper-r);
}

.hints .pad-menu {
    height: var(--glyph-sm-bumper);
    padding: 0 5px;
    margin: 0 1px;
    border-radius: var(--glyph-sm-bumper-r);
}

/* The PC cursor mode: its buttons are the controls (the bottom left holds the autopilot pill and the boost). */
.input-keyboard.hud-cursor .hints {
    display: none;
}

/* Phones: a narrower secondary plate. */
.layout-phone .speed-panel {
    max-width: 240px;
}

/* ---- star map open (StarMap draws the whole screen) ------------------------------------ */

.hud-map .hud {
    display: none;
}

/* ---- the carrier's resupply window (CarrierShopWindow, the hangar shop's HangarWindow.uss): the flight HUD's markings
   out of its way, the key hints in one row under it like the station's ---------------------------------------------- */

.hud-shop .radar-ellipse,
.hud-shop .nav-markers,
.hud-shop .crosshair,
.hud-shop .lock-ring,
.hud-shop .dock-prompt,
.hud-shop .lock-plate,
.hud-shop .nav-buttons,
.hud-shop .speed-panel,
.hud-shop .orbit-info {
    display: none;
}

.hud-shop .hints {
    flex-direction: row;
    align-items: center;
    height: auto;   /* one row under the window, not the flight's column box */
    justify-content: flex-start;
}

.hud-shop .hints .hint {
    margin-right: var(--space-s);
}

/* ---- Khador Drive / cloak charge (Hud::draw 0x1933f6, #48): the frame 0x53a (GoF2Hud/charge_frame, 408 x 69), the
   striped fill 0x539 (charge_fill, 388 x 14: blue in the middle, yellow at the ends) revealed from the centre outward
   (jumpChargeFill clips, jumpChargeStripes holds the whole image still under it), the text in the frame's lower panel. */

.jump-charge {
    display: none;
    position: absolute;
    top: 76px;
    left: 50%;
    width: 408px;
    height: 69px;
    margin-left: -204px;
}

.jump-charge--shown {
    display: flex;
}

.jump-charge-fill {
    position: absolute;
    top: 10px;
    left: 204px;
    width: 0;
    height: 14px;
    overflow: hidden;
}

.jump-charge-stripes {
    position: absolute;
    top: 0;
    left: 0;
    width: 388px;
    height: 14px;
}

.jump-charge-label {
    position: absolute;
    top: 35px;
    left: 0;
    right: 0;
    -unity-text-align: middle-center;
    font-size: var(--text-small);
    letter-spacing: 3px;
    color: var(--gof-text);
    text-shadow: 0 1px 4px rgba(0, 0, 0, 0.9);
}

/* ---- orbit information on arrival (Hud::drawOrbitInformation: logo at (3, 3), lines at y 10 / 40 / 70) ---- */

.orbit-info {
    display: none;
    position: absolute;
    left: 3px;
    top: 3px;
    flex-direction: row;
    align-items: flex-start;
}

.orbit-info--shown {
    display: flex;
}

.hud-orbit-info .speed-panel {
    display: none;
}

.orbit-logo {
    margin-right: var(--space-m);
}

.orbit-text {
    padding-top: var(--space-s);
}

.orbit-line {
    height: 30px;
    font-size: var(--text-label);
    color: #FFFFFF;
    padding: 0;
    margin: 0;
    text-shadow: 0 1px 4px rgba(0, 0, 0, 0.9);
}

/* ---- player status (Hud::draw: icon 41x42 at x 38, bar 248x14 at x 79 on the 247x39 row plate; shield y 10, hull y 58) ---- */

.status-panel {
    position: absolute;
    left: 38px;
    top: 10px;
}

.status-row {
    flex-direction: row;
    height: 48px;
}

.status-icon {
    width: 41px;
    height: 42px;
}

.status-plate {
    width: 247px;
    height: 39px;
    margin-top: 1px;
    justify-content: center;
}

.status-bar {
    width: 248px;
    height: 14px;
}

.status-fill {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 0;
    -unity-background-scale-mode: stretch-to-fill;
}

.hud-orbit-info .status-panel {
    display: none;
}

/* ---- the radar ellipse (Radar::draw: image 0x4c7 four times mirrored around the centre; quarters made in FlightHud) ---- */

.radar-ellipse {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 0;
    height: 0;
    overflow: visible;
    opacity: 0.6;
}

.radar-quarter {
    position: absolute;
    -unity-background-scale-mode: stretch-to-fill;
}

.hud-mining .radar-ellipse {
    display: none;
}

/* ---- hit arcs on the radar ellipse (Hud::draw, 300 ms; sides at w/2 -+ 657, top / bottom at h/2 -+ 491) ---- */

.hit-arcs {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 0;
    height: 0;
    overflow: visible;
}

.hit-arc {
    display: none;
    position: absolute;
    -unity-background-scale-mode: stretch-to-fill;
}

.hit-arc--shown {
    display: flex;
}

.hud-cinematic .hit-arcs {
    display: none;
}

/* ---- game over (MGame game-over state) ---------------------------------------------------- */

.game-over {
    display: none;
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    justify-content: center;
    align-items: center;
    background-color: rgba(0, 0, 0, 0);
    transition-duration: 4s;
}

.game-over--shown {
    display: flex;
}

.game-over--dim {
    background-color: rgba(0, 0, 0, 0.7);
}

.game-over-title {
    font-size: var(--text-display);
    letter-spacing: 12px;
    color: #FFFFFF;
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.9);
}

.game-over-text {
    margin-top: 28px;
    max-width: 1100px;
    white-space: normal;
    -unity-text-align: middle-center;
    font-size: var(--text-subhead);
    color: var(--gof-text);
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.6s;
}

.game-over-text--shown {
    opacity: 1;
}

/* The story dialogue (UI/Dialogue) fills the screen. */
.dialogue-instance {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

/* Layout::drawFade / enableFillScreen: the cutscenes' full-screen fades (opacity set per frame). */
.screen-fade {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgb(0, 0, 0);
    opacity: 0;
}

.hud-cinematic .radio {
    top: 60px;
}

.hud-message--green {
    color: rgb(0, 237, 0);
}

.hud-message--red {
    color: rgb(255, 42, 0);
}

.combat-label {
    position: absolute;
    font-size: var(--text-body);
    color: #FFFFFF;
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.9);
}

/* Remake ("Distance on ship markers", CombatView.DrawDistance): an unlocked far ship's distance, small, centred under its
   marker (placed at x - 61), in the marker's colour (the dots' cores). */
.combat-label--far {
    width: 122px;
    font-size: var(--text-caption);
    -unity-text-align: upper-center;
}

/* Remake (multiplayer, CombatView.DrawPilotName): another player's name over their marker, in the marker's colour; the
   box's size is CombatView's PilotLabelWidth / PilotLabelHeight. */
.combat-label--pilot {
    width: 240px;
    height: 22px;
    font-size: var(--text-caption);
    -unity-text-align: lower-center;
    overflow: hidden;
    white-space: nowrap;
}

.combat-label--enemy {
    color: #FF4A2E;
}

.combat-label--friend {
    color: #3BE86A;
}

/* Options > Accessibility "Colour-blind markers": friends blue (CombatView.MarkerTex turns their images blue too). */
.ui-colorblind .combat-label--friend {
    color: #4FB2FF;
}

.combat-label--neutral {
    color: #F4D255;
}

/* The cloak entry while cloaked / charging / recharging (TouchButton+0xa7: half-transparent, no taps). */
.autopilot-menu-item--disabled {
    opacity: 0.4;
}

/* The time extender's clock while it isn't ready. */
.nav-button--dim {
    -unity-background-image-tint-color: rgb(140, 140, 140);
    opacity: 0.6;
}

/* ---- pause menu (MenuTouchWindow mode 1, PauseMenu) ------------------------------------------ */

/* The pause menu open: the flight's key hints give way to the menu's own prompts. */
.hud-paused .hints {
    display: none;
}

.pause-backdrop {
    display: none;
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0.55);
}

.pause-backdrop--shown {
    display: flex;
}

/* Opaque like the station's menu: the panel colour's 93 % let the HUD's markers read through it. */
.pause-panel {
    width: 620px;
    max-height: 86%;
    padding: 16px 20px 20px 20px;
    background-color: rgb(4, 10, 18);
    border-width: 1px;
    border-color: var(--gof-line);
    border-left-width: 3px;
    border-left-color: var(--gof-amber);
}

.pause-title {
    margin-bottom: var(--space-m);
}

.pause-body {
    flex-shrink: 1;
    min-height: 0;   /* scrolls inside the panel's 86 % instead of pushing past the screen */
}

.pause-scroll {
    flex-shrink: 0;   /* otherwise the panel squeezes it to one row */
    max-height: 560px;
    margin-bottom: var(--space-s);
}

.pause-text {
    font-size: var(--text-label);
    color: var(--gof-text);
    white-space: normal;
    margin: 4px 0 12px 0;
}

.pause-heading,
.pause-heading--red {
    font-size: var(--text-label);
    letter-spacing: 3px;
    color: var(--gof-amber);
    margin: 8px 0 4px 0;
    -unity-font-style: bold;
}

.pause-heading--red {
    color: rgb(255, 80, 60);
}

.pause-subheading {
    font-size: var(--text-body);
    color: #FFFFFF;
    white-space: normal;
}

.pause-cargo-row {
    flex-direction: row;
    align-items: center;
    padding: 4px 0;
    border-bottom-width: 1px;
    border-bottom-color: var(--gof-line);
}

.pause-cargo-icon {
    width: 90px;
    height: 44px;
    margin-right: var(--space-l);
    -unity-background-scale-mode: scale-to-fit;
}

.pause-cargo-name {
    flex-grow: 1;
    font-size: var(--text-label);
    color: var(--gof-text);
}

.pause-cargo-amount {
    font-size: var(--text-label);
    color: #FFFFFF;
}

.pause-option {
    margin: 4px 0;
    padding: 8px 16px;
    font-size: var(--text-label);
    border-left-width: 3px;
    border-left-color: rgba(0, 0, 0, 0);
}

/* The Debug page (PauseMenu.BuildDebug): a wide panel, tabs, a result line, two-column grids and side-by-side cards.
   It is a window like the Options page (OptionsView, docs/UI-DESIGN.md "Shapes"): the cyan left edge, the title in
   cyan with its amber accent (PauseMenu.accent), Back at the bottom left and the keys in the divided row under it; it
   had the short menus' white title, amber edge and a centred Back under the keys. */
.pause-panel--wide {
    width: 1180px;
    max-width: 96%;
    padding: 32px 40px;
    border-left-color: var(--gof-cyan);
}

.pause-panel--wide > .pause-title {
    margin-bottom: 0;
    font-size: var(--text-title);
    letter-spacing: 6px;
    color: var(--gof-cyan);
}

.pause-panel--wide .autopilot-menu-item.debug-back {
    align-self: flex-start;
    margin-top: var(--space-s);
    padding: 8px 16px;
    font-size: var(--text-body);
    -unity-text-align: middle-left;
}

/* Its rows scroll when the screen is short: as tall as the rows (PauseMenu.BuildDebug sets the height), shrunk to fit
   the panel's 86 % of the screen. */
.debug-scroll {
    flex-shrink: 1;
    min-height: 140px;
    margin-bottom: var(--space-s);
}

/* A small high-density screen (UiScale, the root's ui-large: a phone, the Retroid Pocket G2): bigger text and rows, the
   sizes of the station's menu (StationMenu.uss .ui-large .system-menu): a full-width list of short entries looked
   stretched, the Debug page covered the whole screen. */
.ui-large .pause-panel {
    width: 94%;
    max-width: 600px;
    max-height: 94%;
}

.ui-large .pause-panel--wide {
    max-width: 1400px;
    height: 80%;
    max-height: 80%;
}

.ui-large .pause-panel--wide .pause-body,
.ui-large .pause-panel--wide .debug-scroll {
    flex-grow: 1;   /* Back at the bottom, as on the station's Debug page */
}

.ui-large .pause-option,
.ui-large .pause-option Label,
.ui-large .pause-text,
.ui-large .pause-cargo-name,
.ui-large .pause-cargo-amount {
    font-size: var(--text-heading);
}

.ui-large .pause-option {
    padding: 12px 20px;
}

.debug-action.autopilot-menu-item--selected .option-button {
    background-color: var(--gof-amber);
    color: #0B1016;
}

.pause-option.autopilot-menu-item--selected {
    background-color: var(--gof-cyan-faint);
    border-left-color: var(--gof-amber);
}

.pause-option Label {
    font-size: var(--text-label);
    color: var(--gof-text);
    min-width: 250px;
}

.pause-option .choice-value,
.pause-option .option-description,
.pause-option .binding-header-cell {
    min-width: 0;
}

.pause-option .binding-header > .binding-label {
    min-width: 250px;   /* the rows' name Labels have it */
}

.pause-option .binding-header-cell {
    font-size: var(--text-caption);
    color: var(--gof-text-dim);
}

.pause-option .choice-value {
    font-size: var(--text-body);
    color: var(--gof-cyan);
}

.pause-option .option-description {
    font-size: var(--text-small);
    color: var(--gof-text-dim);
}

.pause-option.autopilot-menu-item--selected .choice-value {
    color: var(--gof-amber);
}

/* ---- lens flare (StarSystem::render2D, LensFlareView): under the HUD ---------------------- */

.lens-flare {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.lens-flare-glare {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.lens-flare-image {
    position: absolute;
    -unity-background-scale-mode: stretch-to-fill;
}

/* ---- the hacking game (HackingView) and the docking transfer counter --------------------------------- */

.hacking-layer {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 0;
    height: 0;
}

.hacking-abs {
    position: absolute;
    -unity-background-scale-mode: stretch-to-fill;
}

.transfer-counter {
    position: absolute;
    left: 0;
    right: 0;
    top: 62%;
    -unity-text-align: middle-center;
    font-size: var(--text-heading);
    letter-spacing: 2px;
    color: #FFFFFF;
    text-shadow: 0 0 6px rgba(0, 0, 0, 0.9);
}

.transfer-counter--hidden {
    display: none;
}

/* Action Freeze (PhotoMode): the HUD hidden; the overlay is Inspect ship's (OrbitViewUi, .orbit-view-* in GoF2Common.uss)
   with the remake logo in the footer (the original: the logo 0x534 at the top right and the footer with Back). */
/* MGame::OnRender2D in cinematic mode draws only the menu window and the lens flare: the hacking game and the object
   docking's transfer counter (on the root, outside #hud) go too. */
.hud-photo #hud,
.hud-photo .hacking-layer,
.hud-photo .transfer-counter {
    display: none;
}

.photo-overlay {
    display: none;
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.photo-overlay--shown {
    display: flex;
}

/* The original hides the footer while a finger turns the camera; the remake's whole overlay goes. */
.photo-overlay--turning .orbit-view-title,
.photo-overlay--turning .orbit-view-hints,
.photo-overlay--turning .orbit-view-footer {
    opacity: 0;
}

/* The remake logo at the footer's right end, Back at its left (OrbitViewUi). */
.photo-logo {
    width: 232px;
    height: 80px;
    margin-left: auto;
    background-image: url("project://database/Assets/UI/MainMenu/Images/logo_gof2_remake.png");
    -unity-background-scale-mode: scale-to-fit;
}

/* ---- top readout (Hud::draw, Hud+0x3d4 at the top right): the time limit or the cargo hold, the volatile bar, the
   mission's second line; plates cut by Build HUD Images (hud_*) --------------------------------------------------- */

/* The Supernova Challenge (ChallengeView, Hud::drawChallengeModeScore): the score at the top centre, the combo row under
   it; the lock plate and the HUD messages move under both. */
.challenge-hud {
    position: absolute;
    top: 4px;
    left: 0;
    right: 0;
    align-items: center;
}

.hud-fps .challenge-hud {
    top: 28px;
}

.challenge-score,
.challenge-combo,
.challenge-combo-count,
.challenge-bonus {
    flex-direction: row;
    align-items: center;
}

.challenge-combo {
    margin-top: 4px;
}

.challenge-combo-count {
    transform-origin: left;
}

.challenge-bonus {
    margin-left: 24px;
}

.hud-challenge .lock-plate {
    top: 90px;
}

.hud-challenge .hud-messages {
    top: 76px;
}

.hud-challenge .hud-messages--low {
    top: 140px;
}

.hud-fps.hud-challenge .lock-plate {
    top: 114px;
}

.hud-fps.hud-challenge .hud-messages {
    top: 100px;
}

.hud-fps.hud-challenge .hud-messages--low {
    top: 164px;
}

.hud-readout {
    position: absolute;
    right: 40px;
    top: 10px;
    align-items: flex-end;
}

/* Touch and the PC cursor mode: left of the pause button (0x4b8 at w - 121, 24). */
.input-touch .hud-readout,
.hud-cursor .hud-readout {
    right: 140px;
}

.hud-readout-plate {
    width: 191px;
    height: 40px;
    justify-content: center;
    -unity-background-scale-mode: stretch-to-fill;
}

.hud-readout-plate--second {
    margin-top: var(--space-xs);
}

.hud-readout-text {
    padding-left: var(--space-xl);
    padding-right: var(--space-m);
    font-size: var(--text-body);
    color: var(--gof-text);
    -unity-text-align: middle-left;
}

/* The red bar over the plate from its left edge, cut to the volatile force (DrawRegion2D width x force). */
.hud-readout-bar {
    position: absolute;
    left: 0;
    top: 0;
    height: 40px;
    overflow: hidden;
}

.hud-readout-bar-fill {
    width: 191px;
    height: 40px;
    -unity-background-scale-mode: stretch-to-fill;
}


/* The mouse steering point (PlayerEgo+0x94): a small dot at the screen centre + the mouse offset, not a second
   crosshair; hidden near the centre, where it would sit on the ship's crosshair. */
.mouse-reticle {
    display: none;
    position: absolute;
    width: 8px;
    height: 8px;
    margin-left: -4px;
    margin-top: -4px;
    border-radius: 4px;
    background-color: rgba(120, 220, 255, 0.6);
}

/* Remake, free flight (FlightStyles.Free): the mouse's virtual joystick reach, a faint circle round the centre. */
.mouse-stick {
    display: none;
    position: absolute;
    border-width: 1px;
    border-color: rgba(120, 220, 255, 0.18);
}

/* ---- remake: incoming missiles (MissileWarningView): the pulsing banner with the boost hint, a red diamond on each
   missile (off screen on the radar ellipse) -------------------------------------------------------------------------- */

.missile-warning {
    position: absolute;
    left: 0;
    right: 0;
    top: 21%;
    align-items: center;
}

.missile-warning--hidden {
    display: none;
}

.missile-warning-title {
    padding: 8px 24px;
    font-size: var(--text-title);
    letter-spacing: 5px;
    color: #FF4A2A;
    background-color: rgba(48, 4, 0, 0.6);
    border-width: 2px;
    border-color: #FF4A2A;
    border-radius: 4px;
    text-shadow: 0 0 8px rgba(255, 40, 0, 0.8);
}

.missile-warning-hint {
    flex-direction: row;
    align-items: center;
    margin-top: var(--space-s);
}

.missile-warning-hint-label {
    margin-left: var(--space-s);
    font-size: var(--text-small);
    letter-spacing: 3px;
    color: #FFD6CC;
    text-shadow: 0 1px 4px rgba(0, 0, 0, 0.9);
}

.missile-marker {
    position: absolute;
    width: 26px;
    height: 26px;
    border-width: 3px;
    border-color: #FF4A2A;
    background-color: rgba(255, 74, 42, 0.18);
    rotate: 45deg;
}

/* Remake (immersion): Options > Gameplay "Flight HUD" (Settings.HudMode, the Toggle HUD key). Visibility, not display:
   the markers' layers, the status panel and the readout set their display in code, which would beat a display rule.
   Kept always: menus, conversations, the radio, HUD messages, the mining and hacking games, the touch controls (and on
   touch the secondary plate / weapon strip of the gauge layer, which the touch player picks weapons with), game over.
   Minimal keeps the crosshair, the lock ring, the action prompt, the missile warning, the charge bar, the mouse reticle
   and the arrival's orbit information; Off hides those too. Last in the file: it beats .hud-launch .orbit-info. */
.hud-minimal .radar-ellipse,
.hud-minimal .nav-markers,
.hud-minimal .status-panel,
.hud-minimal .lock-plate,
.hud-minimal .hud-readout,
.hud-minimal .hints,
.hud-minimal .speed-panel,
.hud-minimal .hit-arcs,
.hud-minimal.input-keyboard .touch-gauge-layer,
.hud-minimal.input-gamepad .touch-gauge-layer,
.hud-off .radar-ellipse,
.hud-off .nav-markers,
.hud-off .status-panel,
.hud-off .lock-plate,
.hud-off .hud-readout,
.hud-off .hints,
.hud-off .speed-panel,
.hud-off .hit-arcs,
.hud-off.input-keyboard .touch-gauge-layer,
.hud-off.input-gamepad .touch-gauge-layer,
.hud-off .crosshair,
.hud-off .lock-ring,
.hud-off .dock-prompt,
.hud-off .missile-warning,
.hud-off .jump-charge,
.hud-off .mouse-reticle,
.hud-off .mouse-stick,
.hud-off .orbit-info {
    visibility: hidden;
}
