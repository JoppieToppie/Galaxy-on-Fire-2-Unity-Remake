<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:Style src="MainMenu.uss" />
    <ui:Style src="../GoF2InputGlyphs.uss" />
    <ui:VisualElement name="root" class="menu-root">
        <ui:VisualElement name="sideShade" class="side-shade" picking-mode="Ignore" />
        <ui:VisualElement name="bottomShade" class="bottom-shade" picking-mode="Ignore" />

        <ui:VisualElement name="safeArea" class="safe-area" picking-mode="Ignore">
        <ui:VisualElement name="menuScreen" class="menu-screen">
            <ui:VisualElement name="mainColumn" class="main-column">
                <ui:VisualElement name="mainButtons" class="main-buttons">
                    <ui:Button name="resumeButton" class="menu-button gof-semibold delay-1" />
                    <ui:Button name="newGameButton" class="menu-button gof-semibold delay-2" />
                    <ui:Button name="multiplayerButton" class="menu-button gof-semibold delay-3" />
                    <ui:Button name="loadButton" class="menu-button gof-semibold delay-4" />
                    <ui:Button name="optionsButton" class="menu-button gof-semibold delay-5" />
                    <ui:Button name="modsButton" class="menu-button gof-semibold delay-6" />
                    <ui:Button name="aboutButton" class="menu-button gof-semibold delay-7" />
                    <ui:Button name="debugButton" class="menu-button gof-semibold delay-8" />
                    <ui:Button name="exitButton" class="menu-button gof-semibold delay-9" />
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement name="panelHost" class="panel-host" picking-mode="Ignore">
                <ui:VisualElement name="campaignPanel" class="panel panel--wide">
                    <ui:Label name="campaignTitle" class="panel-title gof-semibold" />
                    <ui:VisualElement class="panel-accent" />
                    <ui:VisualElement class="card-row">
                        <ui:Button name="cardGof2" class="campaign-card">
                            <ui:VisualElement class="card-art card-gof2" picking-mode="Ignore" />
                            <ui:VisualElement class="card-art card-art-hover card-gof2-hover" picking-mode="Ignore" />
                        </ui:Button>
                        <ui:Button name="cardValkyrie" class="campaign-card">
                            <ui:VisualElement class="card-art card-valkyrie" picking-mode="Ignore" />
                            <ui:VisualElement class="card-art card-art-hover card-valkyrie-hover" picking-mode="Ignore" />
                        </ui:Button>
                        <ui:Button name="cardSupernova" class="campaign-card">
                            <ui:VisualElement class="card-art card-supernova" picking-mode="Ignore" />
                            <ui:VisualElement class="card-art card-art-hover card-supernova-hover" picking-mode="Ignore" />
                        </ui:Button>
                    </ui:VisualElement>
                    <ui:Button name="ngPlusToggle" class="choice-button choice-button--toggle">
                        <ui:Label name="ngPlusLabel" class="choice-title gof-semibold" picking-mode="Ignore" />
                        <ui:Label name="ngPlusDesc" class="choice-desc" picking-mode="Ignore" />
                    </ui:Button>
                    <ui:Button name="challengeButton" class="choice-button">
                        <ui:Label name="challengeLabel" class="choice-title gof-semibold" picking-mode="Ignore" />
                        <ui:Label name="challengeDesc" class="choice-desc" picking-mode="Ignore" />
                    </ui:Button>
                    <ui:Button name="campaignBack" class="menu-button back-button gof-semibold" />
                </ui:VisualElement>

                <ui:VisualElement name="difficultyPanel" class="panel">
                    <ui:Label name="difficultyTitle" class="panel-title gof-semibold" />
                    <ui:VisualElement class="panel-accent" />
                    <ui:Button name="easyButton" class="choice-button">
                        <ui:Label name="easyLabel" class="choice-title gof-semibold" picking-mode="Ignore" />
                        <ui:Label name="easyDesc" class="choice-desc" picking-mode="Ignore" />
                    </ui:Button>
                    <ui:Button name="normalButton" class="choice-button">
                        <ui:Label name="normalLabel" class="choice-title gof-semibold" picking-mode="Ignore" />
                        <ui:Label name="normalDesc" class="choice-desc" picking-mode="Ignore" />
                    </ui:Button>
                    <ui:Button name="hardButton" class="choice-button">
                        <ui:Label name="hardLabel" class="choice-title gof-semibold" picking-mode="Ignore" />
                        <ui:Label name="hardDesc" class="choice-desc" picking-mode="Ignore" />
                    </ui:Button>
                    <ui:Button name="extremeButton" class="choice-button choice-button--danger">
                        <ui:Label name="extremeLabel" class="choice-title gof-semibold" picking-mode="Ignore" />
                        <ui:Label name="extremeDesc" class="choice-desc" picking-mode="Ignore" />
                    </ui:Button>
                    <ui:Button name="difficultyBack" class="menu-button back-button gof-semibold" />
                </ui:VisualElement>

                <ui:VisualElement name="economyPanel" class="panel">
                    <ui:Label name="economyTitle" class="panel-title gof-semibold" />
                    <ui:VisualElement class="panel-accent" />
                    <ui:Button name="economyDefaultButton" class="choice-button">
                        <ui:Label name="economyDefaultLabel" class="choice-title gof-semibold" picking-mode="Ignore" />
                        <ui:Label name="economyDefaultDesc" class="choice-desc" picking-mode="Ignore" />
                    </ui:Button>
                    <ui:Button name="economyAndroidButton" class="choice-button">
                        <ui:Label name="economyAndroidLabel" class="choice-title gof-semibold" picking-mode="Ignore" />
                        <ui:Label name="economyAndroidDesc" class="choice-desc" picking-mode="Ignore" />
                    </ui:Button>
                    <ui:Button name="economyBack" class="menu-button back-button gof-semibold" />
                </ui:VisualElement>

                <ui:VisualElement name="gameOptionsPanel" class="panel">
                    <ui:Label name="gameOptionsTitle" class="panel-title gof-semibold" />
                    <ui:VisualElement class="panel-accent" />
                    <ui:Button name="kaamoToggle" class="choice-button choice-button--toggle">
                        <ui:Label name="kaamoLabel" class="choice-title gof-semibold" picking-mode="Ignore" />
                        <ui:Label name="kaamoDesc" class="choice-desc" picking-mode="Ignore" />
                    </ui:Button>
                    <ui:Button name="hardcoreToggle" class="choice-button choice-button--toggle">
                        <ui:Label name="hardcoreLabel" class="choice-title gof-semibold" picking-mode="Ignore" />
                        <ui:Label name="hardcoreDesc" class="choice-desc" picking-mode="Ignore" />
                    </ui:Button>
                    <ui:Button name="tutorialToggle" class="choice-button choice-button--toggle">
                        <ui:Label name="tutorialLabel" class="choice-title gof-semibold" picking-mode="Ignore" />
                        <ui:Label name="tutorialDesc" class="choice-desc" picking-mode="Ignore" />
                    </ui:Button>
                    <ui:Button name="capitalToggle" class="choice-button choice-button--toggle">
                        <ui:Label name="capitalLabel" class="choice-title gof-semibold" picking-mode="Ignore" />
                        <ui:Label name="capitalDesc" class="choice-desc" picking-mode="Ignore" />
                    </ui:Button>
                    <ui:Button name="gameOptionsStart" class="choice-button choice-button--start">
                        <ui:Label name="gameOptionsStartLabel" class="choice-title gof-semibold" picking-mode="Ignore" />
                        <ui:Label name="gameOptionsStartDesc" class="choice-desc" picking-mode="Ignore" />
                    </ui:Button>
                    <ui:Button name="gameOptionsBack" class="menu-button back-button gof-semibold" />
                </ui:VisualElement>

                <ui:VisualElement name="loadPanel" class="panel">
                    <ui:Label name="loadTitle" class="panel-title gof-semibold" />
                    <ui:VisualElement class="panel-accent" />
                    <ui:ScrollView name="slotList" class="slot-list" />
                    <!-- Remake: Import / Export saves (SaveTransfer); the exports on the right in both rows; the delete hint (SaveSlotRow.AttachHint) goes above. -->
                    <ui:VisualElement name="saveTransferRow" class="mods-actions save-transfer-row">
                        <ui:Button name="importSavesButton" class="mods-action gof-semibold" />
                        <ui:Button name="exportSavesButton" class="mods-action gof-semibold" />
                    </ui:VisualElement>
                    <!-- Remake: the original game's saves in and out (OriginalSaveTransfer). -->
                    <ui:VisualElement name="originalSaveRow" class="mods-actions save-transfer-row">
                        <ui:Button name="importOriginalButton" class="mods-action gof-semibold" />
                        <ui:Button name="exportOriginalButton" class="mods-action gof-semibold" />
                    </ui:VisualElement>
                    <ui:Label name="saveTransferNote" class="save-transfer-note" />
                    <ui:Button name="loadBack" class="menu-button back-button gof-semibold" />
                </ui:VisualElement>

                <ui:VisualElement name="optionsPanel" class="panel">
                    <ui:Label name="optionsTitle" class="panel-title gof-semibold" />
                    <ui:VisualElement class="panel-accent" />
                    <ui:VisualElement class="tab-row">
                        <ui:Button name="tabSound" class="tab-button gof-semibold" />
                        <ui:Button name="tabGraphics" class="tab-button gof-semibold" />
                        <ui:Button name="tabControls" class="tab-button gof-semibold" />
                        <ui:Button name="tabBindings" class="tab-button gof-semibold" />
                        <ui:Button name="tabGameplay" class="tab-button gof-semibold" />
                        <ui:Button name="tabAccessibility" class="tab-button gof-semibold" />
                        <ui:Button name="tabLanguage" class="tab-button gof-semibold" />
                    </ui:VisualElement>
                    <!-- Option rows are built from OptionsCatalog (MainMenu.SetupOptions). -->
                    <ui:ScrollView name="soundPage" class="tab-page options-scroll" />
                    <ui:ScrollView name="graphicsPage" class="tab-page options-scroll" />
                    <ui:ScrollView name="controlsPage" class="tab-page options-scroll" />
                    <ui:ScrollView name="bindingsPage" class="tab-page options-scroll" />
                    <ui:ScrollView name="gameplayPage" class="tab-page options-scroll" />
                    <ui:ScrollView name="accessibilityPage" class="tab-page options-scroll" />
                    <ui:ScrollView name="languagePage" class="tab-page options-scroll">
                        <ui:VisualElement name="languageList" class="language-list" />
                    </ui:ScrollView>
                    <ui:VisualElement class="options-footer">
                        <ui:Button name="optionsBack" class="menu-button back-button gof-semibold" />
                        <ui:Button name="optionsDefaults" class="menu-button back-button options-defaults gof-semibold" />
                    </ui:VisualElement>
                </ui:VisualElement>

                <ui:VisualElement name="aboutPanel" class="panel">
                    <ui:Label name="aboutTitle" class="panel-title gof-semibold" />
                    <ui:VisualElement class="panel-accent" />
                    <ui:ScrollView name="aboutScroll" class="about-scroll">
                        <ui:Label name="aboutText" class="about-text" />
                    </ui:ScrollView>
                    <ui:Button name="aboutBack" class="menu-button back-button gof-semibold" />
                </ui:VisualElement>
                <ui:VisualElement name="multiplayerPanel" class="panel panel--wide mp-panel">
                    <ui:VisualElement class="mp-title-row">
                        <ui:Label name="multiplayerTitle" class="panel-title gof-semibold" />
                        <ui:Label name="mpBadge" class="mp-badge gof-semibold" />
                        <ui:VisualElement class="mp-title-spacer" />
                        <ui:Label name="mpNameLabel" class="mp-label mp-name-label gof-semibold" />
                        <ui:TextField name="mpName" class="debug-filter mp-name" />
                    </ui:VisualElement>
                    <ui:VisualElement class="panel-accent" />
                    <ui:Label name="mpIntro" class="mp-intro" />
                    <ui:VisualElement class="mp-body">
                        <ui:VisualElement class="mp-card mp-browser">
                            <ui:VisualElement class="mp-card-head">
                                <ui:Label name="mpJoinTitle" class="mp-card-title gof-semibold" />
                                <ui:Label name="mpServerCount" class="mp-server-count" />
                            </ui:VisualElement>
                            <ui:ScrollView name="mpServerList" class="mp-server-list" />
                            <ui:Label name="mpJoinText" class="mp-label mp-join-label gof-semibold" />
                            <ui:VisualElement class="mp-join-row">
                                <ui:TextField name="mpAddress" class="debug-filter mp-address" />
                                <ui:TextField name="mpJoinPassword" class="debug-filter mp-join-password" />
                                <ui:Button name="mpJoin" class="mp-action mp-join-button gof-semibold" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement class="mp-card mp-card--last mp-host">
                            <ui:Label name="mpHostTitle" class="mp-card-title gof-semibold" />
                            <ui:VisualElement name="mpModeRow" class="choice-segments mp-mode-row">
                                <ui:Button name="mpModePublic" class="choice-segment gof-semibold" />
                                <ui:Button name="mpModePrivate" class="choice-segment gof-semibold" />
                                <ui:Button name="mpModeLocal" class="choice-segment gof-semibold" />
                            </ui:VisualElement>
                            <ui:ScrollView name="mpHostScroll" class="mp-host-scroll">
                            <ui:Label name="mpHostText" class="mp-card-text" />
                            <ui:VisualElement name="mpHostFill" class="mp-card-fill">
                                <ui:VisualElement name="mpLocalBox">
                                    <ui:VisualElement name="mpAddressList" class="mp-address-list" />
                                    <ui:VisualElement class="mp-port-row">
                                        <ui:Label name="mpPortLabel" class="mp-label mp-port-label gof-semibold" />
                                        <ui:TextField name="mpPort" class="debug-filter mp-port" />
                                    </ui:VisualElement>
                                </ui:VisualElement>
                            </ui:VisualElement>
                            <ui:TextField name="mpSessionName" class="debug-filter mp-password" />
                            <ui:VisualElement class="mp-host-row">
                                <ui:TextField name="mpHostPassword" class="debug-filter mp-password mp-host-password" />
                                <ui:Label name="mpMaxPlayersLabel" class="mp-label mp-max-label gof-semibold" />
                                <ui:TextField name="mpMaxPlayers" class="debug-filter mp-max-players" />
                            </ui:VisualElement>
                            <ui:VisualElement class="mp-switch-grid">
                            <ui:VisualElement class="mp-debug-row">
                                <ui:Label name="mpDebugLabel" class="mp-label mp-debug-label gof-semibold" />
                                <ui:VisualElement class="choice-segments mp-debug-segments">
                                    <ui:Button name="mpDebugOff" class="choice-segment gof-semibold" />
                                    <ui:Button name="mpDebugOn" class="choice-segment choice-segment--last gof-semibold" />
                                </ui:VisualElement>
                            </ui:VisualElement>
                            <ui:VisualElement class="mp-debug-row">
                                <ui:Label name="mpPvpLabel" class="mp-label mp-debug-label gof-semibold" />
                                <ui:VisualElement class="choice-segments mp-debug-segments">
                                    <ui:Button name="mpPvpOff" class="choice-segment gof-semibold" />
                                    <ui:Button name="mpPvpOn" class="choice-segment choice-segment--last gof-semibold" />
                                </ui:VisualElement>
                            </ui:VisualElement>
                            <ui:VisualElement class="mp-debug-row">
                                <ui:Label name="mpWorldLabel" class="mp-label mp-debug-label gof-semibold" />
                                <ui:VisualElement class="choice-segments mp-debug-segments">
                                    <ui:Button name="mpWorldFresh" class="choice-segment gof-semibold" />
                                    <ui:Button name="mpWorldPersistent" class="choice-segment gof-semibold" />
                                    <ui:Button name="mpWorldCoop" class="choice-segment choice-segment--last gof-semibold" />
                                </ui:VisualElement>
                            </ui:VisualElement>
                            <ui:VisualElement name="mpCoopStrengthRow" class="mp-debug-row">
                                <ui:Label name="mpCoopStrengthLabel" class="mp-label mp-debug-label gof-semibold" />
                                <ui:VisualElement class="choice-segments mp-debug-segments">
                                    <ui:Button name="mpCoopStrength0" class="choice-segment gof-semibold" />
                                    <ui:Button name="mpCoopStrength25" class="choice-segment gof-semibold" />
                                    <ui:Button name="mpCoopStrength50" class="choice-segment gof-semibold" />
                                    <ui:Button name="mpCoopStrength100" class="choice-segment choice-segment--last gof-semibold" />
                                </ui:VisualElement>
                            </ui:VisualElement>
                            <ui:VisualElement name="mpCoopRewardsRow" class="mp-debug-row">
                                <ui:Label name="mpCoopRewardsLabel" class="mp-label mp-debug-label gof-semibold" />
                                <ui:VisualElement class="choice-segments mp-debug-segments">
                                    <ui:Button name="mpCoopRewardsShared" class="choice-segment gof-semibold" />
                                    <ui:Button name="mpCoopRewardsFull" class="choice-segment choice-segment--last gof-semibold" />
                                </ui:VisualElement>
                            </ui:VisualElement>
                            <ui:VisualElement class="mp-debug-row">
                                <ui:Label name="mpModsLabel" class="mp-label mp-debug-label gof-semibold" />
                                <ui:VisualElement class="choice-segments mp-debug-segments">
                                    <ui:Button name="mpModsOff" class="choice-segment gof-semibold" />
                                    <ui:Button name="mpModsOn" class="choice-segment choice-segment--last gof-semibold" />
                                </ui:VisualElement>
                            </ui:VisualElement>
                            </ui:VisualElement>
                            </ui:ScrollView>
                            <ui:Label name="mpHostMore" class="mp-host-more gof-semibold" />
                            <ui:Button name="mpHost" class="mp-action mp-host-button gof-semibold" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:Label name="mpStatus" class="mp-status" />
                    <ui:Button name="multiplayerBack" class="menu-button back-button gof-semibold" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="logo" class="logo logo--instant" picking-mode="Ignore" />
        <ui:Label name="pressAnyKey" class="press-any-key gof-semibold" picking-mode="Ignore" />

        <ui:VisualElement name="footer" class="footer" picking-mode="Ignore">
            <ui:Label name="versionLabel" class="footer-text" />
            <ui:Label name="hintLabel" class="footer-text footer-hint" />
        </ui:VisualElement>

        <ui:VisualElement name="updateRow" class="update-row" picking-mode="Ignore">
            <ui:Button name="updateButton" class="update-button gof-semibold" />
        </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="dialog" class="dialog-backdrop">
            <ui:VisualElement class="dialog">
                <ui:Label name="dialogTitle" class="panel-title gof-semibold" />
                <ui:VisualElement class="panel-accent" />
                <ui:Label name="dialogText" class="dialog-text" />
                <ui:TextField name="dialogField" class="debug-filter dialog-field" />
                <ui:VisualElement class="dialog-buttons">
                    <ui:Button name="dialogYes" class="menu-button dialog-button gof-semibold" />
                    <ui:Button name="dialogAlt" class="menu-button dialog-button gof-semibold" style="display: none;" />
                    <ui:Button name="dialogNo" class="menu-button dialog-button gof-semibold" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="splash" class="splash">
            <ui:VisualElement name="splashLogo" class="splash-logo" picking-mode="Ignore" />
        </ui:VisualElement>
        <ui:VisualElement name="fade" class="fade" picking-mode="Ignore" />
    </ui:VisualElement>
</ui:UXML>
