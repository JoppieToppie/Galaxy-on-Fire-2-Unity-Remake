/* Main menu. Landscape only. Layout in panel units of the 1920 x 1080 design, scaled by UiLayout (docs/UI-DESIGN.md),
   so its width varies with the aspect ratio. UiLayout adds layout-narrow (4:3, 16:10), layout-phone and the others to
   the root; on ultrawide screens the UI stays inside the interface width (a centred 21:9 band by default). */

.menu-root {
    flex-grow: 1;
    align-items: center;
}

/* The ultrawide band (Options > Graphics "Interface width") comes from the safe area's insets (UiLayout.OptionInsets),
   which work at any interface size; a fixed max-width here didn't. */
.safe-area {
    flex-grow: 1;
    width: 100%;
}

/* ---- background shading over the 3D scene ------------------------------------------ */

.side-shade {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 62%;
    background-image: url("project://database/Assets/UI/MainMenu/Images/shade_left.png");
    -unity-background-scale-mode: stretch-to-fill;
    opacity: 0;
    transition-duration: 1.2s;
}

.bottom-shade {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 22%;
    background-image: url("project://database/Assets/UI/MainMenu/Images/shade_bottom.png");
    -unity-background-scale-mode: stretch-to-fill;
}

.menu-root--menu .side-shade {
    opacity: 1;
}

/* Hover styles only apply while the root has can-hover (mouse in use). With touch MainMenu removes it,
   so a finger sliding over the UI doesn't light up everything it passes. */

/* ---- logo: top-left in the menu; MainMenu moves it to the centre for the title screen with
   translate + scale (transform-only, so the transition to the menu costs no layout per frame) ---- */

.logo {
    position: absolute;
    left: 3%;
    top: 6%;
    width: 26%;
    height: 16%;
    background-image: url("project://database/Assets/UI/MainMenu/Images/logo_gof2_remake.png");
    -unity-background-scale-mode: scale-to-fit;
    background-position-x: left;
    opacity: 0;
    transition-duration: 0.9s;
    transition-timing-function: ease-in-out-cubic;
}

.logo--instant {
    transition-duration: 0s;
}

.logo--title-visible {
    opacity: 1;
    transition-duration: 3.9s;
}

.logo--menu {
    opacity: 1;
}

.press-any-key {
    position: absolute;
    left: 0;
    right: 0;
    top: 62%;
    -unity-text-align: middle-center;
    font-size: var(--text-subhead);
    letter-spacing: 6px;
    color: var(--gof-text);
    opacity: 0;
    transition-duration: 1s;
    transition-timing-function: ease-in-out-sine;
}

.press-any-key--on {
    opacity: 1;
}

.press-any-key--hidden {
    display: none;
}

/* ---- main column -------------------------------------------------------------------- */

.menu-screen {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    flex-direction: row;
    display: none;
}

.menu-root--menu .menu-screen {
    display: flex;
}

.main-column {
    width: 30%;
    padding-left: 3%;
    padding-top: 13%;
    justify-content: center;
}

.main-buttons {
    margin-top: 48px;
}

/* Every row shown (Resume with a save and Debug with the debug tools on: eight rows): centred like the shorter list,
   Exit ended up over the version text at the bottom left (and its tap zone, .footer-version) and couldn't be pressed.
   The column starts higher and keeps the bottom 110 units free, the logo still clear above it. */
.main-column--full {
    padding-top: 10%;
    padding-bottom: 110px;
}

.main-column--full .main-buttons {
    margin-top: var(--space-l);
}

/* the menu root prefix keeps the pressed state above the (can-hover) hover state */
.menu-root .menu-button:active {
    background-color: var(--gof-amber-soft);
}

/* Modified: the Load list's saves animate like the menu buttons above (GoF2Common .menu-button): the label slides in on
   hover / focus, the row turns amber while pressed, and a save chosen to load keeps that amber for a moment
   (slot-row--chosen, MainMenu.BuildSlots) before the game loads. */
.slot-list .slot-row {
    transition-duration: 0.18s;
    transition-timing-function: ease-out-cubic;
}

.can-hover .slot-list .slot-row:hover,
.slot-list .slot-row:focus {
    padding-left: 28px;
}

.menu-root .slot-list .slot-row:active,
.menu-root .slot-list .slot-row.slot-row--chosen {
    background-color: var(--gof-amber-soft);
}

.menu-button--hidden {
    opacity: 0;
    translate: -40px 0;
}

.menu-button--gone {
    display: none;
}

.main-buttons--revealing > .delay-1 { transition-delay: 0.05s; }
.main-buttons--revealing > .delay-2 { transition-delay: 0.1s; }
.main-buttons--revealing > .delay-3 { transition-delay: 0.15s; }
.main-buttons--revealing > .delay-4 { transition-delay: 0.2s; }
.main-buttons--revealing > .delay-5 { transition-delay: 0.25s; }
.main-buttons--revealing > .delay-6 { transition-delay: 0.3s; }
.main-buttons--revealing > .delay-7 { transition-delay: 0.35s; }
.main-buttons--revealing > .delay-8 { transition-delay: 0.4s; }
.main-buttons--revealing > .delay-9 { transition-delay: 0.45s; }
.main-buttons--revealing > .delay-10 { transition-delay: 0.5s; }

.main-column--dimmed .menu-button {
    opacity: 0.35;
}

/* A compact screen (UiLayout layout-compact: a 1:1 / 4:3 screen, a 16:9 phone, a TV, a large interface size): an open
   panel takes the column's place, so its tabs and rows keep their width instead of wrapping beside a dimmed list. */
.layout-compact.menu-root--panel .main-column,
.layout-compact.menu-root--panel .logo {
    display: none;
}

/* With a panel open the footer is the prompt row's: the version text gives way, and the panels end above the footer. */
.menu-root--panel .footer-version {
    display: none;
}

.menu-root--panel .panel-host {
    padding-bottom: 64px;
}

/* Larger text (Options > Accessibility): the prompt row may take two lines, the menu's entries need their whole width. */
.ui-text-150.menu-root--panel .panel-host,
.ui-text-175.menu-root--panel .panel-host,
.ui-text-200.menu-root--panel .panel-host {
    padding-bottom: 150px;
}

.ui-text-130 .main-column,
.ui-text-150 .main-column,
.ui-text-175 .main-column,
.ui-text-200 .main-column {
    width: auto;
    min-width: 30%;
    flex-shrink: 0;
}

.footer > .prompt-bar {
    flex-wrap: wrap;   /* a second line only when the line doesn't fit (a large text size) */
    flex-shrink: 0;    /* its own width first: shrinking, it wrapped on a TV with room to spare */
    max-width: 100%;
    margin-left: auto;
}

/* ---- panels ------------------------------------------------------------------------- */

/* The host takes the width the menu column leaves (its own width is set): sized by its content, a wide panel (the Debug
   panel's wrapping note counts its whole sentence on one line) squeezed the column and pushed the panel under the logo. */
.panel-host {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 0;
    justify-content: center;
    align-items: flex-start;
    padding-left: 2%;
    padding-right: 6%;
    padding-top: 0;   /* Modified: the panels centred top to bottom (6 % from the top pushed them low) */
}

.panel {
    display: none;
    width: 100%;
    max-width: 820px;
    max-height: 80%;
    padding: 36px 44px;
    background-color: var(--gof-panel);
    border-width: 1px;
    border-color: var(--gof-line);
    border-left-width: 3px;
    border-left-color: var(--gof-cyan);
    border-radius: 2px;
    opacity: 0;
    translate: 40px 0;
    transition-duration: 0.28s;
    transition-timing-function: ease-out-cubic;
}

/* Options: wider than the other panels, so its six tabs fit on one line. */
#optionsPanel {
    max-width: 1240px;
}

.panel--wide {
    max-width: 1020px;
}

.panel--shown {
    display: flex;
}

.panel--visible {
    opacity: 1;
    translate: 0 0;
}

/* ---- debug panel (remake-only testing tools, F10 / five taps on the version text) ------- */

/* Sized to the screen (88 % of its height), the mission list and the cheats filling it and scrolling (fixed pixel heights
   overflowed short screens and wasted tall ones). */
.debug-panel {
    max-width: 1500px;
    height: 82%;
    max-height: 82%;
    margin-bottom: 70px;   /* clear of the footer's key hints at the bottom right (they ran over its edge) */
}

/* The columns stretch to the panel's height, so the lists fill it. GoF2Common.uss's .debug-columns (the in-game Debug
   pages' cards) sets align-items: flex-start, which shrank them to their first row once it won over this sheet (Unity
   7000.0.0a10): the panel-scoped selector outranks it whichever sheet comes first. */
.debug-panel .debug-columns {
    flex-direction: row;
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    align-items: stretch;
}

.debug-column--missions {
    width: 55%;
    flex-shrink: 0;
    margin-right: 3%;
}

/* Wide enough for the longest cheat ("No secondary weapon cooldown" ran into its checkbox at 37 %). */
.debug-column--cheats {
    width: 42%;
    flex-grow: 0;
    flex-shrink: 0;
}

/* The toggles scroll between the heading and the note. */
.debug-cheat-list {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
}

.debug-column--cheats .option-item {
    flex-grow: 0;
    flex-shrink: 0;
}

/* Modified: wrapped to a second line when long (the Portuguese "Arma secundária sem tempo de recarga" ran over its checkbox
   on one line). */
.debug-column--cheats .unity-base-field__label {
    white-space: normal;
    flex-shrink: 1;
}

.debug-heading {
    margin-bottom: var(--space-s);
    font-size: var(--text-body);
    letter-spacing: 4px;
    color: var(--gof-cyan);
}

.debug-filter {
    margin: 0 0 8px 0;
}

.debug-filter .unity-base-text-field__input {
    padding: 8px 16px;
    font-size: var(--text-body);
    color: var(--gof-text);
    background-color: rgba(0, 0, 0, 0.35);
    border-width: 1px;
    border-color: rgba(216, 236, 247, 0.2);
    border-radius: 2px;
}

.debug-filter:focus .unity-base-text-field__input {
    border-color: var(--gof-amber);
}

.debug-mission-list {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 120px;
}

.debug-mission-section {
    margin: 12px 0 4px 0;
    font-size: var(--text-small);
    letter-spacing: 3px;
    color: var(--gof-amber);
}

.debug-mission {
    flex-direction: column;
    align-items: stretch;
    margin: 0;
    padding: 8px 16px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-left-width: 3px;
    border-left-color: rgba(0, 0, 0, 0);
    border-radius: 0;
    -unity-text-align: middle-left;
}

.debug-mission:focus,
.can-hover .debug-mission:hover {
    background-color: rgba(58, 170, 220, 0.14);
    border-left-color: var(--gof-amber);
}

.debug-mission-top {
    flex-direction: row;
    align-items: center;
}

.debug-mission-index {
    min-width: 54px;
    font-size: var(--text-body);
    color: var(--gof-amber);
}

.debug-mission-title {
    flex-shrink: 1;
    font-size: var(--text-body);
    color: var(--gof-text);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.debug-mission-station {
    margin-left: auto;
    padding-left: var(--space-m);
    flex-shrink: 0;
    white-space: nowrap;
    font-size: var(--text-caption);
    color: var(--gof-text-dim);
}

.debug-mission-summary {
    margin-left: 54px;
    font-size: var(--text-small);
    color: var(--gof-text-dim);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.debug-option .unity-base-field__label {
    min-width: 290px;
}

/* ---- mod browser (remake, ModBrowser) ------------------------------------------------- */

.mods-panel {
    max-width: 1320px;
    height: 84%;
    max-height: 84%;
}

.mods-title-row {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
}

.mods-count {
    font-size: var(--text-caption);
    color: var(--gof-text-dim);
}

.mods-body {
    flex-direction: row;
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
}

.mods-left {
    width: 42%;
    flex-shrink: 0;
    margin-right: 3%;
}

.mods-list {
    flex-grow: 1;
    background-color: rgba(0, 0, 0, 0.18);
}

.mods-empty {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    padding: var(--space-xl);
    font-size: var(--text-small);
    color: var(--gof-text-dim);
    white-space: normal;
}

.mods-row {
    flex-direction: row;
    align-items: center;
    margin: 0;
    padding: 8px 12px 8px 8px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-left-width: 3px;
    border-left-color: rgba(0, 0, 0, 0);
    border-radius: 0;
}

.mods-row--selected {
    background-color: var(--gof-cyan-faint);
    border-left-color: var(--gof-cyan);
}

.mods-row:focus,
.can-hover .mods-row:hover {
    background-color: rgba(58, 170, 220, 0.18);
    border-left-color: var(--gof-amber);
}

.mods-thumb {
    width: 112px;
    height: 63px;
    flex-shrink: 0;
    margin-right: var(--space-l);
    background-color: rgba(0, 0, 0, 0.45);
    border-width: 1px;
    border-color: var(--gof-line);
    -unity-background-scale-mode: scale-and-crop;
}

.mods-row--off .mods-thumb {
    -unity-background-image-tint-color: rgba(255, 255, 255, 0.55);
}

.mods-row-text {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
}

.mods-row-name {
    font-size: var(--text-body);
    color: var(--gof-text);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.mods-row--off .mods-row-name {
    color: var(--gof-text-dim);
}

.mods-row-sub {
    margin-top: 2px;
    font-size: var(--text-small);
    color: var(--gof-text-dim);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.mods-badge {
    flex-shrink: 0;
    margin-left: var(--space-s);
    padding: 3px 8px;
    font-size: var(--text-caption);
    letter-spacing: 2px;
    color: var(--gof-text-dim);
    border-width: 1px;
    border-color: rgba(216, 236, 247, 0.25);
    border-radius: 2px;
}

.mods-badge--on {
    color: #04121c;
    background-color: var(--gof-cyan);
    border-color: var(--gof-cyan);
}

.mods-badge--error {
    color: #ffffff;
    background-color: rgba(200, 50, 40, 0.85);
    border-color: rgb(230, 80, 60);
}

.mods-detail {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
}

.mods-preview {
    height: 300px;
    flex-shrink: 1;
    min-height: 120px;
    background-color: rgba(0, 0, 0, 0.45);
    border-width: 1px;
    border-color: var(--gof-line);
    -unity-background-scale-mode: scale-and-crop;
}

.mods-preview--none {
    background-color: rgba(62, 200, 255, 0.06);
}

.mods-name {
    flex-shrink: 0;
    margin-top: var(--space-l);
    font-size: var(--text-title);
    color: var(--gof-text);
    white-space: normal;
}

.mods-meta {
    flex-shrink: 0;
    margin-top: 2px;
    font-size: var(--text-caption);
    color: var(--gof-text-dim);
    white-space: normal;
}

.mods-desc-scroll {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 40px;
    margin-top: var(--space-m);
}

.mods-desc {
    font-size: var(--text-small);
    color: var(--gof-text);
    white-space: normal;
}

.mods-problems {
    margin-top: var(--space-s);
    font-size: var(--text-caption);
    color: rgb(255, 170, 120);
    white-space: normal;
}

.mods-actions {
    flex-direction: row;
    flex-wrap: wrap;   /* Modified: longer translations go on to a second row instead of breaking the words */
    flex-shrink: 0;
    margin-top: var(--space-l);
}

/* Modified: a button's text never breaks mid-word (Portuguese's "Antes" came out AN / TE / S) */
.mods-actions > .mods-action {
    white-space: nowrap;
    flex-shrink: 0;
    margin-bottom: 8px;
}

/* Modified: "Edit in Mod Builder" may break over two lines, so the row stays one row */
.mods-actions > .mods-edit {
    white-space: normal;
    max-width: 180px;
}

/* Modified: ends the action row, so Delete starts the next one under Turn on / off */
.mods-row-break {
    width: 100%;
    height: 0;
}

.mods-actions > .mods-delete {
    min-width: 140px;   /* as .mods-toggle */
}

.mods-action {
    margin: 0 8px 0 0;
    padding: 8px 16px;
    font-size: var(--text-small);
    letter-spacing: 3px;
    -unity-text-align: middle-center;
    color: var(--gof-text);
    background-color: var(--button-fill);
    border-width: var(--button-border-compact);
    border-color: var(--button-line);
    border-radius: var(--button-radius);
    transition-duration: 0.18s;
}

.can-hover .mods-action:hover,
.mods-action:focus {
    color: #FFFFFF;
    border-color: var(--button-focus-line);
    background-color: var(--button-focus-fill);
}

.mods-action:disabled {
    opacity: 0.35;
}

/* Load game: Export / Import saves under the slot list (MainMenu, SaveTransfer) */
.save-transfer-row {
    justify-content: center;
}

.save-transfer-row > .mods-action {
    margin: 0 4px;
}

.save-transfer-note {
    flex-shrink: 0;
    margin-top: var(--space-s);
    font-size: var(--text-small);
    letter-spacing: 1px;
    white-space: normal;
    color: var(--gof-text-dim);
    -unity-text-align: middle-center;
}

.mods-toggle {
    min-width: 140px;   /* Modified: 190 made it wider than the other buttons and pushed them on to a second row */
    color: #04121c;
    background-color: var(--gof-cyan);
    border-color: var(--gof-cyan);
}

.mods-toggle--on {
    color: var(--gof-text);
    background-color: rgba(200, 50, 40, 0.35);
    border-color: rgba(230, 80, 60, 0.8);
}

.can-hover .mods-toggle:hover,
.mods-toggle:focus {
    color: #04121c;
    background-color: var(--gof-amber);
}

.input-gamepad .mods-toggle {
    padding-left: 44px;
    padding-right: 44px;
}

/* Delete (asks first): red like Turn off. Modified: on its own row under Turn on / off, as wide (.mods-row-break). */
.mods-delete {
    margin-right: 0;
    border-color: rgba(230, 80, 60, 0.6);
}

.can-hover .mods-delete:hover,
.mods-delete:focus {
    background-color: rgba(200, 50, 40, 0.45);
    border-color: rgba(255, 110, 90, 1);
}

/* The controller's X / square on the Turn on / off button (MainMenu toggles the selected mod with it); only with a
   controller. A PadGlyph (InputGlyph.Pad): the main menu doesn't load GoF2InputGlyphs.uss, so both styles are here. */
.mods-pad-x {
    display: none;
    position: absolute;
    left: 8px;
    top: 50%;
    width: 26px;
    height: 26px;
    margin-top: -13px;
    border-radius: 13px;
    font-size: var(--text-caption);
    letter-spacing: 0;
    color: #0B1016;
    background-color: #3F8FE8;
    -unity-text-align: middle-center;
}

.mods-pad-x.pad-face--ps {
    background-color: rgb(16, 21, 28);
    border-width: 2px;
    border-color: rgba(216, 236, 247, 0.55);
}

.input-gamepad .mods-pad-x {
    display: flex;
}

.mods-footer {
    flex-direction: row;
    flex-wrap: wrap;   /* Modified: the buttons go on to a second row rather than out of the panel */
    align-items: center;
    flex-shrink: 0;
    margin-top: var(--space-l);
}

.mods-note {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 200px;   /* Modified: with the footer wrapping, it keeps a readable width */
    margin-right: var(--space-l);
    font-size: var(--text-small);
    color: var(--gof-text-dim);
    white-space: normal;
}

.mods-footer-button {
    flex-shrink: 0;
    font-size: var(--text-caption);
    padding: 8px 16px;
    white-space: nowrap;
}

/* ---- Mod Builder projects (remake, ModBuilderProjects) ---------------------------------- */

.mb-new-row {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    margin-bottom: var(--space-s);
}

.mb-new-name {
    flex-grow: 1;
    min-width: 230px;   /* Modified: room for the whole placeholder */
    margin: 0;
}

/* Modified: the search field's placeholder, a sliding label over the field's input (ModBuilderProjects, TextMarquee) */
.mb-placeholder-clip {
    position: absolute;
    left: 13px;
    right: 13px;
    top: 0;
    bottom: 0;
}

.mb-placeholder {
    font-size: var(--text-small);
    color: rgba(216, 236, 247, 0.45);
}

.mb-create {
    margin-left: 10px;   /* Modified: a gap between the field and the buttons, and between the buttons */
    margin-right: 0;
    flex-shrink: 0;
    padding: 8px 12px;
    letter-spacing: 2px;
}

.mb-field {
    margin: 0;
}

.mb-field .unity-base-text-field__input {
    padding: 8px 12px;
    font-size: var(--text-small);
    color: var(--gof-text);
    background-color: rgba(0, 0, 0, 0.35);
    border-width: 1px;
    border-color: rgba(216, 236, 247, 0.2);
    border-radius: 2px;
}

.mb-field:focus .unity-base-text-field__input {
    border-color: var(--gof-amber);
}

.mb-field--multi .unity-base-text-field__input {
    min-height: 84px;
    white-space: normal;
    -unity-text-align: upper-left;
}

.mb-thumb {
    -unity-background-scale-mode: scale-to-fit;
    background-color: rgba(62, 200, 255, 0.06);
}

.mb-empty {
    top: 60px;
}

.mb-detail-scroll {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
}

.mb-fields {
    margin-top: var(--space-m);
}

.mb-field-box {
    margin-bottom: var(--space-s);
    flex-grow: 1;
}

.mb-field-pair {
    flex-direction: row;
}

.mb-field-pair > .mb-field-box--first,   /* USS has no :first-child */
.mb-field-box--wide {
    margin-right: var(--space-l);
    flex-grow: 3;
}

.mb-field-label {
    font-size: var(--text-caption);
    letter-spacing: 3px;
    color: var(--gof-text-dim);
    margin-bottom: var(--space-xs);
}

/* Under the project's name, like GitHub's "will be created as": the mod id it gives. */
.mb-id-hint {
    margin-top: var(--space-xs);
    font-size: var(--text-small);
    color: var(--gof-text-dim);
    opacity: 0.8;
}

.mb-actions > .mods-action {
    white-space: nowrap;
    padding: 8px 16px;
    font-size: var(--text-caption);
    letter-spacing: 2px;
}

.mb-actions > .mods-delete {
    margin-left: auto;
}

.mb-field--multi .unity-base-text-field__input {
    min-height: 44px;
}

.mb-section {
    margin: 8px 0 8px 0;
    font-size: var(--text-caption);
    letter-spacing: 4px;
    color: var(--gof-cyan);
}

.mb-kinds {
    flex-direction: row;
    flex-wrap: wrap;
}

.mb-kind {
    width: 24%;
    margin: 0 1% 8px 0;
    padding: 8px 8px;
    align-items: stretch;
    background-color: var(--gof-cyan-faint);
    border-width: 1px;
    border-color: var(--gof-cyan-soft);
    border-left-width: 3px;
    border-left-color: var(--gof-cyan);
    border-radius: 2px;
    transition-duration: 0.18s;
}

.can-hover .mb-kind:hover,
.mb-kind:focus {
    border-left-color: var(--gof-amber);
    background-color: var(--gof-cyan-soft);
}

.mb-kind--soon,
.mb-kind:disabled {
    opacity: 0.42;
    background-color: rgba(255, 255, 255, 0.03);
    border-color: rgba(216, 236, 247, 0.12);
    border-left-color: rgba(216, 236, 247, 0.25);
}

.mb-kind-title {
    font-size: var(--text-caption);
    letter-spacing: 2px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    color: #FFFFFF;
    -unity-text-align: middle-left;
}

.mb-kind-state {
    margin-top: 2px;
    font-size: var(--text-caption);
    letter-spacing: 2px;
    color: var(--gof-amber);
    -unity-text-align: middle-left;
}

.mb-kind--soon .mb-kind-state {
    color: var(--gof-text-dim);
}

.mb-kind-desc {
    margin-top: var(--space-xs);
    font-size: var(--text-small);
    color: var(--gof-text-dim);
    white-space: normal;
    -unity-text-align: upper-left;
}

/* ---- multiplayer --------------------------------------------------------------------- */

.mp-title-row {
    flex-direction: row;
    align-items: center;
}

.mp-badge {
    margin-left: var(--space-l);
    padding: 3px 8px;
    font-size: var(--text-caption);
    letter-spacing: 3px;
    color: var(--gof-amber);
    border-width: 1px;
    border-color: var(--gof-amber-soft);
    border-radius: 2px;
    background-color: rgba(255, 166, 48, 0.08);
}

.mp-intro {
    margin-bottom: var(--space-xl);
    font-size: var(--text-small);
    color: var(--gof-text);
    white-space: normal;
}

.mp-label {
    margin-bottom: var(--space-s);
    font-size: var(--text-caption);
    letter-spacing: 3px;
    color: var(--gof-text-dim);
}

.mp-name {
    max-width: 420px;
    margin-bottom: var(--space-xl);
}

.mp-cards {
    flex-direction: row;
}

.mp-card {
    flex-grow: 1;
    flex-basis: 0;
    margin-right: var(--space-l);
    padding: 20px 24px;
    background-color: rgba(62, 200, 255, 0.05);
    border-width: 1px;
    border-color: var(--gof-line);
    border-radius: 2px;
}

.mp-card--last {
    margin-right: 0;
}

.mp-card-title {
    font-size: var(--text-label);
    letter-spacing: 4px;
    color: var(--gof-cyan);
}

.mp-card-text {
    margin: 8px 0 16px 0;
    font-size: var(--text-small);
    color: var(--gof-text-dim);
    white-space: normal;
}

/* the address row: same height in both cards, so the buttons line up */
.mp-card-fill {
    flex-grow: 1;
    justify-content: center;
    min-height: 58px;
    margin-bottom: var(--space-l);
}

.mp-address-list {
    margin-bottom: var(--space-s);
}

.mp-card-fill--empty {
    min-height: 0;
    margin-bottom: 0;
}

/* one address: the adapter's name, the address, "copied" after a tap */
.mp-address-row {
    flex-direction: row;
    align-items: center;
    -unity-text-align: middle-left;
    margin: 0 0 4px 0;
    padding: 3px 8px;
    background-color: rgba(0, 0, 0, 0.25);
    border-width: 1px;
    border-color: rgba(216, 236, 247, 0.12);
    border-radius: 2px;
    transition-duration: 0.15s;
}

.can-hover .mp-address-row:hover,
.mp-address-row:focus {
    border-color: var(--gof-amber);
    background-color: var(--gof-cyan-faint);
}

.mp-address-name {
    width: 96px;
    font-size: var(--text-caption);
    color: var(--gof-text-dim);
}

.mp-address-value {
    flex-grow: 1;
    font-size: var(--text-body);
    letter-spacing: 1px;
    color: var(--gof-text);
}

.mp-address-copy {
    font-size: var(--text-caption);
    color: var(--gof-text-dim);
}

.mp-address-row--copied .mp-address-copy {
    color: var(--gof-amber);
}

/* the host card's password and the session size on one row */
.mp-host-row {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    margin: 0 0 12px 0;
}

/* The password takes what is left and shrinks (min-width 0): its placeholder's width pushed the player limit out of the
   card with the old, wider Serpentine font. */
.mp-host-row .mp-host-password {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    min-width: 0;
    margin: 0 16px 0 0;
}

.mp-max-label {
    flex-shrink: 0;
    margin: 0 8px 0 0;
    white-space: nowrap;
}

.mp-max-players {
    flex-shrink: 0;
    width: 64px;
    margin: 0;
}

/* the host card's Debug menu switch (Off / Allowed), under the password row */
.mp-debug-row {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    margin: 0 0 8px 0;
}

.mp-debug-label {
    flex-shrink: 0;
    min-width: 130px;
    margin: 0 16px 0 0;
    white-space: nowrap;
}

.mp-debug-segments {
    flex-grow: 1;
}

.mp-debug-segments .choice-segment {
    flex-basis: 0;
    min-height: 28px;
}

/* the panel: a fixed height, the server browser takes what the rest leaves */
.mp-panel {
    max-width: 1280px;
    height: 84%;
    max-height: 84%;
}

.mp-title-spacer {
    flex-grow: 1;
}

.mp-name-label {
    margin: 0 12px 0 0;
}

.mp-panel .mp-name {
    width: 300px;
    margin: 0;
}

.mp-panel .mp-intro {
    flex-shrink: 0;
    margin-bottom: var(--space-l);
    font-size: var(--text-small);
    color: var(--gof-text-dim);
}

.mp-body {
    flex-direction: row;
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
}

.mp-browser {
    flex-grow: 1.4;   /* the host card a little wider: its switches sit two to a row */
}

.mp-host {
    flex-grow: 1;
}

/* The host card's settings between the mode tabs and Host. With four switch rows the card stopped fitting at 16:9 and the
   local network's addresses and port field were squeezed flat; the switches now sit two to a row (.mp-switch-grid) so it
   fits, and what still doesn't (three or more network adapters, short screens) scrolls (wheel, touch, focus) with the
   "More options" hint under it (.mp-host-more, MainMenu.UpdateHostMore) instead of being squeezed. */
.mp-host-scroll {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    margin-bottom: var(--space-s);
}

.mp-switch-grid {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: space-between;
}

.mp-switch-grid .mp-debug-row {
    width: 48.5%;
    flex-direction: column;
    align-items: stretch;
    margin: 0 0 8px 0;
}

.mp-switch-grid .mp-debug-label {
    min-width: 0;
    margin: 0 0 4px 0;
}

.mp-switch-grid .mp-debug-segments .choice-segment {
    flex-basis: auto;   /* FRESH / PERSISTENT: each by its text */
    padding: 0 4px;
    font-size: var(--text-caption);
}

.mp-switch-grid .mp-debug-segments .choice-segment--last {   /* ChoiceRow marks it (Unity 7 has no :last-child) */
    margin-right: 0;
}

.mp-host-more {
    display: none;
    flex-shrink: 0;
    margin: -4px 0 8px 0;
    font-size: var(--text-small);
    letter-spacing: 2px;
    -unity-text-align: middle-center;
    color: var(--gof-amber);
}

.mp-host-more--shown {
    display: flex;
}

.mp-host-scroll .mp-card-text {
    margin: 8px 0 8px 0;
}

.mp-panel .back-button {
    margin-top: var(--space-m);
}

.mp-host-scroll .mp-card-fill {
    flex-grow: 0;
    min-height: 0;
    margin-bottom: var(--space-m);
}

.mp-host-scroll .mp-card-fill--empty {
    margin-bottom: 0;
}

.mp-card-head {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    flex-shrink: 0;
}

.mp-server-count {
    font-size: var(--text-caption);
    color: var(--gof-text-dim);
}

.mp-browser .mp-server-list {
    flex-grow: 1;
    min-height: 100px;
    max-height: none;
}

.mp-join-label {
    flex-shrink: 0;
    margin: 16px 0 8px 0;
}

.mp-join-row {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
}

.mp-join-row .mp-address {
    flex-grow: 1.3;
    flex-basis: 0;
    margin: 0 8px 0 0;
}

.mp-join-row .mp-join-password {
    flex-grow: 1;
    flex-basis: 0;
    margin: 0 8px 0 0;
}

.mp-join-row .mp-join-button {
    padding: 8px 24px;
    font-size: var(--text-small);
}

/* Each card's one action, Join and Host: the primary button (docs/UI-DESIGN.md "Buttons"). */
.mp-join-button,
.mp-host-button {
    color: #FFFFFF;
    background-color: var(--button-primary-fill);
    border-color: var(--button-primary-line);
}

.can-hover .mp-join-button:hover,
.mp-join-button:focus,
.can-hover .mp-host-button:hover,
.mp-host-button:focus {
    background-color: var(--button-primary-focus-fill);
}

/* the host card's choice: Public / Invite only / Local network */
.mp-mode-row {
    flex-grow: 0;
    margin: 12px 0 0 0;
}

/* the join card: the server browser. Only the list gives way when the panel is short (everything else keeps its
   height, so nothing slides under the title). */
.mp-card-title,
.mp-card-text,
.mp-mode-row,
.mp-card .debug-filter,
.mp-action {
    flex-shrink: 0;
}

.mp-server-list {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 62px;
    max-height: 200px;
    margin: 8px 0 0 0;
    background-color: rgba(0, 0, 0, 0.18);
}

.mp-server-row {
    flex-direction: column;
    align-items: stretch;
    margin-bottom: 3px;
    padding: 8px 8px;
}

.mp-server-line {
    flex-direction: row;
    align-items: center;
}

.mp-server-name {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    font-size: var(--text-small);
    color: var(--gof-text);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.mp-server-info {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    margin-top: 2px;
    font-size: var(--text-small);
    color: var(--gof-text-dim);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.mp-server-tag {
    flex-shrink: 0;
    margin-left: var(--space-s);
    padding: 1px 8px;
    font-size: var(--text-caption);
    letter-spacing: 2px;
    white-space: nowrap;
    color: var(--gof-cyan);
    border-width: 1px;
    border-color: var(--gof-cyan-soft);
    border-radius: 2px;
}

.mp-server-tag--password {
    color: var(--gof-amber);
    border-color: var(--gof-amber-soft);
}

.mp-server-tag--mods {
    color: rgb(150, 230, 140);
    border-color: rgba(150, 230, 140, 0.45);
}

/* Players fight anywhere (NetGame.FreePvp) / only in arenas and faction sieges. */
.mp-server-tag--pvp {
    color: rgb(255, 110, 100);
    border-color: rgba(255, 110, 100, 0.5);
}

.mp-server-tag--pve {
    color: rgb(170, 190, 210);
    border-color: rgba(170, 190, 210, 0.4);
}

/* Where a listed game is and how far away: its Relay region and the round trip to it (NetPing), at the right of the
   name line. The dot reads the ping as good / fair / poor; one not measured yet shows the dim dot and "...". */
.mp-server-ping {
    flex-direction: row;
    flex-shrink: 0;
    align-items: center;
    margin-left: var(--space-m);
}

.mp-server-region {
    margin-right: var(--space-s);
    font-size: var(--text-caption);
    color: var(--gof-text-dim);
    white-space: nowrap;
}

.mp-server-ping-dot {
    width: 10px;
    height: 10px;
    border-radius: 5px;
    background-color: var(--gof-text-dim);
}

.mp-server-ping-dot--good {
    background-color: rgb(120, 220, 120);
}

.mp-server-ping-dot--fair {
    background-color: var(--gof-amber);
}

.mp-server-ping-dot--poor {
    background-color: rgb(255, 110, 100);
}

.mp-server-ping-ms {
    min-width: 60px;
    margin-left: var(--space-s);
    font-size: var(--text-caption);
    -unity-text-align: middle-right;
    color: var(--gof-text-dim);
    white-space: nowrap;
}

.mp-password {
    margin: 0 0 12px 0;
}

.mp-join-fill .mp-password {
    margin: 8px 0 0 0;
}

.mp-join-fill {
    flex-shrink: 0;
}

.mp-server-version {
    flex-shrink: 0;
    margin: 2px 0 0 12px;
    font-size: var(--text-caption);
    -unity-text-align: middle-right;
    color: var(--gof-text-dim);
    white-space: nowrap;
}

.mp-server-version--other {
    color: var(--gof-amber);
}

.mp-server-row--full .mp-server-name,
.mp-server-row--full .mp-server-info {
    color: var(--gof-text-dim);
}

.mp-server-row--full {
    opacity: 0.6;
}

.mp-server-empty {
    margin: var(--space-m);
    font-size: var(--text-small);
    color: var(--gof-text-dim);
    white-space: normal;
}

.mp-join-text {
    flex-shrink: 0;
    margin: 8px 0 8px 0;
}

.mp-join-fill {
    flex-grow: 0;
    min-height: 0;
    margin-bottom: var(--space-m);
}

.mp-port-row {
    flex-direction: row;
    align-items: center;
}

.mp-port-label {
    margin: 0 12px 0 0;
}

.mp-port {
    width: 120px;
    margin: 0;
}

.mp-address {
    margin: 0;
}

.mp-action {
    margin: 0;
    padding: 12px 16px;
    font-size: var(--text-body);
    letter-spacing: 4px;
    -unity-text-align: middle-center;
    color: var(--gof-text);
    background-color: var(--button-fill);
    border-width: var(--button-border-compact);
    border-color: var(--button-line);
    border-radius: var(--button-radius);
    transition-duration: 0.18s;
}

.can-hover .mp-action:hover,
.mp-action:focus {
    color: #FFFFFF;
    border-color: var(--button-focus-line);
    background-color: var(--button-focus-fill);
}

.menu-root .mp-action:active {
    background-color: var(--button-press-fill);
    color: var(--button-press-text);
}

/* empty until there is something to say: no room kept for it (the host card needs every pixel at 16:9) */
.mp-status {
    min-height: 0;
    margin: 8px 0 0 0;
    font-size: var(--text-small);
    color: var(--gof-amber);
    white-space: normal;
}

.debug-note {
    margin-top: var(--space-s);
    font-size: var(--text-small);
    color: var(--gof-text-dim);
    white-space: normal;
}

/* A small high-density screen (UiScale, the root's ui-large: a phone, the Retroid Pocket G2): the Debug panel fills the
   screen and its text and rows grow about 1.35x. */
.ui-large .debug-panel {
    max-width: none;
    height: 94%;
    max-height: 94%;
}

.ui-large .debug-heading,
.ui-large .debug-filter .unity-base-text-field__input,
.ui-large .debug-mission-index,
.ui-large .debug-mission-title {
    font-size: var(--text-heading);
}

.ui-large .debug-mission {
    padding: 16px 16px;
}

.ui-large .debug-mission-index {
    min-width: 70px;
}

.ui-large .debug-mission-section {
    font-size: var(--text-label);
}

.ui-large .debug-mission-station,
.ui-large .debug-mission-summary,
.ui-large .debug-note {
    font-size: var(--text-label);
}

.ui-large .debug-mission-summary {
    margin-left: 70px;
}

.ui-large .debug-column--cheats .option-row,
.ui-large .debug-column--cheats .unity-base-field__label {
    font-size: var(--text-heading);
}

.ui-large .debug-column--cheats .option-row {
    min-height: 64px;
}

/* ---- campaign cards ----------------------------------------------------------------- */

.card-row {
    flex-direction: row;
    justify-content: space-between;
    flex-shrink: 0;   /* the cards keep their height (the New Game+ toggle goes under them) */
}

.campaign-card {
    width: 290px;
    height: 448px;
    margin: 0;
    padding: 0;
    background-color: rgba(0, 0, 0, 0);
    border-width: 2px;
    border-color: rgba(0, 0, 0, 0);
    border-radius: 6px;
    scale: 1 1;
    transition-duration: 0.2s;
    transition-timing-function: ease-out-cubic;
}

.can-hover .campaign-card:hover,
.campaign-card:focus,
.campaign-card:active {
    scale: 1.05 1.05;
    border-color: var(--gof-amber);
}

.card-art {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    -unity-background-scale-mode: scale-to-fit;
    transition-duration: 0.2s;
}

.card-art-hover {
    opacity: 0;
}

.can-hover .campaign-card:hover > .card-art-hover,
.campaign-card:focus > .card-art-hover,
.campaign-card:active > .card-art-hover {
    opacity: 1;
}

.card-gof2 { background-image: url("project://database/Assets/UI/MainMenu/Images/card_gof2.png"); }
.card-gof2-hover { background-image: url("project://database/Assets/UI/MainMenu/Images/card_gof2_hover.png"); }
.card-valkyrie { background-image: url("project://database/Assets/UI/MainMenu/Images/card_valkyrie.png"); }
.card-valkyrie-hover { background-image: url("project://database/Assets/UI/MainMenu/Images/card_valkyrie_hover.png"); }
.card-supernova { background-image: url("project://database/Assets/UI/MainMenu/Images/card_supernova.png"); }
.card-supernova-hover { background-image: url("project://database/Assets/UI/MainMenu/Images/card_supernova_hover.png"); }

/* ---- difficulty --------------------------------------------------------------------- */

.choice-button {
    margin: 8px 0;
    padding: 16px 24px;
    background-color: rgba(255, 255, 255, 0.03);
    border-width: 1px;
    border-color: var(--gof-line);
    border-left-width: 3px;
    border-radius: 2px;
    align-items: stretch;
    transition-duration: 0.18s;
}

.can-hover .choice-button:hover,
.choice-button:focus,
.choice-button:active {
    background-color: var(--gof-cyan-faint);
    border-left-color: var(--gof-amber);
    padding-left: var(--space-xxl);   /* the content moves, not the box (a translated box slid away from the cursor) */
}

/* The new game's Kaamo Club expansion toggle (under the economy choices; a choice, not a start button). */
.choice-button--toggle {
    margin-top: var(--space-xl);
    flex-shrink: 0;
    border-left-color: var(--gof-line);
}

/* The game options panel holds four toggles (the Kaamo Club, Hardcore, Tutorials, Capital ships) and Start: tighter so it
   fits the panel's 80 % height. */
#gameOptionsPanel .choice-button--toggle {
    margin-top: var(--space-s);
    margin-bottom: 0;
    padding: 12px 20px;
}

#gameOptionsPanel .choice-desc {
    margin-top: 3px;
    font-size: var(--text-small);
}

.choice-button--toggle.choice-button--on {
    border-left-color: var(--gof-amber);
}

.choice-button--on .choice-title {
    color: var(--gof-amber);
}

.choice-title {
    font-size: var(--text-subhead);
    letter-spacing: 4px;
    color: #FFFFFF;
    -unity-text-align: middle-left;
}

.choice-desc {
    margin-top: var(--space-s);
    font-size: var(--text-small);
    color: var(--gof-text-dim);
    white-space: normal;
    -unity-text-align: upper-left;
}

.choice-button--danger .choice-title {
    color: var(--gof-amber);
}

/* Start game: the Game options panel's one action, amber like the station's Launch (the toggles above it are choices). */
.choice-button--start {
    margin-top: var(--space-xl);
    flex-shrink: 0;
    align-items: center;
    background-color: var(--button-primary-fill);
    border-width: var(--button-border);
    border-left-width: 2px;
    border-color: var(--button-primary-line);
    border-radius: var(--button-radius);
}

.choice-button--start .choice-title {
    font-size: var(--text-heading);
    letter-spacing: 6px;
    -unity-text-align: middle-center;
}

.choice-button--start .choice-desc {
    color: rgba(255, 255, 255, 0.75);
    -unity-text-align: middle-center;
}

.can-hover .choice-button--start:hover,
.choice-button--start:focus,
.choice-button--start:active {
    background-color: var(--button-primary-focus-fill);
    border-left-color: var(--gof-amber);
    padding-left: var(--space-xl);   /* centred: no slide like the choices */
    scale: 1.02 1.02;
}

/* ---- options ------------------------------------------------------------------------ */

.section-header {
    margin: 16px 0 4px 0;
    font-size: var(--text-caption);
    letter-spacing: 4px;
    color: var(--gof-amber);
}

/* The Language page is a scroll page like the other tabs (.options-scroll): a fixed box, its buttons ran past the bottom
   on a phone, over the voice language row, and the last one couldn't be reached. */
.language-list {
    flex-direction: row;
    flex-wrap: wrap;
    flex-shrink: 0;
}

/* The voice language row under the text language buttons. */
.language-voice-row {
    margin-top: 28px;
}

.language-button {
    width: 46%;
    margin: 4px 8px 4px 0;
    font-size: var(--text-body);
    letter-spacing: 1px;
}

.language-button--active {
    color: var(--gof-cyan);
    border-left-color: var(--gof-cyan);
}

/* ---- about -------------------------------------------------------------------------- */

.about-scroll {
    height: 520px;
    flex-shrink: 1;
    min-height: 120px;
}

.about-text {
    flex-shrink: 0;
    white-space: normal;
    font-size: var(--text-small);
    color: var(--gof-text);
    -unity-text-align: upper-left;
}

/* ---- footer ------------------------------------------------------------------------- */

.footer {
    position: absolute;
    left: 3%;
    right: 3%;
    bottom: 3%;
    flex-direction: row;
    justify-content: space-between;
    opacity: 0;
    transition-duration: 0.8s;
}

.menu-root--menu .footer {
    opacity: 1;
}

/* Remake: "Update available" (UpdateCheck), bottom centre above the footer line (the credit line is wide enough to
   reach the centre on 4:3), shown in the menu while no panel is open. */
.update-row {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 72px;
    flex-direction: row;
    justify-content: center;
    display: none;
}

.update-row--shown {
    display: flex;
}

.update-button {
    background-color: var(--button-primary-fill);
    border-width: var(--button-border);
    border-color: var(--button-primary-line);
    border-radius: var(--button-radius);
    margin: 0;
    padding: 8px 28px;
    -unity-text-align: middle-center;
    font-size: var(--text-small);
    letter-spacing: 4px;
    color: var(--gof-amber);
    transition-duration: 0.18s;
    transition-timing-function: ease-out-cubic;
}

.update-button:focus,
.can-hover .update-button:hover {
    color: #FFFFFF;
    background-color: var(--button-primary-focus-fill);
}

.menu-root .update-button:active {
    background-color: var(--button-press-fill);
    color: var(--button-press-text);
}

.layout-phone .update-row {
    bottom: 60px;
}

.layout-phone .update-button {
    padding: 16px 32px;
}

.footer-text {
    font-size: var(--text-caption);
    letter-spacing: 2px;
    color: var(--gof-text-dim);
}

/* The debug panel's tap target: padding widens the hit zone, the negative margin keeps the text where it was. */
.footer-version {
    padding: 40px 60px 40px 40px;
    margin: -40px -60px -40px -40px;
}

/* ---- dialog ------------------------------------------------------------------------- */

.dialog-backdrop {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.6);
    justify-content: center;
    align-items: center;
    display: none;
}

.dialog-backdrop--shown {
    display: flex;
}

.dialog {
    width: 90%;
    max-width: 760px;
    padding: 36px 44px;
    background-color: var(--gof-panel);
    border-width: 1px;
    border-color: var(--gof-line);
    border-top-width: 3px;
    border-top-color: var(--gof-amber);
}

.dialog-text {
    white-space: normal;
    font-size: var(--text-body);
    color: var(--gof-text);
    margin-bottom: var(--space-xl);
    -unity-text-align: upper-left;
}

/* The pilot name prompt's field (MainMenu.NeedsName), hidden in the other dialogs. */
.dialog-field {
    display: none;
    margin: -8px 0 24px 0;
}

.dialog-buttons {
    flex-direction: row;
    justify-content: flex-end;
}

.dialog-button {
    margin-left: var(--space-m);
    font-size: var(--text-body);
}

/* ---- splash + fade ------------------------------------------------------------------ */

.splash {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: #000000;
    justify-content: center;
    align-items: center;
    transition-duration: 1s;
}

.splash--gone {
    opacity: 0;
}

.splash--removed {
    display: none;
}

.splash-logo {
    width: 34%;
    height: 44%;
    -unity-background-scale-mode: scale-to-fit;
    opacity: 0;
    scale: 0.96 0.96;
    transition-duration: 1s;
    transition-timing-function: ease-out-sine;
}

.splash-logo--visible {
    opacity: 1;
    scale: 1 1;
}

.fade {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: #000000;
    opacity: 0;
    transition-duration: 1.2s;
}

.fade--on {
    opacity: 1;
}

/* ---- responsive layouts ------------------------------------------------------------- */

.layout-narrow .main-column {
    width: 36%;
}

.layout-narrow .panel-host {
    padding-right: 3%;
}

.layout-narrow .campaign-card {
    width: 230px;
    height: 356px;
}

.layout-phone .footer-hint {
    display: none;
}

/* Rows 64 units high, the touch minimum (docs/UI-DESIGN.md "Touch targets"; 72 with 16 units of padding). */
.layout-phone .menu-button {
    padding: 12px 24px;
}

/* The menu's rows centred between the logo's bottom (.logo: top 6 %, height 16 %) and the version line at the bottom
   left (its tap zone, .footer-version, from about 89 %), however many rows show (8, or 9 with Resume and Debug) and at
   any interface size: the column's own padding is a share of the width, which on a 20:9 phone put the first row a
   fifth of the height down (the nine rows ran past the version line) and left the gap under the logo uneven. The
   column stays in the flow (the panel host sits beside it); an absolute child ignores its padding, so 'left' takes it
   over: 10 % of the column's 30 % is the logo's 3 %. The rows touch, each still 64 units high, so nine fit. */
.layout-phone .main-buttons,
.layout-phone .main-column--full .main-buttons {
    position: absolute;
    top: 22%;
    bottom: 11%;
    left: 10%;
    right: 0;
    margin-top: 0;
    justify-content: center;
}

.layout-phone .main-buttons .menu-button {
    margin: 0;
}

.layout-phone .panel-host {
    padding-top: 3%;
}

.layout-phone .panel {
    padding: 24px 32px;
    max-height: 90%;
}

.layout-phone .panel-accent {
    margin: 8px 0 16px 0;
}

.layout-phone .back-button {
    margin-top: var(--space-l);
}

.layout-phone .mp-intro {
    margin-bottom: var(--space-l);
}

.layout-phone .mp-name {
    margin-bottom: var(--space-l);
}

.layout-phone .mp-card {
    padding: 16px 16px;
}

.layout-phone .mp-panel .mp-intro {
    display: none;
}

.layout-phone .mp-panel .mp-name {
    width: 220px;
}

.layout-phone .campaign-card {
    width: 238px;
    height: 368px;
}

/* Remake mods: the loading screen (ModLoadingView) on the startup splash and the fade before a game. */
.mod-loading {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 16%;
    align-items: center;
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.3s;
}

.mod-loading--shown {
    opacity: 1;
}

.mod-loading__title {
    color: var(--gof-text);
    font-size: var(--text-title);
    letter-spacing: 6px;
    margin-bottom: var(--space-l);
    -unity-text-align: middle-center;
}

.mod-loading__track {
    width: 560px;
    max-width: 70%;
    height: 8px;
    background-color: var(--gof-cyan-faint);
    border-width: 1px;
    border-color: var(--gof-line);
}

.mod-loading__fill {
    height: 100%;
    width: 0;
    background-color: var(--gof-amber);
    transition-property: width;
    transition-duration: 0.15s;
}

.mod-loading__line {
    color: var(--gof-text-dim);
    font-size: var(--text-label);
    margin-top: var(--space-l);
    -unity-text-align: middle-center;
}

/* Remake mods: the mods' campaigns under the campaign cards (MainMenu.RefreshModCampaigns). */
/* Remake mods: the mods' campaigns (MainMenu.RefreshModCampaigns) are cards after the three campaign cards, picked the
   same way; the mods' new-game options (RefreshModOptions) cards of the same look in the Game options panel. A mod card's
   art is cropped to the card; without its own title in the art, the name sits on a plate at its foot. */
.card-scroll {
    flex-shrink: 0;
    overflow: visible;
}

.card-scroll > .unity-scroll-view__content-viewport,
.card-scroll .unity-scroll-view__content-container {
    overflow: visible;
}

.card-row--4 .campaign-card {
    width: 220px;
    height: 340px;
}

.card-row--many {
    justify-content: flex-start;
}

.card-row--many .campaign-card {
    width: 176px;
    height: 272px;
    margin-right: var(--space-l);
    flex-shrink: 0;   /* the cards keep their size; the row scrolls */
}

.mod-card {
    overflow: hidden;
    background-color: rgba(8, 14, 22, 0.9);
    border-color: var(--gof-line);
}

.mod-card__art {
    -unity-background-scale-mode: scale-and-crop;
}

.mod-card__plate {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 8px 12px 12px 12px;
    background-color: rgba(4, 8, 14, 0.82);
    border-top-width: 1px;
    border-top-color: var(--gof-line);
}

.mod-card__title {
    font-size: var(--text-body);
    letter-spacing: 1px;
    color: var(--gof-text);
    white-space: normal;
    -unity-text-align: middle-center;
}

.mod-card__sub {
    margin-top: 2px;
    font-size: var(--text-small);
    color: var(--gof-text-dim);
    white-space: normal;
    -unity-text-align: middle-center;
}

.game-options-body {
    flex-direction: row;
    flex-shrink: 0;
}

.game-options-left {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
}

.mod-option-column {
    flex-shrink: 0;
    width: 476px;
    margin-left: var(--space-m);
}

.mod-option-cards {
    flex-shrink: 0;
    width: 476px;
}

.mod-option-hint {
    margin-top: 0;
    font-size: var(--text-small);
    letter-spacing: 1px;
    color: var(--gof-text-dim);
    -unity-text-align: middle-center;
}

.mod-option-cards .unity-scroll-view__content-container {
    flex-direction: row;
    padding: 12px 8px 12px 8px;   /* room for a selected card's 5 % growth */
}

.mod-option-card {
    width: 214px;
    height: 331px;
    margin-right: var(--space-l);
    flex-shrink: 0;   /* the cards keep their size; the row scrolls */
}

/* With the cards the panel is wide and may take a little more height (Back stays inside it). */
#gameOptionsPanel.panel--wide {
    max-height: 88%;
}

.mod-option-card > .mod-card__art {
    opacity: 0.5;
}

.mod-option-card--on {
    border-color: var(--gof-amber);
}

.mod-option-card--on > .mod-card__art {
    opacity: 1;
}

.mod-option-card__badge {
    position: absolute;
    top: 10px;
    right: 10px;
    padding: 3px 8px;
    font-size: var(--text-caption);
    letter-spacing: 2px;
    color: var(--gof-text-dim);
    background-color: rgba(4, 8, 14, 0.85);
    border-width: 1px;
    border-color: var(--gof-line);
    border-radius: 2px;
}

.mod-option-card--on .mod-option-card__badge {
    color: rgb(20, 12, 0);
    background-color: var(--gof-amber);
    border-color: var(--gof-amber);
}
