# Unity dedicated-server module settings (generated by the Editor)
/ProjectSettings/Packages/com.unity.dedicated-server/

# The UWP test signing certificate (UnityEditor.EditorUtility.WSACreateTestCertificate): local only, never published
/Assets/WSATestCertificate.pfx
/Assets/WSATestCertificate.pfx.meta

# The build fingerprint BuildVersionStamp writes for a build (deleted afterwards)
/Assets/Resources/GoF2Build/
/Assets/Resources/GoF2Build.meta

# The AI modding guide ModdingGuideBundle copies into a build (deleted afterwards)
/Assets/Resources/GoF2ModdingGuide/
/Assets/Resources/GoF2ModdingGuide.meta

# Mods the Editor loads (Modding/README.md; copy an example here to try it)
/[Mm]ods/
